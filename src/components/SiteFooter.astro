---
interface Props {
  revealDelay?: string;
}

const { revealDelay = '520ms' } = Astro.props;
---

<footer class="site-footer" data-reveal style={`--d: ${revealDelay}`}>
  <!-- 工程图纸深色反色后：将 #000 提亮为 #111（filter 链第二段，见 site-shared.css） -->
  <svg class="svg-filters" aria-hidden="true" width="0" height="0" style="position:absolute">
    <defs>
      <filter id="engineering-drawing-lift" color-interpolation-filters="sRGB" x="0" y="0" width="100%" height="100%">
        <feComponentTransfer>
          <feFuncR type="linear" slope="1" intercept="0.0666666667" />
          <feFuncG type="linear" slope="1" intercept="0.0666666667" />
          <feFuncB type="linear" slope="1" intercept="0.0666666667" />
        </feComponentTransfer>
      </filter>
    </defs>
  </svg>
  <div class="shell">
    <div class="footer-top-line"></div>
    <div class="footer-grid">
      <section>
        <h2 class="footer-heading">服务支持</h2>
        <ul class="footer-list">
          <li><a href="https://www.bilibili.com/video/BV1AT6qByEZj/" target="_blank" rel="noreferrer">视频教学</a></li>
          <li>固件与文档下载</li>
          <li>常见问题与使用建议</li>
        </ul>
      </section>

      <section>
        <h2 class="footer-heading">购买渠道</h2>
        <ul class="footer-list">
          <li><a href="https://shop321119951.taobao.com/" target="_blank" rel="noreferrer">淘宝</a></li>
          <li>其他（规划中）</li>
        </ul>
      </section>

      <section>
        <h2 class="footer-heading">联系我们</h2>
        <div class="footer-contact">
          <div class="footer-contact-row">
            <span class="footer-contact-label">邮&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;箱：</span>
            <span>contact@qdrive.example</span>
          </div>
          <div class="footer-contact-row">
            <span class="footer-contact-label">Q&nbsp;Q&nbsp;&nbsp;&nbsp;群：</span>
            <span>
              QDrive&无刷云台&电赛小车交流群
              <br />
              368939578
            </span>
          </div>
          <div class="footer-contact-row">
            <span class="footer-contact-label">服务时间：</span>
            <span>工作日 10:00–18:00</span>
          </div>
        </div>
      </section>
    </div>

    <div class="footer-bottom">
      <div>© {new Date().getFullYear()} QDrive Tech. 保留所有权利</div>
      <div>
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer">
          浙ICP备2026018811号
        </a>
        <span class="footer-bottom-sep">·</span>
        <a href="https://beian.mps.gov.cn/" target="_blank" rel="noreferrer">
          浙公网安备（备案号待补充）
        </a>
      </div>
    </div>
  </div>
</footer>
