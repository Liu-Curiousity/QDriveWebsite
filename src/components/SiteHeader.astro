<header class="site-header" data-reveal style="--d: 0ms">
  <a class="brand" href="/">
    <div class="brand-mark" />
    <div class="brand-text">
      <div class="brand-name">QDRIVE TECH</div>
      <div class="brand-tagline">PRECISION DRIVE · MOTION CONTROL</div>
    </div>
  </a>
  <nav aria-label="主导航">
    <div class="nav-item">
      <a href="/" class="nav-link">首页</a>
    </div>

    <div class="nav-item">
      <button class="nav-link" type="button" aria-haspopup="true" aria-expanded="false">
        产品中心
      </button>
      <div class="nav-item-popover">
        <div class="product-menu-title">产品中心</div>
        <div class="product-menu-grid">
          <a
            class="product-menu-item"
            href="/products/qd4310"
            aria-label="QD4310 伺服电机平台"
          >
            <span class="product-menu-dot" />
            <div class="product-menu-body">
              <div class="product-menu-label">QD4310 伺服电机平台</div>
              <div class="product-menu-desc">驱控一体中空无刷伺服电机</div>
            </div>
            <span class="product-menu-arrow">→</span>
          </a>
        </div>
      </div>
    </div>

    <div class="nav-item">
      <button class="nav-link" type="button" aria-haspopup="true" aria-expanded="false">
        解决方案
      </button>
      <div class="nav-item-popover">
        <div class="product-menu-title">解决方案</div>
        <div class="product-menu-grid">
          <a
            class="product-menu-item"
            href="/solutions/qgimbal"
            aria-label="QGimbal 二维云台解决方案"
          >
            <span class="product-menu-dot" />
            <div class="product-menu-body">
              <div class="product-menu-label">QGimbal 二维云台</div>
              <div class="product-menu-desc">双轴增稳与智能视觉跟踪</div>
            </div>
            <span class="product-menu-arrow">→</span>
          </a>
          <a
            class="product-menu-item"
            href="/solutions/qcar"
            aria-label="QCar 二轮平衡车解决方案"
          >
            <span class="product-menu-dot" />
            <div class="product-menu-body">
              <div class="product-menu-label">QCar 二轮平衡车</div>
              <div class="product-menu-desc">轮毂伺服驱动的平衡车平台</div>
            </div>
            <span class="product-menu-arrow">→</span>
          </a>
        </div>
      </div>
    </div>

    <div class="nav-item">
      <a href="/blog" class="nav-link">技术博客</a>
    </div>

    <div class="nav-item">
      <a href="/about" class="nav-link">关于 QDrive Tech</a>
    </div>
  </nav>
</header>

<script is:inline>
  document.querySelectorAll('.nav-item').forEach((item) => {
    const btn = item.querySelector('button.nav-link');
    if (!btn) return;
    const sync = () => {
      const open = item.matches(':hover') || item.matches(':focus-within');
      btn.setAttribute('aria-expanded', String(open));
    };
    item.addEventListener('mouseenter', sync);
    item.addEventListener('mouseleave', sync);
    item.addEventListener('focusin', sync);
    item.addEventListener('focusout', sync);
  });
</script>
