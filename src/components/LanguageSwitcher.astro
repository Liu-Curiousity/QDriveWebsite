<div class="language-switcher" data-language-switcher>
  <label class="language-switcher__label" for="site-language">Language</label>
  <select id="site-language" class="language-switcher__select" aria-label="选择语言">
    <option value="zh-CN">简体中文</option>
    <option value="zh-TW">繁體中文</option>
    <option value="en">English</option>
  </select>
</div>

<style is:global>
  .language-switcher {
    display: inline-flex;
    align-items: center;
    margin-left: .35rem;
    border-left: 1px solid var(--border-subtle);
    padding-left: .65rem;
  }

  .language-switcher__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .language-switcher__select {
    min-height: 2.3rem;
    padding: .4rem 1.35rem .4rem .35rem;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: var(--type-scale-label);
    font-weight: 450;
    letter-spacing: .035em;
    cursor: pointer;
  }

  .language-switcher__select:hover,
  .language-switcher__select:focus-visible {
    color: var(--text-main);
    outline: 1px solid var(--border-strong);
    outline-offset: 2px;
  }

  .language-switcher__select option {
    background: var(--bg-elevated);
    color: var(--text-main);
  }

  @media (max-width: 780px) {
    .language-switcher {
      width: 100%;
      margin: .35rem 0 0;
      border-top: 1px solid var(--border-subtle);
      border-left: 0;
      padding: .6rem 0 0;
    }

    .language-switcher__select {
      width: 100%;
      padding-inline: 0;
      font-size: var(--type-scale-body);
    }
  }
</style>

