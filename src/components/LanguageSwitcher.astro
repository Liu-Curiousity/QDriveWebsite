    const storageKey = 'qdrive-language';
    const toTraditional = ConverterFactory(
      [STCharacters],
      [TWPhrases],
      [TWVariantsPhrases, TWVariants],
    );
    const normalize = (value: string) => value.replace(/\s+/g, ' ').trim();
    const translateValue = (value: string, dictionary: Record<string, string>, locale: string) => {
      const source = normalize(value || '');
      if (!source) return value;
      let next = value;
      if (dictionary[source]) {
        next = value.replace(source, dictionary[source]);
      } else {
        const keys = Object.keys(dictionary).filter((key) => key && source.includes(key)).sort((a, b) => b.length - a.length);
        keys.forEach((key) => { next = next.split(key).join(dictionary[key]); });
      }
      return locale === 'zh-TW' ? toTraditional(next) : next;
    };

    let isTranslating = false;
    const translateTextNodes = (locale: string) => {
      if (isTranslating) return;
      isTranslating = true;
      const dictionary = translations[locale] || {};
      const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
      const nodes = [];
      let node;
      while ((node = walker.nextNode())) nodes.push(node);
      nodes.forEach((textNode) => {
        const parent = textNode.parentElement;
        if (!parent || ['SCRIPT', 'STYLE'].includes(parent.tagName)) return;
        const original = textNode.nodeValue || '';
        const translated = translateValue(original, dictionary, locale);
        if (translated !== original) textNode.nodeValue = translated;
      });

      const attributes = ['aria-label', 'aria-description', 'placeholder', 'title', 'alt', 'data-tooltip'];
      document.querySelectorAll('*').forEach((element) => {
        attributes.forEach((name) => {
          if (!element.hasAttribute(name)) return;
          const original = element.getAttribute(name) || '';
          const translated = translateValue(original, dictionary, locale);
          if (translated !== original) element.setAttribute(name, translated);
        });
      });

      const title = document.title;
      const translatedTitle = translateValue(title, dictionary, locale);
      if (translatedTitle !== title) document.title = translatedTitle;
      document.querySelectorAll('meta[name="description"]').forEach((meta) => {
        const original = meta.getAttribute('content') || '';
        const translated = translateValue(original, dictionary, locale);
        if (translated !== original) meta.setAttribute('content', translated);
      });
      document.querySelectorAll('meta[property="og:title"], meta[property="og:description"]').forEach((meta) => {
        const original = meta.getAttribute('content') || '';
        const translated = translateValue(original, dictionary, locale);
        if (translated !== original) meta.setAttribute('content', translated);
      });

      const languageLabel = dictionary['选择语言'] || 'Language';
      select.setAttribute('aria-label', languageLabel);
      document.documentElement.lang = locale;
      isTranslating = false;
    };

    const applyLocale = (locale: string) => {
      const nextLocale = ['zh-CN', 'zh-TW', 'en'].includes(locale) ? locale : 'zh-CN';
      select.value = nextLocale;
      localStorage.setItem(storageKey, nextLocale);
      window.location.reload();
    };

    const queryLocale = new URLSearchParams(window.location.search).get('lang');
    const saved = queryLocale || localStorage.getItem(storageKey) || 'zh-CN';
    if (queryLocale && ['zh-CN', 'zh-TW', 'en'].includes(queryLocale)) localStorage.setItem(storageKey, queryLocale);
    if (saved !== 'zh-CN') {
      translateTextNodes(saved);
      let translationScheduled = false;
      const observer = new MutationObserver(() => {
        if (translationScheduled) return;
        translationScheduled = true;
        window.setTimeout(() => {
          translationScheduled = false;
          translateTextNodes(saved);
        }, 80);
      });
      observer.observe(document.body, { childList: true, subtree: true, characterData: true });
    }
    select.value = ['zh-CN', 'zh-TW', 'en'].includes(saved) ? saved : 'zh-CN';
    select.addEventListener('change', () => applyLocale(select.value));
    };

    if (document.readyState === 'complete') init();
    else window.addEventListener('load', init, { once: true });
  })();
</script>
