---
import '../../styles/site-shared.css';
import '../../styles/auth-control.css';
import '../../styles/contribution-admin.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteFavicon from '../../components/SiteFavicon.astro';
import RevealScript from '../../components/RevealScript.astro';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>兑换审核 · QDrive Tech</title>
    <meta name="description" content="审核 QDrive Tech 用户积分兑换申请。" />
    <SiteFavicon />
  </head>
  <body>
    <div class="page">
      <main class="shell">
        <SiteHeader />
        <section class="contribution-admin" data-redemption-admin-root>
          <header class="contribution-admin__header">
            <div>
              <div class="account-gh__eyebrow">ADMIN / REDEMPTIONS</div>
              <h1>兑换审核</h1>
              <p>核对淘宝账号与兑换数量，并设置处理后的用户积分余量。</p>
            </div>
            <div class="contribution-admin__header-actions">
              <a href="/admin">管理员中心</a>
              <a href="/admin/users">积分查询</a>
              <a href="/admin/contributions">贡献审核</a>
              <a href="/account#account-points-title">返回个人账户</a>
            </div>
          </header>
          <form class="contribution-admin__filters" data-redemption-admin-filters>
            <label><span>用户名</span><input type="search" placeholder="搜索用户名" data-filter-user /></label>
            <label><span>关键词</span><input type="search" placeholder="搜索淘宝账号或备注" data-filter-keyword /></label>
            <label><span>开始日期</span><input type="date" data-filter-start /></label>
            <label><span>结束日期</span><input type="date" data-filter-end /></label>
            <label><span>状态</span><span class="contribution-admin__select-wrap" data-custom-select><select data-filter-status tabindex="-1" aria-hidden="true"><option value="">全部状态</option><option value="pending">待处理</option><option value="approved">已完成</option><option value="rejected">已驳回</option></select><button type="button" class="contribution-admin__select-trigger" data-filter-status-trigger aria-haspopup="listbox" aria-expanded="false">全部状态</button><span class="contribution-admin__select-menu" data-filter-status-menu role="listbox"><button type="button" role="option" data-filter-status-option="">全部状态</button><button type="button" role="option" data-filter-status-option="pending">待处理</button><button type="button" role="option" data-filter-status-option="approved">已完成</button><button type="button" role="option" data-filter-status-option="rejected">已驳回</button></span></span></label>
            <button type="reset">清除筛选</button>
          </form>
          <p class="account-dialog__status contribution-admin__status" data-redemption-admin-status aria-live="polite">正在读取兑换申请…</p>
          <div class="contribution-admin__list" data-redemption-admin-list></div>
          <nav class="contribution-admin__pagination" data-redemption-admin-pagination aria-label="兑换审核分页"></nav>
        </section>
      </main>
      <SiteFooter />
    </div>
    <RevealScript />
  </body>
</html>

<script>
  import '../../scripts/admin-redemptions';
</script>
