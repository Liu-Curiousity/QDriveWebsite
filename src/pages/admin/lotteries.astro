---
import '../../styles/site-shared.css';
import '../../styles/auth-control.css';
import '../../styles/contribution-admin.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteFavicon from '../../components/SiteFavicon.astro';
import RevealScript from '../../components/RevealScript.astro';
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>抽奖管理 · QDrive Tech</title><SiteFavicon /></head><body><div class="page"><main class="shell"><SiteHeader /><section class="contribution-admin" data-lottery-admin-root><header class="contribution-admin__header"><div><div class="account-gh__eyebrow">ADMIN / LOTTERY</div><h1>抽奖管理</h1><p>查看抽奖凭证、补充说明和收货地址，审核后通知用户。</p></div><div class="contribution-admin__header-actions"><a href="/admin">管理员中心</a><a href="/account#account-points-title">返回个人账户</a></div></header><section class="lottery-admin__settings"><div class="account-gh__eyebrow">LOTTERY SETTINGS</div><h2>抽奖设置</h2><form data-lottery-settings-form><label><input type="checkbox" data-lottery-enabled /> 开启抽奖</label><label><span>抽取方式</span><select data-lottery-mode><option value="probability">按获奖概率</option><option value="count">按获奖总人次</option></select></label><div class="lottery-admin__setting-grid"><label><span>一等奖概率 / 人次</span><input type="number" min="0" data-lottery-first /></label><label><span>二等奖概率 / 人次</span><input type="number" min="0" data-lottery-second /></label><label><span>三等奖概率 / 人次</span><input type="number" min="0" data-lottery-third /></label></div><button type="submit">保存设置</button><button type="button" data-lottery-draw>立即开奖</button></form></section><form class="contribution-admin__filters" data-lottery-admin-filters><label><span>用户名</span><input type="search" placeholder="搜索用户名" data-filter-user /></label><label><span>关键词</span><input type="search" placeholder="搜索凭证或地址" data-filter-keyword /></label><label><span>状态</span><select data-filter-status><option value="">全部状态</option><option value="pending">待审核</option><option value="approved">已通过</option><option value="rejected">已驳回</option></select></label><button type="reset">清除筛选</button></form><p class="account-dialog__status contribution-admin__status" data-lottery-admin-status aria-live="polite">正在读取抽奖申请…</p><div class="contribution-admin__list" data-lottery-admin-list></div><nav class="contribution-admin__pagination" data-lottery-admin-pagination aria-label="抽奖管理分页"></nav></section></main><SiteFooter /></div><RevealScript /></body></html><script>import '../../scripts/admin-lotteries';</script>
