          gap: 1rem;
        }

        :global(html[lang='en']) .tool-copy h2 {
          max-width: 13ch;
          font-size: clamp(2rem, 9vw, 2.6rem);
        }

        :global(html[lang='en']) .journal-link {
          grid-template-columns: 6.5rem minmax(0, 1fr) auto;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .motor-visual .rotor, .motor-visual .measure-ring { animation: none; }
      }

      /* QD4310 hero: a quieter product plate with one clear focal point. */
      .product-stage {
        border: 0;
        background: var(--bg-elevated);
      }

      .product-stage::before {
        background:
          radial-gradient(circle at 73% 46%, color-mix(in srgb, var(--text-main) 6%, transparent), transparent 33%),
          linear-gradient(112deg, transparent 0 61.5%, var(--home-line-soft) 61.5% calc(61.5% + 1px), transparent calc(61.5% + 1px)),
          linear-gradient(112deg, transparent 0 78.5%, var(--home-line-soft) 78.5% calc(78.5% + 1px), transparent calc(78.5% + 1px)),
          var(--bg-elevated);
      }

      .product-stage::after {
        opacity: .09;
      }

      .stage-principles-art {
        display: none;
      }

      .stage-top {
        top: 1.8rem;
        padding-bottom: 0;
        border-bottom: 0;
        font-size: .68rem;
        opacity: .72;
      }

      .stage-notes {
        width: min(34%, 27rem);
        gap: 0;
        padding-top: 0;
        border-top: 0;
      }

      .stage-note {
        padding: 0 clamp(.75rem, 1.25vw, 1.2rem);
      }

      .stage-note:first-child {
        padding-left: 0;
      }

      .stage-note + .stage-note {
        border-left: 1px solid var(--home-line);
      }

      .stage-note strong {
        font-size: .95rem;
      }

      .stage-note span {
        display: block;
        margin-top: .1rem;
        font-size: .65rem;
      }

      .stage-nav {
        inset: auto 0 1.2rem;
        grid-template-columns: repeat(3, max-content);
        justify-content: start;
        gap: clamp(1.2rem, 3vw, 3rem);
        padding-inline: clamp(1.25rem, 4.5vw, 4.75rem);
        border-top: 0;
        background: transparent;
        backdrop-filter: none;
      }

      .stage-nav a,
      .stage-nav a + a {
        position: relative;
        min-height: auto;
        padding: .35rem 0;
        border-left: 0;
        background: transparent;
      }

      .stage-nav a + a::before {
        content: '';
        position: absolute;
        top: 50%;
        left: calc(0px - clamp(.6rem, 1.5vw, 1.5rem));
        width: 1px;
        height: 1.35rem;
        background: var(--home-line);
        transform: translateY(-50%) rotate(24deg);
        transform-origin: center;
      }

      .stage-nav a:hover {
        background: transparent;
        color: var(--text-main);
      }

      .stage-nav strong {
        font-size: .8rem;
        font-weight: 450;
      }

      @media (max-width: 900px) {
        .stage-notes { display: none; }
        .stage-nav { gap: 1.4rem; }
        .section-heading p {
          padding-left: 0;
          border-left: 0;
