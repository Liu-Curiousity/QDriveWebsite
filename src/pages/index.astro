---
const siteTitle = 'QDrive 伺服电机与运动控制';
const siteSubtitle = '基于 QD4310 的伺服电机平台与二维云台等衍生产品。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteSubtitle} />
    <style>
      :root {
        color-scheme: light dark;
        --bg-main: #f9fafb;
        --bg-elevated: #ffffff;
        --border-subtle: rgba(0, 0, 0, 0.1);
        --accent: #000000;
        --accent-soft: rgba(0, 0, 0, 0.04);
        --text-main: #111827;
        --text-muted: #6b7280;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg-main: #050508;
          --bg-elevated: #111111;
          --border-subtle: rgba(255, 255, 255, 0.12);
          --accent: #ffffff;
          --accent-soft: rgba(255, 255, 255, 0.06);
          --text-main: #f9fafb;
          --text-muted: #9ca3af;
        }
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: var(--bg-main);
        color: var(--text-main);
        position: relative;
      }

      body::before {
        content: '';
        position: fixed;
        inset: -30%;
        background:
          radial-gradient(circle at 0% 0%, rgba(148, 163, 184, 0.10), transparent 55%),
          radial-gradient(circle at 100% 20%, rgba(15, 23, 42, 0.18), transparent 60%),
          radial-gradient(circle at 50% 100%, rgba(15, 23, 42, 0.22), transparent 65%);
        pointer-events: none;
        z-index: -1;
      }

      .page {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      .shell {
        max-width: 1120px;
        margin: 0 auto;
        padding: 1.25rem 1.25rem 3rem;
      }

      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 0 1.25rem;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .brand-mark {
        width: 32px;
        height: 32px;
        border-radius: 999px;
        background: radial-gradient(circle at 30% 0, #ffffff, #d1d5db 55%, #6b7280 100%);
        box-shadow:
          0 0 0 1px rgba(17, 24, 39, 0.45),
          0 0 18px rgba(0, 0, 0, 0.5);
      }

      .brand-text {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }

      .brand-name {
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .brand-tagline {
        font-size: 0.7rem;
        color: var(--text-muted);
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      nav {
        display: flex;
        gap: 1rem;
        font-size: 0.8rem;
      }

      .nav-item {
        position: relative;
        display: flex;
        align-items: center;
      }

      /* 在导航项下方增加一小块“缓冲区”，让鼠标从按钮移动到弹窗时不断悬停在 nav-item 上 */
      .nav-item::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        top: 100%;
        height: 1rem;
      }

      .nav-link {
        color: var(--text-muted);
        text-decoration: none;
        padding: 0.4rem 0.9rem;
        min-height: 2rem;
        border-radius: 999px;
        border: 1px solid transparent;
        transition: all 150ms ease-out;
        cursor: pointer;
        background: transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .nav-link:hover {
        color: var(--accent);
        border-color: var(--border-subtle);
        background: rgba(0, 0, 0, 0.04);
      }

      .nav-item-popover {
        position: absolute;
        left: 50%;
        top: calc(100% + 14px);
        transform: translateX(-50%);
        min-width: 260px;
        padding: 0.7rem 0.8rem;
        border-radius: 0.9rem;
        background: var(--bg-elevated);
        color: var(--text-main);
        border: 1px solid var(--border-subtle);
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.16);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 140ms ease-out, transform 140ms ease-out,
          visibility 140ms ease-out;
        z-index: 30;
      }

      .nav-item:hover .nav-item-popover,
      .nav-item:focus-within .nav-item-popover {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateX(-50%) translateY(0);
      }

      .product-menu-title {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--text-muted);
        margin-bottom: 0.35rem;
      }

      .product-menu-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0.45rem;
      }

      .product-menu-item {
        padding: 0.45rem 0.5rem;
        border-radius: 0.6rem;
        border: 1px solid var(--border-subtle);
        background: rgba(0, 0, 0, 0.02);
        font-size: 0.78rem;
        text-decoration: none;
        color: inherit;
        display: block;
      }

      .product-menu-item:visited {
        color: inherit;
        text-decoration: none;
      }

      .product-menu-label {
        display: block;
        font-weight: 500;
        margin-bottom: 0.08rem;
      }

      .product-menu-tag {
        font-size: 0.7rem;
        color: var(--text-muted);
      }

      .hero {
        margin-top: 1.5rem;
        border-radius: 1.75rem;
        border: 1px solid var(--border-subtle);
        padding: 1.75rem 1.5rem;
        background:
          radial-gradient(circle at 0% 0%, rgba(0, 0, 0, 0.06), transparent 60%),
          linear-gradient(135deg, var(--bg-elevated), var(--bg-main));
      }

      .hero-carousel {
        position: relative;
        overflow: hidden;
        opacity: 0; /* 避免初始化时尺寸跳变被用户看到 */
      }

      .hero-track {
        display: flex;
        transition: transform 220ms ease-out;
      }

      .hero-slide {
        min-width: 100%;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 3fr) minmax(0, 2.4fr);
        gap: 2rem;
        align-items: center;
        padding-inline: 1.25rem;
      }

      .hero-controls {
        position: absolute;
        inset-inline: 0.25rem;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        justify-content: space-between;
        pointer-events: none;
      }

      .hero-arrow {
        pointer-events: auto;
        border-radius: 999px;
        width: 2.8rem;
        height: 2.8rem;
        border: 1px solid var(--border-subtle);
        background: rgba(0, 0, 0, 0.4);
        color: #e5e7eb;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1.5rem;
      }

      .hero-arrow:disabled {
        opacity: 0.25;
        cursor: default;
      }

      .hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.18rem 0.6rem;
        border-radius: 999px;
        border: 1px solid var(--border-subtle);
        background: rgba(0, 0, 0, 0.02);
        color: var(--text-muted);
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }

      .hero-kicker-dot {
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-soft);
      }

      .hero-indicators {
        margin-top: 1rem;
        display: flex;
        justify-content: center;
        gap: 0.4rem;
      }

      .hero-dot {
        width: 7px;
        height: 7px;
        border-radius: 999px;
        background: rgba(148, 163, 184, 0.5);
        transition: width 160ms ease-out, background-color 160ms ease-out,
          opacity 160ms ease-out;
        opacity: 0.7;
      }

      .hero-dot--active {
        width: 18px;
        background: var(--accent);
        opacity: 1;
      }

      h1 {
        margin: 0.9rem 0 0.5rem;
        font-size: 2.1rem;
        line-height: 1.18;
        letter-spacing: 0.02em;
      }

      .hero-subtitle {
        margin: 0 0 1.2rem;
        color: var(--text-muted);
        font-size: 0.92rem;
        max-width: 30rem;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
        margin-top: 1rem;
      }

      .btn-primary {
        border-radius: 999px;
        padding: 0.55rem 1.3rem;
        border: 1px solid rgba(0, 0, 0, 0.7);
        background: linear-gradient(120deg, #111827, #000000);
        color: #ffffff;
        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-decoration: none;
        box-shadow:
          0 5px 14px rgba(15, 23, 42, 0.6),
          0 0 0 1px rgba(15, 23, 42, 0.7);
        transition: transform 140ms ease-out, box-shadow 140ms ease-out,
          background 180ms ease-out;
      }

      .btn-primary:hover {
        transform: translateY(-1px);
        box-shadow:
          0 8px 20px rgba(0, 0, 0, 0.5),
          0 0 0 1px rgba(0, 0, 0, 0.9);
        background: linear-gradient(120deg, #000000, #111827);
      }

      .btn-ghost {
        border-radius: 999px;
        padding: 0.5rem 1.1rem;
        border: 1px solid var(--border-subtle);
        background: rgba(0, 0, 0, 0.02);
        color: var(--text-muted);
        font-size: 0.88rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        transition: border-color 150ms ease-out, background 150ms ease-out,
          color 150ms ease-out, transform 150ms ease-out;
      }

      .btn-ghost:hover {
        border-color: var(--accent);
        background: rgba(0, 0, 0, 0.06);
        color: var(--accent);
        transform: translateY(-1px);
      }

      .hero-meta {
        margin-top: 1.2rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1.4rem;
        font-size: 0.78rem;
        color: var(--text-muted);
      }

      .hero-meta strong {
        display: block;
        font-size: 0.86rem;
        color: var(--accent);
        margin-bottom: 0.12rem;
      }

      .sections {
        margin-top: 2.5rem;
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 1.6fr);
        gap: 1.75rem;
      }

      .panel {
        border-radius: 1.4rem;
        border: 1px solid var(--border-subtle);
        background: var(--bg-elevated);
        padding: 1.3rem 1.2rem;
      }

      .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        margin-bottom: 0.9rem;
      }

      .panel-title {
        font-size: 0.95rem;
        font-weight: 600;
      }

      .panel-eyebrow {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--text-muted);
      }

      .panel-link {
        font-size: 0.75rem;
        color: var(--text-muted);
        text-decoration: none;
      }

      .panel-link:hover {
        color: var(--accent);
      }

      .features {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.8rem;
        margin-top: 0.3rem;
      }

      .feature {
        border-radius: 0.9rem;
        padding: 0.7rem 0.75rem;
        background: rgba(0, 0, 0, 0.02);
        border: 1px solid var(--border-subtle);
      }

      .feature-label {
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-bottom: 0.15rem;
      }

      .feature-value {
        font-size: 0.9rem;
        color: var(--accent);
      }

      .feature-sub {
        margin-top: 0.1rem;
        font-size: 0.7rem;
        color: var(--text-muted);
      }

      .list {
        list-style: none;
        padding: 0;
        margin: 0.35rem 0 0;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        font-size: 0.8rem;
        color: var(--text-muted);
      }

      .list li {
        display: flex;
        align-items: center;
        gap: 0.45rem;
      }

      .list-dot {
        width: 6px;
        height: 6px;
        border-radius: 999px;
        background: rgba(148, 163, 184, 0.8);
      }

      footer {
        margin-top: auto;
        padding: 1.5rem 1.25rem 2rem;
        color: var(--text-muted);
        font-size: 0.75rem;
      }

      footer .shell {
        border-top: 1px solid rgba(15, 23, 42, 0.1);
        padding-top: 1.3rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
      }

      @media (max-width: 900px) {
        .shell {
          padding-inline: 1rem;
        }

        .hero {
          padding: 1.4rem 1.25rem;
          border-radius: 1.5rem;
        }

        .hero-grid {
          grid-template-columns: minmax(0, 1fr);
          gap: 1.6rem;
        }

        .sections {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      @media (max-width: 640px) {
        header {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.65rem;
        }

        nav {
          width: 100%;
          justify-content: space-between;
        }

        .hero-actions {
          flex-direction: column;
          align-items: stretch;
        }

        .btn-primary,
        .btn-ghost {
          justify-content: center;
          width: 100%;
          text-align: center;
        }

        .features {
          grid-template-columns: minmax(0, 1fr);
        }

        footer .shell {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <div class="page" id="top">
      <main class="shell">
        <header>
          <div class="brand">
            <div class="brand-mark" />
            <div class="brand-text">
              <div class="brand-name">QDRIVE SERVO</div>
              <div class="brand-tagline">PRECISION DRIVE · MOTION CONTROL</div>
            </div>
          </div>
          <nav>
            <div class="nav-item">
              <a href="#top" class="nav-link">首页</a>
            </div>

            <div class="nav-item">
              <button class="nav-link" type="button">
                产品中心
              </button>
              <div class="nav-item-popover">
                <div class="product-menu-title">QDrive 产品中心</div>
                <div class="product-menu-grid">
                  <a class="product-menu-item" href="/products/qd4310">
                    <div class="product-menu-label">QD4310 伺服电机平台</div>
                    <div class="product-menu-tag">电机</div>
                  </a>
                </div>
              </div>
            </div>

            <div class="nav-item">
              <button class="nav-link" type="button">
                解决方案
              </button>
              <div class="nav-item-popover">
                <div class="product-menu-title">应用解决方案</div>
                <div class="product-menu-grid">
                  <a class="product-menu-item" href="#solutions">
                    <div class="product-menu-label">通用伺服应用</div>
                    <div class="product-menu-tag">机床 / 机器人等</div>
                  </a>
                  <a class="product-menu-item" href="/solutions/qgimbal">
                    <div class="product-menu-label">QGimbal 二维云台</div>
                    <div class="product-menu-tag">基于 QD4310</div>
                  </a>
                  <a class="product-menu-item" href="/solutions/qcar">
                    <div class="product-menu-label">QCar 二轮平衡车</div>
                    <div class="product-menu-tag">QD4310 轮毂方案</div>
                  </a>
                </div>
              </div>
            </div>

            <div class="nav-item">
              <a href="/blog" class="nav-link">技术博客</a>
            </div>

            <div class="nav-item">
              <a href="/about" class="nav-link">关于 QDrive</a>
            </div>
          </nav>
        </header>

        <section class="hero" id="hero-carousel" data-active-index="0">
          <div class="hero-carousel">
            <div class="hero-track">
              <article class="hero-slide" data-index="0" data-link="/products/qd4310">
                <div class="hero-grid">
                  <div>
                    <div class="hero-kicker">
                      <span class="hero-kicker-dot" />
                      伺服电机 · 运动控制平台
                    </div>
                    <h1>
                      QD4310<br />
                      高性能伺服运动控制平台
                    </h1>
                    <p class="hero-subtitle">
                      驱控一体中空无刷伺服电机，集成电机、驱动与角度传感器，兼顾高精度、高响应和优越的低速性能，适用于小型云台和车辆
                    </p>
                    <div class="hero-meta">
                      <div>
                        <strong>平台化电机 · 多种控制模式</strong>
                        电驱一体化设计，15 位高精度编码器，电流、速度、角度控制
                      </div>
                      <div>
                        <strong>接口丰富 · 易于集成</strong>
                        XT30 接口供电，USB / CAN / UART / PWM 等多种通讯方式，自研主控与上位机调参
                      </div>
                    </div>
                    <div class="hero-actions">
                      <a href="/products/qd4310" class="btn-primary"> 查看详情 </a>
                    </div>
                  </div>
                  <div>
                    <!-- QD4310 主产品图，占位路径：/images/home/qd4310-main.png -->
                    <img
                      src="/images/home/qd4310-main.png"
                      alt="QD4310 伺服电机渲染图"
                      style="width: 100%; display: block; object-fit: contain;"
                    />
                  </div>
                </div>
              </article>

              <article class="hero-slide" data-index="1" data-link="/solutions/qgimbal">
                <div class="hero-grid">
                  <div>
                    <div class="hero-kicker">
                      <span class="hero-kicker-dot" />
                      二维云台 · QGimbal
                    </div>
                    <h1>QGimbal 二维云台</h1>
                    <p class="hero-subtitle">
                      基于 QD4310 平台的二维无刷云台，集成陀螺仪、摄像头、激光发射装置，用于监控、测量、视觉采集等应用场景，实现姿态稳定与精准指向。
                    </p>
                    <div class="hero-meta">
                      <div>
                        <strong>运动增稳 · 拍摄消抖</strong>
                        陀螺仪闭环控制，双轴增稳
                      </div>
                      <div>
                        <strong>继承 QD4310 性能</strong>
                        继承平台电机的响应与精度指标，便于系统统一设计。
                      </div>
                    </div>
                    <div class="hero-actions">
                      <a href="/solutions/qgimbal" class="btn-primary"> 查看详情 </a>
                    </div>
                  </div>
                  <div>
                    <!-- QGimbal 云台图，占位路径：/images/home/qgimbal-main.png -->
                    <img
                      src="/images/home/qgimbal-main.png"
                      alt="QGimbal 二维云台渲染图"
                      style="width: 100%; display: block; object-fit: contain;"
                    />
                  </div>
                </div>
              </article>

              <article class="hero-slide" data-index="2" data-link="/solutions/qcar">
                <div class="hero-grid">
                  <div>
                    <div class="hero-kicker">
                      <span class="hero-kicker-dot" />
                      二轮平衡车 · QCar
                    </div>
                    <h1>QCar 二轮平衡车方案</h1>
                    <p class="hero-subtitle">
                      以 QD4310 为轮毂伺服内核的二轮平衡车平台，适用于教学实验、算法验证与轻载搬运等场景。
                    </p>
                    <div class="hero-meta">
                      <div>
                        <strong>轮毂伺服一体化</strong>
                        将 QD4310 集成于车轮，实现紧凑布局与高响应控制。
                      </div>
                      <div>
                        <strong>用于控制算法验证</strong>
                        适合作为姿态控制、路径规划等算法的实验平台。
                      </div>
                    </div>
                    <div class="hero-actions">
                      <a href="/solutions/qcar" class="btn-primary"> 查看详情 </a>
                    </div>
                  </div>
                  <div>
                    <!-- QCar 平衡车图，占位路径：/images/home/qcar-main.png -->
                    <img
                      src="/images/home/qcar-main.png"
                      alt="QCar 二轮平衡车渲染图"
                      style="width: 100%; display: block; object-fit: contain;"
                    />
                  </div>
                </div>
              </article>
            </div>

            <div class="hero-controls">
              <button class="hero-arrow" type="button" data-dir="prev" aria-label="上一张">
                ‹
              </button>
              <button class="hero-arrow" type="button" data-dir="next" aria-label="下一张">
                ›
              </button>
            </div>
          </div>
          <div class="hero-indicators" aria-hidden="true">
            <div class="hero-dot hero-dot--active" data-dot-index="0" />
            <div class="hero-dot" data-dot-index="1" />
            <div class="hero-dot" data-dot-index="2" />
          </div>
        </section>

        <section id="products" class="sections">
          <article class="panel">
            <header class="panel-header">
              <div>
                <div class="panel-eyebrow">技术博客</div>
                <div class="panel-title">阅读 QDrive 的技术文章</div>
              </div>
              <a href="/blog" class="panel-link">进入博客 →</a>
            </header>
            <p class="hero-subtitle">
