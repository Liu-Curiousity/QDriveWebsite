---
import '../styles/site-shared.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteFavicon from '../components/SiteFavicon.astro';
import RevealScript from '../components/RevealScript.astro';
import AnniversaryLottery from '../components/AnniversaryLottery.astro';
import principlesBackground from '../assets/qdrive-principles-background.svg?url';

const siteTitle = 'QDrive Tech｜精密运动控制系统';
const siteSubtitle = '从驱控一体伺服电机到云台与移动平台，为工程团队提供可验证、可集成的运动控制能力。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f1f0ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#10100f" media="(prefers-color-scheme: dark)" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteSubtitle} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteSubtitle} />
    <meta property="og:type" content="website" />
    <SiteFavicon />
    <style>
      .home {
        --home-line: color-mix(in srgb, var(--text-main) 18%, transparent);
        --home-line-soft: color-mix(in srgb, var(--text-main) 10%, transparent);
        --home-faint: color-mix(in srgb, var(--text-main) 6%, transparent);
        --home-product-shadow: rgba(46, 44, 38, .18);
        --home-product-shadow-hover: rgba(46, 44, 38, .22);
        --type-display: clamp(2.75rem, 4.4vw, 4rem);
        --type-h1: clamp(2.15rem, 3.3vw, 3rem);
        --type-h2: clamp(1.65rem, 2.4vw, 2.1rem);
        overflow: hidden;
      }

      :global(#top .home-page-header > header.site-header) {
        border-bottom: 0 !important;
      }

      .home-hero {
        padding-top: clamp(.5rem, 1vw, 1rem);
        padding-bottom: 0;
      }

      .hero-head {
        padding-bottom: clamp(1.75rem, 3vw, 2.75rem);
      }

      .editorial-label {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        margin: 0 0 1.5rem;
        color: var(--text-muted);
        font-family: var(--font-body);
        font-size: 0.75rem;
        font-weight: 400;
        line-height: 1.5;
        letter-spacing: var(--tracking-label);
        text-transform: uppercase;
        white-space: nowrap;
      }

      .editorial-label::before {
        content: '';
        width: 2.5rem;
        height: 1px;
        background: currentColor;
      }

      .hero-intro {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 1.5rem;
        align-items: end;
        padding-top: clamp(.5rem, 1vw, 1rem);
      }

      .hero-intro h1 {
        max-width: 31rem;
        margin: 0;
        color: var(--text-muted);
        font-family: var(--font-body);
        font-size: clamp(.96875rem, calc(.94rem + .12vw), 1.0625rem) !important;
        font-weight: 400;
        line-height: var(--leading-body);
        letter-spacing: var(--tracking-body);
        text-wrap: pretty;
      }

      .text-link {
        display: inline-flex;
        align-items: center;
        gap: 0.9rem;
        padding: 0.35rem 0;
        border-bottom: 1px solid var(--text-main);
        color: var(--text-main);
        font-size: 0.875rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        text-decoration: none;
        white-space: nowrap;
        transition: gap 240ms cubic-bezier(.2,.8,.2,1), opacity 200ms ease;
      }

      .text-link:hover { gap: 1.25rem; opacity: 0.62; }
      .text-link:active { transform: translateY(1px); }

      .product-stage {
        position: relative;
        min-height: clamp(36rem, 66vw, 54rem);
        overflow: hidden;
        border: 1px solid var(--home-line);
        background: var(--bg-elevated);
        color: var(--text-main);
        isolation: isolate;
      }

      .product-stage::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -2;
        background:
          radial-gradient(circle at 72% 46%, color-mix(in srgb, var(--text-main) 7%, transparent), transparent 29%),
          linear-gradient(112deg, transparent 0 58%, color-mix(in srgb, var(--text-main) 3%, transparent) 58% 58.12%, transparent 58.12%),
          var(--bg-elevated);
      }

      .product-stage::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: 3;
        pointer-events: none;
        opacity: .22;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.95' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.16'/%3E%3C/svg%3E");
        mix-blend-mode: soft-light;
      }

      .stage-principles-art {
        position: absolute;
        inset: 4rem 0 6rem;
        z-index: 0;
        width: 100%;
        height: calc(100% - 10rem);
        object-fit: cover;
        object-position: 60% center;
        opacity: .1;
        mix-blend-mode: multiply;
        pointer-events: none;
        user-select: none;
      }

      .stage-top {
        position: absolute;
        z-index: 4;
        top: 2rem;
        left: clamp(1.25rem, 3vw, 3rem);
        right: clamp(1.25rem, 3vw, 3rem);
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--home-line);
        color: var(--text-muted);
        font-family: var(--font-body);
        font-size: 0.75rem;
        line-height: 1.55;
        letter-spacing: var(--tracking-label);
        text-transform: uppercase;
      }

      .stage-copy {
        position: absolute;
        z-index: 4;
        left: clamp(1.25rem, 4.5vw, 4.75rem);
        top: 19%;
        max-width: 25rem;
      }

      .stage-copy h2 {
        margin: 0 0 1rem;
        font-size: var(--type-h1);
        font-weight: 400;
        line-height: 1.1;
        letter-spacing: var(--tracking-display);
      }

      .stage-copy h2 small {
        display: block;
        margin-bottom: .8rem;
        color: var(--text-muted);
        font-family: var(--font-body);
        font-size: .75rem;
        font-weight: 400;
        line-height: 1.55;
        letter-spacing: .055em;
      }

      .stage-copy p {
        max-width: 22rem;
        margin: 0;
        color: var(--text-muted);
        font-size: 1rem;
        line-height: var(--leading-body);
        letter-spacing: var(--tracking-body);
      }

      .motor-visual {
        position: absolute;
        z-index: 1;
        top: 49%;
        left: 68%;
        width: min(62vw, 50rem);
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        filter: drop-shadow(0 3rem 3rem rgba(0,0,0,.38));
        display: none;
      }

      .motor-product-image {
        position: absolute;
        z-index: 2;
        top: 6.5rem;
        right: clamp(2.5rem, 4vw, 4.5rem);
        bottom: 6.5rem;
        left: auto;
        width: min(58%, 48rem);
        height: calc(100% - 13rem);
        object-fit: contain;
        object-position: center;
        filter: drop-shadow(0 2.1rem 2.2rem var(--home-product-shadow));
        transition: transform 900ms cubic-bezier(.2,.8,.2,1);
      }

      .product-stage:hover .motor-product-image {
        transform: translateY(-.45rem) scale(1.015);
      }

      .motor-visual .rotor {
        transform-origin: center;
        animation: rotor-drift 18s linear infinite;
      }

      .motor-visual .measure-ring {
        transform-origin: center;
        animation: measure-turn 55s linear infinite reverse;
      }

      @keyframes rotor-drift { to { transform: rotate(360deg); } }
      @keyframes measure-turn { to { transform: rotate(360deg); } }

      .stage-notes {
        position: absolute;
        z-index: 4;
        left: clamp(1.25rem, 4.5vw, 4.75rem);
        right: auto;
        bottom: 8.2rem;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        width: min(32%, 25rem);
        gap: 0;
        padding-top: .85rem;
        border-top: 1px solid var(--home-line);
      }

      .stage-note {
        min-width: 0;
        padding-right: .8rem;
      }

      .stage-note + .stage-note {
        padding-left: .8rem;
        border-left: 1px solid var(--home-line);
      }

      .stage-note strong {
        display: block;
        font-family: var(--font-mono);
        font-size: 1rem;
        font-weight: 450;
        line-height: 1.4;
      }

      .stage-note span {
        color: var(--text-muted);
        font-size: .6875rem;
        line-height: 1.6;
        letter-spacing: .02em;
      }

      .stage-nav {
        position: absolute;
        z-index: 4;
        inset: auto 0 0;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        border-top: 1px solid var(--home-line);
        background: color-mix(in srgb, var(--bg-main) 82%, transparent);
        backdrop-filter: blur(14px);
      }

      .stage-nav a {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1rem;
        align-items: center;
        min-height: 6rem;
        padding: 1rem clamp(1rem, 2.5vw, 2.5rem);
        color: var(--text-muted);
        text-decoration: none;
        transition: color 180ms ease, background 180ms ease;
      }

      .stage-nav a + a { border-left: 1px solid var(--home-line); }
      .stage-nav a:hover { color: var(--text-main); background: var(--accent-soft); }
      .stage-nav a:first-child { color: var(--text-main); }
      .stage-nav i { font-family: var(--font-mono); font-size: .62rem; font-style: normal; }
      .stage-nav strong { font-size: .875rem; font-weight: 500; letter-spacing: .015em; }

      .manifesto {
        display: grid;
        grid-template-columns: minmax(12rem, .55fr) minmax(0, 1.45fr);
        gap: clamp(2rem, 8vw, 8rem);
        padding-top: clamp(6rem, 12vw, 12rem);
        padding-bottom: clamp(6rem, 12vw, 12rem);
      }

      .manifesto h2 {
        max-width: 17ch;
        margin: 0;
        font-family: var(--font-serif);
        font-size: var(--type-h1);
        font-weight: 380;
        line-height: 1.14;
        letter-spacing: var(--tracking-display);
        text-wrap: balance;
      }

      .principles { border-top: 1px solid var(--home-line); }
      .principle {
        display: grid;
        grid-template-columns: 5.25rem minmax(9rem, .7fr) minmax(0, 1fr);
        gap: 1rem;
        padding: 1.8rem 0 2.2rem;
        border-bottom: 1px solid var(--home-line);
      }
      .principle > span {
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 1rem;
        line-height: var(--leading-body);
        letter-spacing: var(--tracking-body);
        white-space: nowrap;
      }
      .principle h3 { margin: 0; font-size: var(--type-h3); font-weight: 400; line-height: 1.4; letter-spacing: .01em; }
      .principle p {
        max-width: 34rem;
        margin: 0;
        color: var(--text-muted);
        font-size: 1rem;
        line-height: var(--leading-body);
        letter-spacing: var(--tracking-body);
      }

      .solutions {
        padding-top: clamp(4rem, 8vw, 8rem);
        padding-bottom: clamp(6rem, 10vw, 10rem);
        border-top: 1px solid var(--home-line);
      }

      .section-heading {
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: end;
        gap: 2rem;
        margin-bottom: clamp(2.5rem, 5vw, 5rem);
      }

      .section-heading h2 {
        max-width: 12ch;
        margin: 0;
        font-size: var(--type-h1);
        font-weight: 400;
        line-height: 1.12;
        letter-spacing: var(--tracking-display);
      }

      .section-heading p {
        max-width: 34rem;
        margin: 0 0 .35rem auto;
        padding-left: clamp(1.5rem, 3vw, 3rem);
        border-left: 1px solid var(--home-line);
        color: var(--text-muted);
        font-size: 1rem;
        line-height: var(--leading-body);
        letter-spacing: var(--tracking-body);
      }

      .solution-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.4fr) minmax(18rem, .6fr);
        gap: 1px;
        background: var(--home-line);
        border: 1px solid var(--home-line);
      }

      .solution-card {
        position: relative;
        min-height: 35rem;
        overflow: hidden;
        padding: clamp(1.5rem, 3vw, 3rem);
        background: var(--bg-elevated);
        color: var(--text-main);
        text-decoration: none;
        isolation: isolate;
      }

      .solution-card--dark { background: var(--bg-subtle); color: var(--text-main); }
      .solution-card__number {
        position: absolute;
        top: 1.5rem;
        right: 1.5rem;
        font-family: var(--font-mono);
        font-size: .65rem;
        letter-spacing: .055em;
        opacity: .48;
      }
      .solution-card__copy { position: relative; z-index: 2; max-width: 24rem; }
      .solution-card__copy span {
        display: block;
        margin-bottom: 1rem;
        font-family: var(--font-mono);
        font-size: .65rem;
        letter-spacing: .055em;
        opacity: .55;
        text-transform: uppercase;
      }
      .solution-card h3 {
        margin: 0 0 .8rem;
        font-size: var(--type-h2);
        font-weight: 400;
        line-height: 1.2;
        letter-spacing: var(--tracking-display);
      }
      .solution-card p { max-width: 24rem; margin: 0; opacity: .64; font-size: .9375rem; line-height: var(--leading-body); letter-spacing: var(--tracking-body); }
      .solution-card__arrow {
        position: absolute;
        z-index: 3;
        right: 1.7rem;
        bottom: 1.5rem;
        font-size: 1.3rem;
        transition: transform 240ms cubic-bezier(.2,.8,.2,1);
      }
      .solution-card:hover .solution-card__arrow { transform: translate(5px, -5px); }

      .gimbal-diagram, .car-diagram {
        position: absolute;
        left: 50%;
        bottom: 1rem;
        width: min(72%, 34rem);
        transform: translateX(-50%);
        display: none;
        transition: transform 700ms cubic-bezier(.2,.8,.2,1);
      }
      .solution-card:hover .gimbal-diagram,
      .solution-card:hover .car-diagram { transform: translateX(-50%) scale(1.025); }

      .solution-product-image {
        position: absolute;
        z-index: 1;
        top: 10.5rem;
        right: clamp(1.25rem, 3vw, 3rem);
        bottom: 1.75rem;
        left: clamp(1.25rem, 3vw, 3rem);
        width: calc(100% - clamp(2.5rem, 6vw, 6rem));
        height: calc(100% - 12.25rem);
        object-fit: contain;
        object-position: center bottom;
        filter: saturate(.78) contrast(1.03) drop-shadow(0 1.8rem 1.8rem var(--home-product-shadow));
        transition: transform 700ms cubic-bezier(.2,.8,.2,1), filter 400ms ease;
      }

      .solution-product-image--car {
        width: calc(100% - 2.5rem);
        right: 1.25rem;
        left: 1.25rem;
      }

      .solution-product-image--gimbal {
        top: 7.75rem;
        right: clamp(1.5rem, 3vw, 3rem);
        bottom: .75rem;
        left: auto;
        width: 53%;
        height: calc(100% - 8.5rem);
        object-position: center bottom;
      }

      .solution-card:hover .solution-product-image {
        transform: translateY(-.35rem) scale(1.018);
        filter: saturate(.94) contrast(1.03) drop-shadow(0 2rem 2rem var(--home-product-shadow-hover));
      }

      @media (prefers-color-scheme: dark) {
        .home {
          --home-product-shadow: rgba(0, 0, 0, .48);
          --home-product-shadow-hover: rgba(0, 0, 0, .56);
        }

        .stage-principles-art {
          filter: invert(1);
          opacity: .18;
          mix-blend-mode: screen;
        }

        .tool-feature {
          --bg-main: #f1f0ea;
          --bg-elevated: #f8f7f2;
          --bg-subtle: #e8e6de;
          --text-main: #191918;
          --text-muted: #6f6e68;
          --home-line: rgba(25, 25, 24, .18);
          color-scheme: light;
        }
      }

      .tool-feature {
        display: grid;
        grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr);
        min-height: 34rem;
        margin-bottom: clamp(6rem, 10vw, 10rem);
        border: 1px solid var(--home-line);
        background: var(--bg-subtle);
        color: var(--text-main);
      }

      .tool-copy {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: clamp(2rem, 5vw, 5rem);
      }
      .tool-copy h2 {
        max-width: 9ch;
        margin: 1rem 0 1.5rem;
        font-size: var(--type-h1);
        font-weight: 400;
        line-height: 1.12;
        letter-spacing: var(--tracking-display);
      }
      .tool-copy p { max-width: 34rem; margin: 0; color: var(--text-muted); font-size: 1rem; line-height: var(--leading-body); letter-spacing: var(--tracking-body); }
      .tool-copy .text-link { align-self: flex-start; color: var(--text-main); border-color: var(--text-main); }

      .tool-screen {
        display: grid;
        place-items: center;
        align-self: center;
        overflow: hidden;
        padding: clamp(1.5rem, 4vw, 4rem);
        border-left: 1px solid var(--home-line);
        background: #242422;
      }
      .scope {
        width: min(100%, 43rem);
        aspect-ratio: 16 / 10;
        padding: 1.1rem;
        border: 1px solid rgba(255,255,255,.16);
        background: #141413;
        color: #f4f2ea;
        box-shadow: 0 2.5rem 5rem rgba(0,0,0,.25);
        margin: auto;
        transform-origin: center center;
        transform: rotate(-2deg);
        transition: transform 600ms cubic-bezier(.2,.8,.2,1);
      }
      .tool-feature:hover .scope { transform: rotate(0); }
      .scope-top {
        display: flex;
        justify-content: space-between;
        padding-bottom: .8rem;
        color: rgba(255,255,255,.48);
        font-family: var(--font-mono);
        font-size: .55rem;
        letter-spacing: .1em;
      }
      .scope svg { width: 100%; height: calc(100% - 1.5rem); }

      .journal {
        padding-top: clamp(5rem, 9vw, 9rem);
        padding-bottom: clamp(5rem, 9vw, 9rem);
        border-top: 1px solid var(--home-line);
      }
      .journal-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 2rem;
        margin-bottom: 2rem;
      }
      .journal-head h2 { margin: 0; font-size: var(--type-h2); font-weight: 400; line-height: 1.28; letter-spacing: var(--tracking-display); }
      .journal-list { border-top: 1px solid var(--home-line); }
      .journal-link {
        display: grid;
        grid-template-columns: 7rem 1fr auto;
        gap: 1rem;
        align-items: center;
        padding: 2rem 0;
        border-bottom: 1px solid var(--home-line);
        color: inherit;
        text-decoration: none;
      }
      .journal-link span {
        color: var(--text-main);
        font-family: var(--font-display);
        font-size: var(--type-h3);
        font-weight: 400;
        line-height: 1.4;
        letter-spacing: .01em;
      }
      .journal-link strong {
        color: var(--text-muted);
        font-family: var(--font-display);
        font-size: var(--type-h3);
        font-weight: 400;
        line-height: 1.4;
        letter-spacing: .01em;
      }
      .journal-link i { font-size: 1.2rem; font-style: normal; transition: transform 180ms ease; }
      .journal-link:hover i { transform: translateX(6px); }

      .home .anniversary-lottery {
        margin: 0 0 clamp(6rem, 10vw, 10rem);
        border: 1px solid var(--home-line);
        border-radius: 0;
        box-shadow: none;
      }

      :global(html[lang='en']) .hero-intro h1 {
        max-width: 38rem;
        font-size: clamp(.95rem, calc(.9rem + .18vw), 1.05rem) !important;
        line-height: 1.65;
      }

      :global(html[lang='en']) .stage-copy p {
        max-width: 30rem;
        font-size: .9375rem;
        line-height: 1.62;
      }

      :global(html[lang='en']) .principle {
        grid-template-columns: 10.5rem minmax(12rem, .7fr) minmax(0, 1fr);
      }

      :global(html[lang='en']) .principle h3 {
        font-size: clamp(1.15rem, 1.8vw, 1.45rem);
        line-height: 1.25;
      }

      :global(html[lang='en']) .principle p,
      :global(html[lang='en']) .section-heading p,
      :global(html[lang='en']) .solution-card p {
        font-size: .9375rem;
        line-height: 1.62;
      }

      :global(html[lang='en']) .section-heading h2 {
        max-width: 16ch;
      }

      :global(html[lang='en']) .tool-copy h2 {
        max-width: 15ch;
        font-size: clamp(2rem, 3.3vw, 2.75rem);
        line-height: 1.08;
      }

      :global(html[lang='en']) .tool-copy p {
        max-width: 30rem;
        font-size: .9375rem;
        line-height: 1.62;
      }

      :global(html[lang='en']) .solution-card__copy {
        max-width: 26rem;
      }

      :global(html[lang='en']) .journal-link {
        grid-template-columns: 9rem minmax(0, 1fr) auto;
      }

      :global(html[lang='en']) .journal-link span {
        font-size: 1rem;
      }

      :global(html[lang='en']) .journal-link strong {
        max-width: 30rem;
        font-size: clamp(1.05rem, 1.65vw, 1.35rem);
        line-height: 1.45;
      }

      @media (min-width: 901px) {
        .tool-screen {
          transform: translateY(clamp(1.5rem, 2.5vw, 2rem));
        }
      }

      @media (max-width: 900px) {
        .manifesto, .section-heading, .tool-feature { grid-template-columns: 1fr; }
        .hero-intro { max-width: none; }
        .stage-notes { display: none; }
        .motor-visual { left: 67%; width: min(84vw, 40rem); }
        .motor-product-image {
          right: 1.5rem;
          left: auto;
          width: 56%;
        }
        .stage-copy { top: 15%; }
        .solution-grid { grid-template-columns: 1fr; }
        .solution-card { min-height: 32rem; }
        .section-heading p { margin-left: 0; }
      }

      @media (max-width: 900px) {
