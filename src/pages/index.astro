---
import '../styles/site-shared.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import RevealScript from '../components/RevealScript.astro';

const siteTitle = 'QDrive Tech 伺服电机与运动控制';
const siteSubtitle = '基于 QD4310 的伺服电机平台与二维云台等衍生产品。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteSubtitle} />
    <style>
      .hero {
        margin-top: 1.5rem;
        border-radius: 1.75rem;
        border: none;
        box-shadow: var(--shadow-card);
        padding: 1.75rem 1.5rem;
      }

      .hero-carousel {
        position: relative;
        overflow: hidden;
      }

      .hero-track {
        display: flex;
        transition: transform 220ms ease-out;
      }

      .hero-slide {
        min-width: 100%;
        padding-bottom: 1rem;
      }

      .hero-slide-img {
        width: 100%;
        display: block;
        object-fit: contain;
      }

      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 3fr) minmax(0, 2.4fr);
        gap: 2rem;
        align-items: center;
        padding-inline: 1.25rem;
      }

      .hero-copy {
        padding-left: 2.5rem;
      }

      .hero-controls {
        position: absolute;
        inset-inline: 0.25rem;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        justify-content: space-between;
        pointer-events: none;
      }

      .hero-arrow {
        pointer-events: auto;
        border-radius: 999px;
        width: 2.8rem;
        height: 2.8rem;
        border: 1px solid var(--border-subtle);
        background: rgba(255, 255, 255, 0.9);
        color: #111827;
        box-shadow: var(--shadow-hero-arrow);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 1.5rem;
        transition: transform 140ms ease-out, border-color 140ms ease-out,
          box-shadow 140ms ease-out, background 140ms ease-out;
      }

      .hero-arrow:hover {
        transform: scale(1.03);
        box-shadow: var(--shadow-hero-arrow-hover);
      }

      @media (prefers-color-scheme: dark) {
        .hero-arrow {
          background: rgba(0, 0, 0, 0.6);
          color: #e5e7eb;
        }

        .hero-arrow:hover {
          background: rgba(28, 28, 38, 0.05);
        }
      }

      .hero-arrow:disabled {
        opacity: 0.25;
        cursor: default;
        transform: none;
      }

      .hero-indicators {
        margin-top: 1rem;
        display: flex;
        justify-content: center;
        gap: 0.4rem;
      }

      .hero-dot {
        width: 7px;
        height: 7px;
        border-radius: 999px;
        border: none;
        padding: 0;
        background: rgba(148, 163, 184, 0.5);
        transition: width 160ms ease-out, background-color 160ms ease-out,
          opacity 160ms ease-out;
        opacity: 0.7;
        cursor: pointer;
      }

      .hero-dot--active {
        width: 18px;
        background: var(--accent);
        opacity: 1;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
        margin-top: 1.2rem;
      }

      .hero-meta {
        margin-top: 1.2rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1.4rem;
        font-size: 0.78rem;
        color: var(--text-muted);
      }

      .hero-meta strong {
        display: block;
        font-size: 0.86rem;
        color: var(--accent);
        margin-bottom: 0.12rem;
      }

      .features {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.8rem;
        margin-top: 0.3rem;
      }

      .feature {
        border-radius: 0.9rem;
        padding: 0.7rem 0.75rem;
        background: rgba(0, 0, 0, 0.02);
        border: none;
        box-shadow: var(--shadow-card);
      }

      .feature-label {
        font-size: 0.75rem;
        color: var(--text-muted);
        margin-bottom: 0.15rem;
      }

      .feature-value {
        font-size: 0.9rem;
        color: var(--accent);
      }

      .feature-sub {
        margin-top: 0.1rem;
        font-size: 0.7rem;
        color: var(--text-muted);
      }

      @media (max-width: 900px) {
        .hero {
          padding: 1.4rem 1.25rem;
          border-radius: 1.5rem;
        }

        .hero-grid {
          grid-template-columns: minmax(0, 1fr);
          gap: 1.6rem;
        }

        .hero-copy {
          padding-left: 0;
        }
      }

      @media (max-width: 640px) {
        .hero-actions {
          flex-direction: column;
          align-items: stretch;
        }

        .btn-primary,
        .btn-ghost {
          justify-content: center;
          width: 100%;
          text-align: center;
        }

        .features {
          grid-template-columns: minmax(0, 1fr);
        }
      }
    </style>
  </head>
  <body>
    <div class="page" id="top">
      <main class="shell">
        <SiteHeader />

        <section class="hero hero-bg" id="hero-carousel" data-active-index="0" role="region" aria-roledescription="carousel" aria-label="产品轮播">
          <div class="hero-carousel" data-reveal style="--d: 120ms">
            <div class="hero-track">
              <article class="hero-slide" data-index="0">
                <div class="hero-grid">
                  <div class="hero-copy">
                    <div class="kicker">
                      <span class="kicker-dot" />
                      伺服电机 · 运动控制平台
                    </div>
                    <h1>
                      QD4310<br />
                      高性能伺服运动控制平台
                    </h1>
                    <p class="hero-subtitle">
                      驱控一体中空无刷伺服电机，集成电机、驱动与角度传感器，兼顾高精度、高响应和优越的低速性能，适用于小型云台和车辆
                    </p>
                    <div class="hero-meta">
                      <div>
                        <strong>平台化电机 · 多种控制模式</strong>
                        电驱一体化设计，15 位高精度编码器，电流、速度、角度控制
                      </div>
                      <div>
                        <strong>接口丰富 · 易于集成</strong>
                        XT30 接口供电，USB / CAN / UART / PWM 等多种通讯方式，自研主控与上位机调参
                      </div>
                      <div>
                        <strong>中空轴设计</strong>
                        中空轴设计，可安装导电滑环
                      </div>
                    </div>
                    <div class="hero-actions">
                      <a href="/products/qd4310" class="btn-primary"> 查看详情 </a>
                    </div>
                  </div>
                  <div>
                    <!-- QD4310 主产品图，占位路径：/images/home/qd4310-main.png -->
                    <img
                      class="hero-slide-img"
                      src="/images/home/qd4310-main.png"
                      alt="QD4310 伺服电机渲染图"
                      fetchpriority="high"
                      decoding="async"
                    />
                  </div>
                </div>
              </article>

              <article class="hero-slide" data-index="1">
                <div class="hero-grid">
                  <div class="hero-copy">
                    <div class="kicker">
                      <span class="kicker-dot" />
                      二维云台 · QGimbal
                    </div>
                    <h1>QGimbal 二维云台</h1>
                    <p class="hero-subtitle">
                      基于 QD4310 平台的二维无刷云台，集成陀螺仪、摄像头、激光发射装置，用于监控、测量、视觉采集等应用场景，与精准指向
                    </p>
                    <div class="hero-meta">
                      <div>
                        <strong>运动增稳 · 拍摄消抖</strong>
                        陀螺仪闭环控制，实现双轴增稳与姿态稳定
                      </div>
                      <div>
                        <strong>高帧率摄像头</strong>
                        可实现目标识别、自动跟踪、激光指向等智能功能
                      </div>
                      <div>
                        <strong>继承 QD4310 性能</strong>
                        继承平台电机的响应与精度指标，便于系统统一设计
                      </div>
                    </div>
                    <div class="hero-actions">
                      <a href="/solutions/qgimbal" class="btn-primary"> 查看详情 </a>
                    </div>
                  </div>
                  <div>
                    <!-- QGimbal 云台图，占位路径：/images/home/qgimbal-main.png -->
                    <img
                      class="hero-slide-img"
                      src="/images/home/qgimbal-main.png"
                      alt="QGimbal 二维云台渲染图"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                </div>
              </article>

              <article class="hero-slide" data-index="2">
                <div class="hero-grid">
                  <div class="hero-copy">
                    <div class="kicker">
                      <span class="kicker-dot" />
                      二轮平衡车 · QCar
                    </div>
                    <h1>QCar 二轮平衡车方案</h1>
                    <p class="hero-subtitle">
                      以 QD4310 为轮毂伺服内核的二轮平衡车平台，适用于教学实验、算法验证与轻载搬运等场景
                    </p>
                    <div class="hero-meta">
                      <div>
                        <strong>轮毂伺服一体化</strong>
                        将 QD4310 集成于车轮，实现紧凑布局与高响应控制
                      </div>
                      <div>
                        <strong>用于控制算法验证</strong>
                        适合作为姿态控制、路径规划等算法的实验平台
                      </div>
                    </div>
                    <div class="hero-actions">
                      <a href="/solutions/qcar" class="btn-primary"> 查看详情 </a>
                    </div>
                  </div>
                  <div>
                    <!-- QCar 平衡车图：浅色/深色模式切换 -->
                    <picture>
                      <source
                        srcset="/images/home/qcar-main-dark.png"
                        media="(prefers-color-scheme: dark)"
                      />
                      <img
                        class="hero-slide-img"
                        src="/images/home/qcar-main-light.png"
                        alt="QCar 二轮平衡车渲染图"
                        loading="lazy"
                        decoding="async"
                      />
                    </picture>
                  </div>
                </div>
              </article>
            </div>

            <div class="hero-controls">
              <button class="hero-arrow" type="button" data-dir="prev" aria-label="上一张">
                ‹
              </button>
              <button class="hero-arrow" type="button" data-dir="next" aria-label="下一张">
                ›
              </button>
            </div>
          </div>
          <div class="hero-indicators" role="tablist" aria-label="幻灯片选择" data-reveal style="--d: 220ms">
            <button type="button" class="hero-dot hero-dot--active" data-dot-index="0" role="tab" aria-label="幻灯片 1" aria-selected="true"></button>
            <button type="button" class="hero-dot" data-dot-index="1" role="tab" aria-label="幻灯片 2" aria-selected="false"></button>
            <button type="button" class="hero-dot" data-dot-index="2" role="tab" aria-label="幻灯片 3" aria-selected="false"></button>
          </div>
        </section>

        <section id="products" class="sections" data-reveal style="--d: 320ms">
          <a href="/blog" class="panel" aria-label="进入技术博客">
            <header class="panel-header">
              <div>
                <div class="panel-eyebrow">技术博客</div>
                <div class="panel-title">阅读 QDrive Tech 的技术文章</div>
              </div>
            </header>
            <p class="hero-subtitle">
              记录伺服电机、运动控制与实际应用案例的技术文章，方便工程师了解 QDrive Tech 的产品理念与实践经验
            </p>
          </a>

          <a href="/about" class="panel" aria-label="进入关于 QDrive Tech">
            <header class="panel-header">
              <div>
                <div class="panel-eyebrow">关于 QDrive Tech</div>
                <div class="panel-title">了解公司与产品规划</div>
              </div>
            </header>
            <p class="hero-subtitle">
              查看 QDrive Tech 的定位、产品线规划，公司介绍、企业文化与联系方式等信息
            </p>
          </a>
        </section>
      </main>

      <SiteFooter />
    </div>
  </body>
</html>

<script type="module" is:inline>
  const root = document.querySelector('#hero-carousel');
  if (root) {
    const track = root.querySelector('.hero-track');
    const originalSlides = Array.from(root.querySelectorAll('.hero-slide'));
    const prevBtn = root.querySelector('[data-dir="prev"]');
    const nextBtn = root.querySelector('[data-dir="next"]');
    const dots = Array.from(
      root.querySelectorAll('.hero-indicators .hero-dot'),
    );

    if (!track || originalSlides.length === 0) {
      throw new Error('hero carousel not found');
    }

    const firstClone = originalSlides[0].cloneNode(true);
    const lastClone = originalSlides[originalSlides.length - 1].cloneNode(true);

    track.innerHTML = '';
    track.appendChild(lastClone);
    originalSlides.forEach((s) => track.appendChild(s));
    track.appendChild(firstClone);

    const defaultTransition =
      track.style.transition || 'transform 220ms ease-out';

    let logicalIndex = 0;
    let visualIndex = 1;
    let isAnimating = false;

    const syncDots = () => {
      dots.forEach((dot, idx) => {
        const active = idx === logicalIndex;
        dot.classList.toggle('hero-dot--active', active);
        dot.setAttribute('aria-selected', String(active));
      });
      root.setAttribute('data-active-index', String(logicalIndex));
    };

    const applyTransform = (animate = true) => {
      if (!track) return;
      if (!animate) {
        track.style.transition = 'none';
        track.style.transform = `translateX(${-visualIndex * 100}%)`;
        void track.offsetWidth;
        track.style.transition = defaultTransition;
      } else {
        isAnimating = true;
        track.style.transition = defaultTransition;
        track.style.transform = `translateX(${-visualIndex * 100}%)`;
      }
    };

    const shift = (step) => {
      if (isAnimating) return;
      logicalIndex =
        (logicalIndex + step + originalSlides.length) % originalSlides.length;
      visualIndex += step;
      applyTransform(true);
      syncDots();
    };

    track.addEventListener('transitionend', () => {
      isAnimating = false;
      if (visualIndex === 0) {
        visualIndex = originalSlides.length;
        applyTransform(false);
      } else if (visualIndex === originalSlides.length + 1) {
        visualIndex = 1;
        applyTransform(false);
      }
    });

    let autoTimer = 0;
    const AUTO_INTERVAL = 3500;

    const stopAuto = () => {
      if (autoTimer) {
        clearInterval(autoTimer);
        autoTimer = 0;
      }
    };

    const startAuto = () => {
      stopAuto();
      autoTimer = window.setInterval(() => {
        shift(1);
      }, AUTO_INTERVAL);
    };

    prevBtn?.addEventListener('click', () => {
      stopAuto();
      shift(-1);
    });

    nextBtn?.addEventListener('click', () => {
      stopAuto();
      shift(1);
    });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        if (isAnimating || idx === logicalIndex) return;
        stopAuto();
        logicalIndex = idx;
        visualIndex = idx + 1;
        applyTransform(true);
        syncDots();
      });
    });

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        stopAuto();
        shift(-1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        stopAuto();
        shift(1);
      }
    });

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    applyTransform(false);
    syncDots();
    if (!prefersReducedMotion.matches) startAuto();

    prefersReducedMotion.addEventListener('change', (e) => {
      if (e.matches) stopAuto();
      else startAuto();
    });
  }
</script>

<RevealScript />
