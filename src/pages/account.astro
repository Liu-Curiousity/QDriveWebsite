---
import '../styles/site-shared.css';
import '../styles/auth-control.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteFavicon from '../components/SiteFavicon.astro';
import RevealScript from '../components/RevealScript.astro';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>个人账户 · QDrive Tech</title>
    <meta name="description" content="管理 QDrive Tech 个人资料、账号绑定与积分。" />
    <SiteFavicon />
  </head>
  <body>
    <div class="page" id="top">
      <main class="shell">
        <SiteHeader />

        <section class="account-page account-page--github" data-account-root aria-labelledby="account-page-title">
          <div class="account-gh__layout">
            <aside class="account-gh__sidebar" aria-label="个人资料">
              <form class="account-profile-form" data-account-profile-form>
                <div class="account-gh__avatar-wrap">
                  <span class="account-profile-form__avatar" data-account-avatar>Q</span>
                  <label class="account-gh__avatar-change">
                    <span>更换头像</span>
                    <input type="file" accept="image/png,image/jpeg,image/webp" data-account-avatar-input hidden />
                  </label>
                  <span class="account-gh__status-dot" aria-label="在线"></span>
                </div>
                <div class="account-profile-form__identity">
                  <strong data-account-name>QDrive 用户</strong>
                  <span data-account-identity>账户资料</span>
                  <span data-account-username-text hidden></span>
                  <small data-account-username-hint hidden></small>
                </div>
                <label class="account-gh__nickname">
                  <span>昵称</span>
                  <input type="text" maxlength="32" autocomplete="nickname" placeholder="QDrive 用户" data-account-nickname />
                  <small>按 Enter 保存</small>
                </label>
                <input type="text" data-account-username hidden />
                <button type="submit" data-account-profile-save hidden aria-hidden="true">保存</button>
              </form>
              <div class="account-gh__sidebar-links">
                <a class="is-active" href="#account-bindings-title" data-account-side-link>账号绑定</a>
                <a href="#account-points-title" data-account-side-link>积分</a>
                <a href="#account-messages-title" data-account-side-link>
                  <span>消息提醒</span>
                  <span class="account-message-badge" data-account-message-badge hidden>0</span>
                </a>
              </div>
            </aside>

            <div class="account-gh__main">
              <header class="account-gh__heading">
                <div>
                  <div class="account-gh__eyebrow">ACCOUNT / PROFILE</div>
                  <h1 id="account-page-title">个人账户</h1>
                  <p>查看你的 QDrive Tech 账户资料、联系方式与服务权益。</p>
                </div>
                <span class="account-gh__handle" data-account-meta>账户资料</span>
              </header>

              <nav class="account-gh__tabs" aria-label="账户导航">
                <a class="is-active" href="#profile">概览</a>
                <a href="#account-bindings-title">账号绑定</a>
                <a href="#account-points-title">积分</a>
                <a href="#account-messages-title">消息</a>
              </nav>

              <section class="account-page__bindings account-bindings-panel account-gh__panel" id="profile" aria-labelledby="account-bindings-title">
                <header class="account-gh__panel-heading">
                  <div>
                    <div class="account-gh__eyebrow">ACCOUNT CONNECTIONS</div>
                    <h2 id="account-bindings-title">账号绑定</h2>
                  </div>
                  <p>绑定邮箱或手机号，用于验证码登录和找回账户。</p>
                </header>
                <div class="account-bindings">
                  <form class="account-binding-card" data-account-binding="email">
                    <div class="account-binding-card__header"><div><span>EMAIL</span><h3>邮箱</h3></div><span class="account-binding-card__state" data-account-email-state>未绑定</span></div>
                    <p data-account-email-current>绑定后可使用邮箱验证码登录。</p>
                    <div data-account-binding-fields>
                      <label><span>邮箱地址</span><input type="email" autocomplete="email" placeholder="name@example.com" data-account-email /></label>
                      <div class="account-binding-card__code"><input type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="验证码" data-account-email-code /><button type="button" data-account-email-send>发送验证码</button></div>
                      <button class="account-secondary-button" type="submit" data-account-bind-submit>绑定邮箱</button>
                    </div>
                    <div class="account-binding-card__unbind" data-account-unbind-panel data-account-email-unbind-panel hidden><p>如需解除绑定，请使用发送到该邮箱的验证码确认。</p><div class="account-binding-card__code"><input type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="解除验证码" data-account-email-unbind-code /><button type="button" data-account-email-unbind-send>发送验证码</button></div><button class="account-secondary-button" type="button" data-account-email-unbind-submit>解除绑定</button></div>
                  </form>
                  <form class="account-binding-card" data-account-binding="phone">
                    <div class="account-binding-card__header"><div><span>PHONE</span><h3>手机号</h3></div><span class="account-binding-card__state" data-account-phone-state>未绑定</span></div>
                    <p data-account-phone-current>当前仅支持中国大陆 +86 手机号。</p>
                    <div data-account-binding-fields>
                      <label><span>手机号码</span><input type="tel" inputmode="tel" autocomplete="tel" placeholder="138 0000 0000" data-account-phone /></label>
                      <div class="account-binding-card__code"><input type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="验证码" data-account-phone-code /><button type="button" data-account-phone-send>发送验证码</button></div>
                      <button class="account-secondary-button" type="submit" data-account-bind-submit>绑定手机号</button>
                    </div>
                    <div class="account-binding-card__unbind" data-account-unbind-panel data-account-phone-unbind-panel hidden><p>如需解除绑定，请使用发送到该手机号的验证码确认。</p><div class="account-binding-card__code"><input type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="解除验证码" data-account-phone-unbind-code /><button type="button" data-account-phone-unbind-send>发送验证码</button></div><button class="account-secondary-button" type="button" data-account-phone-unbind-submit>解除绑定</button></div>
                  </form>
                </div>
              </section>

              <aside class="account-points-card account-page__points account-gh__panel" id="account-points-title" aria-labelledby="account-points-heading">
                <div class="account-gh__panel-heading">
                  <div>
                    <div class="account-gh__eyebrow">QDRIVE POINTS</div>
                    <h2 id="account-points-heading">已获得积分</h2>
                  </div>
                  <span class="account-gh__coming">AVAILABLE</span>
                </div>
                <strong class="account-points-card__value" data-account-points>0</strong>
                <p>提交开发贡献可获得积分，也可以提交兑换申请，由管理员发放对应优惠券。</p>
                <div class="account-points-card__actions">
                  <button type="button" data-account-contribution-open>获取积分</button>
                  <button type="button" data-account-redemption-open>兑换积分</button>
                  <a href="/admin/contributions" data-account-admin-link hidden>审核贡献</a>
                  <a href="/admin/redemptions" data-account-redemption-admin-link hidden>审核兑换</a>
                </div>
              </aside>

              <section class="account-message-panel account-gh__panel" id="account-messages-title" aria-labelledby="account-messages-heading">
                <div class="account-gh__panel-heading">
                  <div>
                    <div class="account-gh__eyebrow">ACCOUNT MESSAGES</div>
                    <h2 id="account-messages-heading">消息提醒</h2>
                  </div>
                  <button type="button" data-account-messages-read-all>全部已读</button>
                </div>
                <div class="account-message-list" data-account-message-list>
                  <p class="account-contribution-history__empty">正在读取消息…</p>
                </div>
              </section>
            </div>
          </div>

          <p class="account-dialog__status account-page__status" data-account-status aria-live="polite"></p>

          <dialog class="account-crop-dialog" data-account-crop-dialog aria-labelledby="account-crop-title">
            <div class="account-crop-dialog__header">
              <div>
                <div class="account-gh__eyebrow">EDIT AVATAR</div>
                <h2 id="account-crop-title">裁切头像</h2>
              </div>
              <button type="button" class="account-crop-dialog__close" data-account-crop-cancel aria-label="关闭裁切窗口">×</button>
            </div>
            <p class="account-crop-dialog__hint">拖动图片调整位置，滚动鼠标滚轮缩放。</p>
            <div class="account-crop-dialog__stage">
              <canvas width="600" height="400" data-account-crop-canvas aria-label="拖动圆形选区裁切头像"></canvas>
            </div>
            <div class="account-crop-dialog__actions">
              <button type="button" data-account-crop-cancel>取消</button>
              <button type="button" class="account-crop-dialog__apply" data-account-crop-apply>使用此头像</button>
            </div>
          </dialog>

          <dialog class="account-contribution-dialog" data-account-contribution-dialog aria-labelledby="account-contribution-title">
            <div class="account-crop-dialog__header">
              <div>
                <div class="account-gh__eyebrow">CONTRIBUTION</div>
                <h2 id="account-contribution-title">提交开发贡献</h2>
              </div>
              <button type="button" class="account-crop-dialog__close" data-account-contribution-cancel aria-label="关闭提交窗口">×</button>
            </div>
            <p class="account-contribution-dialog__intro">描述你为 QDrive Tech 完成的开发、测试、文档或内容贡献，审核通过后将发放积分。</p>
            <form data-account-contribution-form>
              <label>
                <span>贡献说明</span>
                <textarea maxlength="2000" rows="6" placeholder="请说明完成了什么、解决了什么问题，以及可供审核的相关信息。" data-account-contribution-content required></textarea>
              </label>
              <div class="account-contribution-dialog__upload">
                <span>相关附件（可选，最多 5 个，单个不超过 8 MB）</span>
                <label class="account-contribution-dialog__picker">
                  <span>选择附件</span>
                  <input type="file" multiple data-account-contribution-attachments hidden aria-label="选择附件" />
                </label>
                <ul class="account-contribution-dialog__files" data-account-contribution-files>
                  <li class="is-empty">尚未选择附件</li>
                </ul>
              </div>
              <p class="account-dialog__status" data-account-contribution-status aria-live="polite"></p>
              <div class="account-crop-dialog__actions">
                <button type="button" data-account-contribution-cancel>取消</button>
                <button type="submit" class="account-crop-dialog__apply" data-account-contribution-submit>提交审核</button>
              </div>
            </form>
            <section class="account-contribution-history" aria-labelledby="account-contribution-history-title">
              <h3 id="account-contribution-history-title">提交记录</h3>
              <div data-account-contribution-list><p>正在读取…</p></div>
            </section>
          </dialog>

          <dialog class="account-contribution-dialog account-redemption-dialog" data-account-redemption-dialog aria-labelledby="account-redemption-title">
            <div class="account-crop-dialog__header">
              <div>
                <div class="account-gh__eyebrow">POINTS REDEMPTION</div>
                <h2 id="account-redemption-title">兑换积分</h2>
              </div>
              <button type="button" class="account-crop-dialog__close" data-account-redemption-cancel aria-label="关闭兑换窗口">×</button>
            </div>
            <p class="account-contribution-dialog__intro">提交后由管理员核对并向淘宝账号发放优惠券，处理结果会发送到消息提醒。</p>
            <div class="account-redemption-dialog__balance">
              <span>当前可兑换</span>
              <strong><span data-account-redemption-available>0</span> 积分</strong>
            </div>
            <form data-account-redemption-form>
              <fieldset class="account-redemption-dialog__modes">
                <legend>兑换数量</legend>
                <label><input type="radio" name="redemption-mode" value="all" checked data-account-redemption-mode />全部兑换</label>
                <label><input type="radio" name="redemption-mode" value="custom" data-account-redemption-mode />自定义数量</label>
              </fieldset>
              <label>
                <span>兑换积分</span>
                <input type="number" min="1" step="1" inputmode="numeric" data-account-redemption-points disabled />
              </label>
              <label>
                <span>淘宝账号</span>
                <input type="text" minlength="2" maxlength="64" autocomplete="username" placeholder="用于接收优惠券" data-account-redemption-taobao required />
              </label>
              <p class="account-dialog__status" data-account-redemption-status aria-live="polite"></p>
              <div class="account-crop-dialog__actions">
                <button type="button" data-account-redemption-cancel>取消</button>
                <button type="submit" class="account-crop-dialog__apply" data-account-redemption-submit>提交兑换申请</button>
              </div>
            </form>
            <section class="account-contribution-history" aria-labelledby="account-redemption-history-title">
              <h3 id="account-redemption-history-title">兑换记录</h3>
              <div data-account-redemption-list><p>正在读取…</p></div>
            </section>
          </dialog>
        </section>
      </main>
      <SiteFooter />
    </div>
    <RevealScript />
  </body>
</html>

<script>
  import '../scripts/account-control';
</script>
