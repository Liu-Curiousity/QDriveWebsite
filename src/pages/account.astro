---
import '../styles/site-shared.css';
import '../styles/auth-control.css';
import '../styles/account-page.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteFavicon from '../components/SiteFavicon.astro';
import RevealScript from '../components/RevealScript.astro';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>个人账户 · QDrive Tech</title>
    <meta name="description" content="管理 QDrive Tech 个人资料、账号等级、经验、账号安全与积分。" />
    <SiteFavicon />
  </head>
  <body>
    <div class="page" id="top">
      <main class="shell">
        <SiteHeader />

        <section class="account-page account-page--github account-page--simple" data-account-root data-account-auth-state="checking" aria-labelledby="account-page-title">
          <div class="account-gh__layout" data-account-content>
            <aside class="account-gh__sidebar" aria-label="个人资料">
              <header class="account-simple__intro" id="profile">
                <div class="account-gh__eyebrow">ACCOUNT / PROFILE</div>
                <h1 id="account-page-title">个人中心</h1>
                <p>账户状态、积分和重要消息，集中在一处。</p>
              </header>
              <form class="account-profile-form" data-account-profile-form>
                <div class="account-gh__avatar-wrap">
                  <span class="account-profile-form__avatar" data-account-avatar>Q</span>
                  <label class="account-gh__avatar-change">
                    <span>更换头像</span>
                    <input type="file" accept="image/png,image/jpeg,image/webp" data-account-avatar-input hidden />
                  </label>
                  <span class="account-gh__status-dot" aria-label="在线"></span>
                </div>
                <div class="account-profile-form__identity">
                  <strong data-account-name>QDrive 用户</strong>
                  <span data-account-identity>账户资料</span>
                  <span data-account-meta hidden>账户资料</span>
                  <span data-account-username-text hidden></span>
                  <small data-account-username-hint hidden></small>
                </div>
                <label class="account-gh__nickname">
                  <span>昵称</span>
                  <input type="text" maxlength="32" autocomplete="nickname" placeholder="QDrive 用户" data-account-nickname />
                  <small>按 Enter 保存</small>
                </label>
                <input type="text" data-account-username hidden />
                <button type="submit" data-account-profile-save hidden aria-hidden="true">保存</button>
              </form>
              <p class="account-dialog__status account-page__status" data-account-status aria-live="polite"></p>
            </aside>

            <div class="account-gh__main">
              <nav class="account-gh__tabs" aria-label="账户导航">
                <a class="is-active" href="#profile" data-account-side-link>概览</a>
                <a href="#account-messages-title" data-account-side-link>消息 <span class="account-message-badge" data-account-message-badge hidden>0</span></a>
                <a href="#account-security-title" data-account-side-link>账号安全</a>
              </nav>

              <section class="account-level-card account-gh__panel" id="account-level-title" aria-labelledby="account-level-heading" data-level-tier="foundation">
                <div class="account-level-card__heading">
                  <div>
                    <div class="account-gh__eyebrow">QDRIVE EXPERIENCE</div>
                    <h2 id="account-level-heading">账号等级</h2>
                  </div>
                  <strong class="account-level-card__level" data-account-level data-level-tier="unknown">—</strong>
                </div>
                <div class="account-level-card__progress" role="progressbar" aria-label="当前等级经验进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-account-experience-progress><i></i></div>
                <div class="account-level-card__stats">
                  <span><strong data-account-experience>—</strong> 总经验</span>
                  <span data-account-experience-remaining>—</span>
                  <span><strong data-account-usage>—</strong> 有效使用时长</span>
                </div>
                <details class="account-simple__help">
                  <summary>等级如何计算</summary>
                  <p>等级上限为 100 级，满级累计需要 500,000 经验，满级后经验仍可继续累计；每 20 级提升一次升级难度，越接近满级所需经验越多。页面可见时每使用 60 秒获得 1 经验；每获得 1 积分，另外获得 10 经验。消费积分不会减少经验。</p>
                </details>
              </section>

              <aside class="account-points-card account-page__points account-gh__panel" id="account-points-title" aria-labelledby="account-points-heading">
                <div class="account-gh__panel-heading">
                  <div>
                    <div class="account-gh__eyebrow">AVAILABLE POINTS</div>
                    <h2 id="account-points-heading">可用积分</h2>
                  </div>
                </div>
                <div class="account-points-card__metric">
                  <span class="account-gh__coming">AVAILABLE</span>
                  <strong class="account-points-card__value" data-account-points>—</strong>
                </div>
                <p>用贡献所得积分兑换开发配件或专属权益。</p>
                <div class="account-points-card__actions">
                  <a href="/point-mall">浏览积分商城</a>
                  <button type="button" data-account-contribution-open>提交贡献</button>
                  <button type="button" data-account-redemption-open>兑换优惠券</button>
                  <a href="/admin" data-account-admin-center-link hidden>管理员中心</a>
                </div>
              </aside>

              <section class="account-message-panel account-gh__panel" id="account-messages-title" aria-labelledby="account-messages-heading">
                <div class="account-gh__panel-heading account-simple__section-heading">
                  <div>
                    <div class="account-gh__eyebrow">RECENT ACTIVITY</div>
                    <h2 id="account-messages-heading">最近消息</h2>
                    <p data-account-messages-summary>提交、兑换、抽奖、订单与审核结果统一收纳于此。</p>
                  </div>
                  <div class="account-message-actions">
                    <button type="button" data-account-messages-read-all disabled>全部已读</button>
                    <button type="button" class="is-delete" data-account-messages-delete-read disabled>清理已读</button>
                  </div>
                </div>
                <p class="account-message-status" data-account-messages-status aria-live="polite"></p>
                <div class="account-message-list" data-account-message-list>
                  <p class="account-contribution-history__empty">正在读取消息…</p>
                </div>
                <button class="account-message-toggle" type="button" data-account-messages-toggle hidden>查看全部消息</button>
              </section>

              <section class="account-security-panel account-gh__panel" id="account-security-title" aria-labelledby="account-security-heading">
                <header class="account-gh__panel-heading account-simple__section-heading">
                  <div>
                    <div class="account-gh__eyebrow">ACCOUNT SECURITY</div>
                    <h2 id="account-security-heading">账号安全</h2>
                  </div>
                  <p>只在需要时展开对应设置。</p>
                </header>
                <div class="account-security-grid">
                  <details class="account-security-disclosure account-security-disclosure--username" name="account-security">
                    <summary><span><small>USERNAME</small><strong>创建用户名</strong></span><em>未设置</em></summary>
                    <form class="account-binding-card" data-account-username-create hidden>
                      <p class="account-security-intro">为当前账户补充一个易记的登录名称，之后可使用用户名或邮箱登录。</p>
                      <div class="account-security-fields">
                        <label><span>用户名</span><input type="text" minlength="4" maxlength="20" autocomplete="username" placeholder="例如 QDrive_User" aria-describedby="account-username-note" data-account-create-username /></label>
                      </div>
                      <small class="account-security-note" id="account-username-note"><strong>请确认后再创建</strong><span>4–20 位，以字母开头，仅支持字母、数字和下划线；创建后不可自行修改。</span></small>
                      <div class="account-security-actions"><button class="account-secondary-button" type="submit" data-account-create-username-submit>创建用户名</button></div>
                    </form>
                  </details>
                  <details class="account-security-disclosure" name="account-security">
                    <summary><span><small>EMAIL</small><strong>登录邮箱</strong></span><em data-account-email-state>未绑定</em></summary>
                    <form class="account-binding-card" data-account-binding="email">
                      <p class="account-security-intro" data-account-email-current>绑定后可使用邮箱验证码登录，并用于账户安全验证。</p>
                      <div class="account-security-fields" data-account-binding-fields>
                        <label><span>邮箱地址</span><input type="email" autocomplete="email" placeholder="name@example.com" data-account-email /></label>
                        <div class="account-security-code-field"><span id="account-email-code-label">邮箱验证码</span><div class="account-binding-card__code"><input type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="输入 6 位验证码" aria-labelledby="account-email-code-label" data-account-email-code /><button type="button" data-account-email-send>发送验证码</button></div></div>
                        <small class="account-security-note account-security-note--plain">验证码将发送至上方邮箱，有效时间以邮件提示为准。</small>
                        <div class="account-security-actions"><button class="account-secondary-button" type="submit" data-account-bind-submit>绑定邮箱</button></div>
                      </div>
                      <div class="account-binding-card__unbind" data-account-unbind-panel data-account-email-unbind-panel hidden><p>换绑前，请使用发送到当前邮箱的验证码确认身份。</p><div class="account-security-code-field"><span id="account-email-unbind-code-label">当前邮箱验证码</span><div class="account-binding-card__code"><input type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="输入 6 位验证码" aria-labelledby="account-email-unbind-code-label" data-account-email-unbind-code /><button type="button" data-account-email-unbind-send>发送验证码</button></div></div><div class="account-security-actions"><button class="account-secondary-button" type="button" data-account-email-unbind-submit>验证当前邮箱</button></div></div>
                    </form>
                  </details>
                  <details class="account-security-disclosure" name="account-security">
                    <summary><span><small>PASSWORD</small><strong>修改密码</strong></span><em>按需更新</em></summary>
                    <form class="account-password-form" data-account-password-form novalidate>
                      <p class="account-security-intro">设置新密码后，当前登录状态不受影响；下次登录请使用新密码。</p>
                      <div class="account-security-fields account-security-fields--password">
                        <label><span>当前密码</span><input type="password" autocomplete="current-password" placeholder="请输入当前密码" data-account-current-password required /></label>
                        <label><span>新密码</span><input type="password" autocomplete="new-password" minlength="6" placeholder="至少 6 位" data-account-new-password required /></label>
                        <label><span>确认新密码</span><input type="password" autocomplete="new-password" minlength="6" placeholder="再次输入新密码" data-account-confirm-password required /></label>
                      </div>
                      <div class="account-password-form__footer"><p class="account-password-form__status" data-account-password-status aria-live="polite"></p><button type="submit" data-account-password-submit>修改密码</button></div>
                    </form>
                  </details>
                </div>
              </section>
            </div>
          </div>

          <dialog class="account-message-delete-dialog qdrive-modal-reference" data-account-messages-delete-dialog aria-labelledby="account-message-delete-title">
            <div class="account-message-delete-dialog__copy">
              <div class="account-gh__eyebrow">MESSAGE CLEANUP</div>
              <h2 id="account-message-delete-title">删除全部已读消息？</h2>
              <p>只会删除已经读过的消息，未读消息会继续保留。删除后无法恢复。</p>
            </div>
            <div class="account-message-delete-dialog__actions">
              <button type="button" data-account-messages-delete-cancel>取消</button>
              <button type="button" class="is-confirm" data-account-messages-delete-confirm>确认删除</button>
            </div>
          </dialog>

          <dialog class="account-crop-dialog qdrive-modal-reference" data-account-crop-dialog aria-labelledby="account-crop-title">
            <div class="account-crop-dialog__header">
              <div>
                <div class="account-gh__eyebrow">EDIT AVATAR</div>
                <h2 id="account-crop-title">裁切头像</h2>
              </div>
              <button type="button" class="account-crop-dialog__close" data-account-crop-cancel aria-label="关闭裁切窗口">×</button>
            </div>
            <p class="account-crop-dialog__hint">拖动图片调整位置，滚动鼠标滚轮缩放。</p>
            <div class="account-crop-dialog__stage">
              <canvas width="600" height="400" data-account-crop-canvas aria-label="拖动圆形选区裁切头像"></canvas>
            </div>
            <div class="account-crop-dialog__actions">
              <button type="button" data-account-crop-cancel>取消</button>
              <button type="button" class="account-crop-dialog__apply" data-account-crop-apply>使用此头像</button>
            </div>
          </dialog>

          <dialog class="account-contribution-dialog qdrive-modal-reference" data-account-contribution-dialog aria-labelledby="account-contribution-title">
            <div class="account-crop-dialog__header">
              <div>
                <div class="account-gh__eyebrow">CONTRIBUTION</div>
                <h2 id="account-contribution-title">提交开发贡献</h2>
              </div>
              <button type="button" class="auth-dialog__close account-modal__close" data-account-contribution-cancel aria-label="关闭提交窗口"><span aria-hidden="true"></span></button>
            </div>
            <p class="account-contribution-dialog__intro">描述你为 QDrive Tech 完成的开发、测试、文档或内容贡献，审核通过后将发放积分。</p>
            <form data-account-contribution-form>
              <label>
                <span>贡献说明</span>
                <textarea maxlength="2000" rows="6" placeholder="请说明完成了什么、解决了什么问题，以及可供审核的相关信息。" data-account-contribution-content required></textarea>
              </label>
              <div class="account-contribution-dialog__upload">
                <span>相关附件（可选，最多 5 个，单个不超过 8 MB）</span>
                <label class="account-contribution-dialog__picker">
                  <span>选择附件</span>
                  <input type="file" multiple data-account-contribution-attachments hidden aria-label="选择附件" />
                </label>
                <ul class="account-contribution-dialog__files" data-account-contribution-files>
                  <li class="is-empty">尚未选择附件</li>
                </ul>
              </div>
              <p class="account-dialog__status" data-account-contribution-status aria-live="polite"></p>
              <div class="account-crop-dialog__actions">
                <button type="button" data-account-contribution-cancel>取消</button>
                <button type="submit" class="account-crop-dialog__apply" data-account-contribution-submit>提交审核</button>
              </div>
            </form>
          </dialog>

          <dialog class="account-contribution-dialog account-redemption-dialog qdrive-modal-reference" data-account-redemption-dialog aria-labelledby="account-redemption-title">
            <div class="account-crop-dialog__header">
              <div>
                <div class="account-gh__eyebrow">POINTS REDEMPTION</div>
                <h2 id="account-redemption-title">兑换积分</h2>
              </div>
              <button type="button" class="auth-dialog__close account-modal__close" data-account-redemption-cancel aria-label="关闭兑换窗口"><span aria-hidden="true"></span></button>
            </div>
            <p class="account-contribution-dialog__intro">提交后由管理员核对并向淘宝账号发放优惠券，处理结果统一收纳到个人中心消息中心。</p>
            <div class="account-redemption-dialog__balance">
              <span>当前可兑换</span>
              <strong><span data-account-redemption-available>0</span> 积分</strong>
            </div>
            <form data-account-redemption-form>
              <fieldset class="account-redemption-dialog__modes">
                <legend>兑换数量</legend>
                <label><input type="radio" name="redemption-mode" value="all" checked data-account-redemption-mode />全部兑换</label>
                <label><input type="radio" name="redemption-mode" value="custom" data-account-redemption-mode />自定义数量</label>
              </fieldset>
              <label>
                <span>兑换积分</span>
                <input type="number" min="1" step="1" inputmode="numeric" data-account-redemption-points disabled />
              </label>
              <label>
                <span>淘宝账号</span>
                <input type="text" minlength="2" maxlength="64" autocomplete="username" placeholder="用于接收优惠券" data-account-redemption-taobao required />
              </label>
              <p class="account-dialog__status" data-account-redemption-status aria-live="polite"></p>
              <div class="account-crop-dialog__actions">
                <button type="button" data-account-redemption-cancel>取消</button>
                <button type="submit" class="account-crop-dialog__apply" data-account-redemption-submit>提交兑换申请</button>
              </div>
            </form>
          </dialog>
        </section>
      </main>
      <SiteFooter />
    </div>
    <RevealScript />
  </body>
</html>

<script>
  import '../scripts/account-control';
</script>
