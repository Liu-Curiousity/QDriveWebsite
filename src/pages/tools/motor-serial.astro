---
import '../../styles/site-shared.css';
import '@xterm/xterm/css/xterm.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteFavicon from '../../components/SiteFavicon.astro';
import RevealScript from '../../components/RevealScript.astro';

const title = '串口工具';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - QDrive Tech</title>
    <meta name="description" content={title} />
    <SiteFavicon />
    <style>
      .serial-page-intro {
        margin-top: 1.25rem;
      }

      .serial-banner {
        border-radius: 1rem;
        padding: 0.85rem 1rem;
        font-size: 0.82rem;
        line-height: 1.5;
        background: var(--accent-soft);
        color: var(--text-main);
        border: 1px solid var(--border-subtle);
        margin-bottom: 1rem;
      }

      .serial-banner[hidden] {
        display: none !important;
      }

      .serial-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 0.75rem;
      }

      .serial-toolbar label {
        font-size: 0.78rem;
        color: var(--text-muted);
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
      }

      /* 自定义下拉（与站点卡片 / 导航弹窗同系变量） */
      .serial-dd {
        position: relative;
        display: inline-block;
        min-width: 0;
      }

      .serial-dd--block {
        display: block;
        width: 100%;
        margin-top: 0.35rem;
      }

      .serial-dd-trigger {
        font: inherit;
        font-size: 0.82rem;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        min-width: 7.5rem;
        padding: 0.4rem 0.65rem;
        border-radius: 0.65rem;
        border: 1px solid var(--border-subtle);
        background: var(--bg-elevated);
        color: var(--text-main);
        cursor: pointer;
        box-shadow: var(--shadow-card);
        transition: border-color 150ms ease-out, box-shadow 150ms ease-out, background 150ms ease-out;
        text-align: left;
      }

      .serial-dd-trigger:hover {
        border-color: color-mix(in srgb, var(--accent) 35%, var(--border-subtle));
        box-shadow: var(--shadow-card-hover);
      }

      .serial-dd-trigger:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .serial-dd-trigger:disabled {
        opacity: 0.55;
        cursor: not-allowed;
        box-shadow: none;
      }

      .serial-dd-trigger--block {
        width: 100%;
        min-width: 0;
      }

      .serial-dd-trigger-label {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 500;
      }

      .serial-dd-chevron {
        flex-shrink: 0;
        width: 1rem;
        height: 1rem;
        color: var(--text-muted);
        transition: transform 160ms ease-out;
      }

      .serial-dd-trigger[aria-expanded='true'] .serial-dd-chevron {
        transform: rotate(180deg);
      }

      .serial-dd-menu {
        position: absolute;
        z-index: 140;
        left: 0;
        right: 0;
        top: calc(100% + 6px);
        margin: 0;
        padding: 0.4rem;
        list-style: none;
        border-radius: 0.9rem;
        border: 1px solid var(--border-subtle);
        background: var(--bg-elevated);
        color: var(--text-main);
        box-shadow: var(--shadow-popover);
        max-height: min(16rem, 52vh);
        overflow-y: auto;
        overscroll-behavior: contain;
        transform-origin: 50% 0;
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0) scale(1);
        transition:
          opacity 0.2s ease-out,
          transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
          visibility 0.2s;
      }

      /* 不用 display:none，才能做过渡；仍保留 hidden 语义与脚本逻辑 */
      .serial-dd .serial-dd-menu[hidden] {
        display: block !important;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(-6px) scale(0.98);
      }

      @media (prefers-reduced-motion: reduce) {
        .serial-dd-menu {
          transition-duration: 0.01ms;
        }
      }

      .serial-dd-item {
        display: block;
        width: 100%;
        font: inherit;
        font-size: 0.8rem;
        text-align: left;
        padding: 0.48rem 0.6rem;
        margin: 0;
        border: none;
        border-radius: 0.55rem;
        background: transparent;
        color: var(--text-main);
        cursor: pointer;
        transition: background 120ms ease-out, color 120ms ease-out;
      }

      .serial-dd-item:hover,
      .serial-dd-item:focus-visible {
        background: var(--accent-soft);
        color: var(--accent);
        outline: none;
      }

      .serial-dd-item--muted {
        color: var(--text-muted);
        font-weight: 500;
      }

      .serial-dd-item--muted:hover,
      .serial-dd-item--muted:focus-visible {
        color: var(--text-main);
      }

      .serial-status {
        font-size: 0.78rem;
        color: var(--text-muted);
        flex: 1 1 12rem;
        min-width: 0;
      }

      .serial-layout {
        display: grid;
        grid-template-columns: minmax(220px, 0.9fr) minmax(0, 1.45fr) minmax(260px, 1fr);
        gap: 1.25rem;
        align-items: stretch;
        margin-top: 1rem;
      }

      .serial-col-left,
      .serial-col-right {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        min-width: 0;
      }

      .serial-terminal-card {
        display: flex;
        flex-direction: column;
        min-height: 0;
        min-width: 0;
      }

      .serial-terminal-card--shell {
        min-height: min(70vh, 36rem);
      }

      .serial-terminal-wrap {
        flex: 1;
        min-height: 22rem;
        border-radius: 0.85rem;
        border: 1px solid var(--border-subtle);
        overflow: hidden;
        background: var(--bg-elevated);
      }

      .serial-terminal-card--shell .serial-terminal-wrap {
        min-height: 0;
        flex: 1 1 auto;
      }

      #terminal {
        height: 100%;
        min-height: 22rem;
      }

      .serial-terminal-card--shell #terminal {
        min-height: 0;
      }

      .serial-col-left .serial-toolbar {
        margin-bottom: 0;
      }

      .serial-col-left .serial-status {
        flex: 1 1 100%;
      }

      .serial-side-block {
        border-radius: 1rem;
        border: none;
        box-shadow: var(--shadow-card);
        background: var(--bg-elevated);
        padding: 1rem 0.95rem;
      }

      .serial-btn-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
      }

      .serial-drive-row {
        align-items: center;
      }

      .serial-drive-state {
        display: inline-flex;
        align-items: center;
        gap: 0.38rem;
        flex-shrink: 0;
        margin-left: 0.65rem;
        font-size: 0.74rem;
        font-weight: 500;
        line-height: 1.2;
        color: var(--text-muted);
        min-height: 1.85rem;
      }

      .serial-drive-state-dot {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 50%;
        flex-shrink: 0;
        background: var(--text-muted);
        opacity: 0.85;
      }

      .serial-drive-state[data-state='disconnected'] .serial-drive-state-dot {
        background: #9ca3af;
        opacity: 1;
        box-shadow: none;
      }

      .serial-drive-state[data-state='unknown'] .serial-drive-state-dot {
        background: #eab308;
        opacity: 1;
        box-shadow: 0 0 0 2px color-mix(in srgb, #eab308 28%, transparent);
      }

      .serial-drive-state[data-state='on'] .serial-drive-state-dot {
        background: #22c55e;
        opacity: 1;
        box-shadow: 0 0 0 2px color-mix(in srgb, #22c55e 30%, transparent);
      }

      .serial-drive-state[data-state='off'] .serial-drive-state-dot {
        background: #f97316;
        opacity: 1;
        box-shadow: 0 0 0 2px color-mix(in srgb, #f97316 28%, transparent);
      }

      .serial-drive-state[data-state='on'] {
        color: color-mix(in srgb, #22c55e 55%, var(--text-main));
      }

      .serial-drive-state[data-state='off'] {
        color: color-mix(in srgb, #f97316 45%, var(--text-main));
      }

      /* 仅主按钮（读取设备 / 使能 / 读取参数）保留小号 pill 尺寸 */
      .serial-btn {
        font: inherit;
        font-size: 0.76rem;
        padding: 0.38rem 0.65rem;
        border-radius: 999px;
        border: 1px solid var(--border-subtle);
        background: var(--accent-soft);
        color: var(--text-main);
        cursor: pointer;
        transition: border-color 150ms ease-out, background 150ms ease-out, color 150ms ease-out;
      }

      .serial-btn:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      /* 与 qd4310「资料下载」.fw-version-dl 一致；button 继承页面字体 */
      .serial-layout button.fw-version-dl {
        font-family: inherit;
      }

      .serial-layout button.fw-version-dl:disabled {
        opacity: 0.55;
        cursor: not-allowed;
        transform: none;
        box-shadow: var(--shadow-fw-version-dl);
      }

      .serial-layout button.fw-version-dl:disabled:hover {
        transform: none;
        box-shadow: var(--shadow-fw-version-dl);
        color: var(--text-main);
        background: #f7f8f9;
      }

      @media (prefers-color-scheme: dark) {
        .serial-layout button.fw-version-dl:disabled:hover {
          background: #161618;
        }
      }

      /* 断开：视觉同资料下载，尺寸保持原 btn-ghost */
      #serial-disconnect.fw-version-dl {
        padding: 0.5rem 1.1rem;
        font-size: 0.88rem;
      }

      /* 与 site-shared .btn-primary 同系视觉，尺寸仍用上方 .serial-btn 的 padding / font-size */
      .serial-btn.serial-btn--primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: linear-gradient(120deg, #111827, #000000);
        color: #ffffff;
        box-shadow: var(--shadow-btn-primary);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        transition:
          background 150ms ease-out,
          color 150ms ease-out,
          box-shadow 150ms ease-out,
          transform 150ms ease-out;
      }

      .serial-btn.serial-btn--primary:hover {
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: var(--shadow-btn-primary-hover);
        background: linear-gradient(120deg, #000000, #111827);
      }

      @media (prefers-color-scheme: dark) {
        .serial-btn.serial-btn--primary {
          background: linear-gradient(120deg, #f9fafb, #d1d5db);
          color: #111827;
        }

        .serial-btn.serial-btn--primary:hover {
          color: #111827;
          background: linear-gradient(120deg, #ffffff, #f3f4f6);
        }
      }

      .serial-field-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.45rem;
      }

      .serial-field-row input {
        font: inherit;
        font-size: 0.8rem;
        padding: 0.35rem 0.5rem;
        border-radius: 0.45rem;
        border: 1px solid var(--border-subtle);
        background: var(--bg-main);
        color: var(--text-main);
        min-width: 0;
        flex: 1 1 5rem;
      }

      .ctrl-field-line {
        align-items: center;
      }

      .ctrl-field-label {
        flex: 0 0 6.25rem;
        font-size: 0.74rem;
        font-weight: 500;
        color: var(--text-muted);
        line-height: 1.25;
      }

      .ctrl-field-line input {
        flex: 1 1 6rem;
        min-width: 3.5rem;
      }

      /* 模式一行、数值+发送一行（与上方按钮行拉开间距） */
      .ctrl-stack {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-top: 0.95rem;
        min-width: 0;
      }

      .ctrl-mode-row,
      .ctrl-value-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem 0.45rem;
        min-width: 0;
      }

      .ctrl-mode-row > label[for='ctrl-mode-trigger'] {
        font-size: 0.74rem;
        font-weight: 500;
        color: var(--text-muted);
        flex-shrink: 0;
      }

      .ctrl-mode-row .serial-dd {
        flex: 1 1 8rem;
        min-width: 0;
      }

      .ctrl-mode-row .serial-dd-trigger {
        width: 100%;
        min-width: 0;
      }

      .ctrl-value-row .ctrl-field-label {
        flex: 0 0 auto;
        white-space: nowrap;
      }

      .ctrl-value-row input {
        flex: 1 1 6rem;
        min-width: 0;
        font: inherit;
        font-size: 0.8rem;
        padding: 0.35rem 0.45rem;
        border-radius: 0.45rem;
        border: 1px solid var(--border-subtle);
        background: var(--bg-main);
        color: var(--text-main);
      }

      .ctrl-value-row .fw-version-dl {
        flex-shrink: 0;
      }

      .config-group {
        margin-top: 0.6rem;
      }

      .config-group:first-of-type {
        margin-top: 0.35rem;
      }

      .config-group-title {
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: 0.4rem;
      }

      /* 配置区：多格字段共用标签与输入样式 */
      .config-pid-cell-label {
        font-size: 0.72rem;
        font-weight: 500;
        line-height: 1.35;
        color: var(--text-muted);
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        word-break: break-word;
      }

      .config-batch-row {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 0.45rem 0.55rem;
        margin-bottom: 0.4rem;
      }

      .config-batch-row--fields-only {
        align-items: stretch;
      }

      /* 组内最后一行批量字段，底部间距交给下一 .config-group */
      .config-batch-row:last-child {
        margin-bottom: 0;
      }

      .config-pid-cells {
        display: flex;
        flex: 1 1 12rem;
        min-width: 0;
        gap: 0.45rem;
      }

      .config-pid-cell {
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      /* 与控制区 .ctrl-value-row input 同尺寸 */
      .config-pid-cell input {
        font: inherit;
        font-size: 0.8rem;
        padding: 0.35rem 0.45rem;
        border-radius: 0.45rem;
        border: 1px solid var(--border-subtle);
        background: var(--bg-main);
        color: var(--text-main);
        min-width: 0;
        width: 100%;
        box-sizing: border-box;
      }

      .device-info-panel {
        margin-top: 0.85rem;
        padding-top: 0.85rem;
        border-top: 1px solid var(--border-subtle);
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
      }

      .device-info-panel[hidden] {
        display: none !important;
      }

      .device-info-sheet {
        border-radius: 0.75rem;
        background: var(--accent-soft);
        padding: 0.7rem 0.75rem 0.75rem;
        border: 1px solid var(--border-subtle);
      }

      .device-info-sheet-h {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: var(--text-main);
        margin: 0 0 0.5rem;
        padding-bottom: 0.4rem;
        border-bottom: 1px solid var(--border-subtle);
      }

      /* 键 | 值 同行两列，避免 dt/dd 纵向堆叠 */
      .device-info-dl {
        margin: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
        column-gap: 0.55rem;
        row-gap: 0.28rem;
        font-size: 0.78rem;
        line-height: 1.35;
      }

      .device-info-dl dt {
        margin: 0;
        color: var(--text-muted);
        font-weight: 500;
        text-align: start;
        word-break: break-word;
        hyphens: auto;
      }

      .device-info-dl dd {
        margin: 0;
        color: var(--text-main);
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        word-break: break-word;
        text-align: start;
      }

      .device-info-dl--raw {
        grid-template-columns: minmax(0, 1fr);
      }

      .device-info-dl--raw > .device-info-pre,
      .device-info-dl--raw > .device-info-loading {
        grid-column: 1 / -1;
      }

      /* 与 .device-info-dl 正文一致；加载态不用等宽 pre */
      .device-info-loading {
        margin: 0;
        padding: 0.15rem 0.1rem 0.25rem;
        font: inherit;
        font-size: 0.78rem;
        line-height: 1.35;
        font-weight: 500;
        color: var(--text-muted);
      }

      .device-info-pre {
        margin: 0;
        padding: 0.5rem 0.55rem;
        border-radius: 0.5rem;
        background: var(--bg-elevated);
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.7rem;
        line-height: 1.45;
        color: var(--text-main);
        white-space: pre-wrap;
        word-break: break-word;
        border: 1px solid var(--border-subtle);
      }

      @media (max-width: 1100px) {
        .serial-layout {
          grid-template-columns: minmax(0, 1fr);
        }

        .serial-terminal-card--shell {
          min-height: 0;
        }

        .serial-terminal-card--shell .serial-terminal-wrap,
        .serial-terminal-wrap {
          min-height: 18rem;
        }

        .serial-terminal-card--shell #terminal,
        #terminal {
          min-height: 18rem;
        }
      }

      /* 储存 / 恢复默认 / 升级固件等：串口确认 y/n */
      .serial-confirm-dialog {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: rgba(0, 0, 0, 0);
        backdrop-filter: blur(0);
        pointer-events: none;
        visibility: hidden;
        transition: background 220ms ease-out, backdrop-filter 220ms ease-out, visibility 220ms ease-out;
      }

      .serial-confirm-dialog.open {
        background: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(4px);
        pointer-events: auto;
        visibility: visible;
      }

      .serial-confirm-dialog__box {
        width: 100%;
        max-width: 22rem;
        padding: 1.25rem 1.35rem;
        border-radius: 1rem;
        background: var(--bg-elevated);
        box-shadow: var(--shadow-dialog);
        border: 1px solid var(--border-subtle);
        opacity: 0;
        transform: translateY(12px) scale(0.98);
        transition: opacity 220ms ease-out, transform 220ms ease-out;
      }

      .serial-confirm-dialog.open .serial-confirm-dialog__box {
        opacity: 1;
        transform: translateY(0) scale(1);
      }

      .serial-confirm-dialog__title {
        margin: 0 0 0.5rem;
        font-size: 1rem;
        font-weight: 700;
        color: var(--text-main);
      }

      .serial-confirm-dialog__desc {
        margin: 0 0 1.15rem;
        font-size: 0.82rem;
        line-height: 1.5;
        color: var(--text-muted);
      }

      .serial-confirm-dialog__actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.5rem;
      }
    </style>
    <!-- xterm 由 JS 注入 DOM，Astro scoped 选不中 .xterm / .xterm-viewport，须用 global -->
    <style is:global>
      .serial-terminal-card--shell .serial-terminal-wrap {
        display: flex;
        flex-direction: column;
        background: #ffffff;
      }

      @media (prefers-color-scheme: dark) {
        .serial-terminal-card--shell .serial-terminal-wrap {
          background: #111111;
        }
      }

      .serial-terminal-card--shell #terminal {
        flex: 1 1 0;
        min-height: 0;
        width: 100%;
        position: relative;
      }

      .serial-terminal-card--shell #terminal .xterm {
        position: absolute;
        inset: 0;
      }

      .serial-terminal-card--shell #terminal .xterm-viewport {
        background-color: #ffffff !important;
      }

      @media (prefers-color-scheme: dark) {
        .serial-terminal-card--shell #terminal .xterm-viewport {
          background-color: #111111 !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="page" id="top">
      <main class="shell">
        <SiteHeader />

        <section class="serial-page-intro" data-reveal style="--d: 80ms">
          <div id="serial-no-api" class="serial-banner" hidden>
            当前浏览器不支持 Web Serial API。请使用桌面版 <strong>Chrome</strong> 或 <strong>Microsoft Edge</strong>（Chromium）
            打开本页；网页需通过 <strong>https://</strong> 或 <strong>localhost</strong> 访问。首次连接时浏览器会弹出系统级串口选择对话框（与具体 COM
            号对应关系由操作系统决定）。
          </div>
        </section>

        <section class="serial-layout" data-reveal style="--d: 180ms">
          <div class="serial-col-left" aria-label="连接与查询">
            <div class="serial-side-block">
              <div class="serial-toolbar">
                <label class="serial-toolbar-baud">
                  波特率
                  <div class="serial-dd serial-dd--inline" id="serial-baud-dd">
                    <input type="hidden" id="serial-baud" value="115200" />
                    <button
                      type="button"
                      class="serial-dd-trigger"
                      id="serial-baud-trigger"
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-label="选择串口波特率"
                    >
                      <span class="serial-dd-trigger-label">115200</span>
                      <svg class="serial-dd-chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path
                          d="M5 7.5L10 12.5L15 7.5"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </button>
                    <ul class="serial-dd-menu" id="serial-baud-menu" role="listbox" hidden>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="115200">115200</button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="921600">921600</button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="460800">460800</button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="230400">230400</button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="57600">57600</button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="38400">38400</button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="9600">9600</button>
                      </li>
                    </ul>
                  </div>
                </label>
                <button class="btn-primary" type="button" id="serial-connect">连接串口</button>
                <button class="fw-version-dl" type="button" id="serial-disconnect" disabled>断开</button>
                <span class="serial-status" id="serial-status" role="status">未连接。</span>
              </div>
            </div>
            <div class="serial-side-block">
              <div class="serial-btn-row">
                <button type="button" class="serial-btn serial-btn--primary" id="serial-read-device">
                  读取设备信息
                </button>
                <button type="button" class="fw-version-dl" data-serial-cmd="status">读取状态</button>
                <button type="button" class="fw-version-dl" data-serial-cmd="clear">清屏</button>
              </div>
              <div id="device-info-panel" class="device-info-panel" hidden>
                <div class="device-info-sheet">
                  <div class="device-info-sheet-h">版本与软件</div>
                  <dl id="device-info-version" class="device-info-dl"></dl>
                </div>
                <div class="device-info-sheet">
                  <div class="device-info-sheet-h">电机信息</div>
                  <dl id="device-info-motor" class="device-info-dl"></dl>
                </div>
              </div>
            </div>
          </div>

          <article class="panel serial-terminal-card serial-terminal-card--shell" aria-label="Shell 会话">
            <div class="serial-terminal-wrap">
              <div id="terminal" aria-label="串口终端输出"></div>
            </div>
          </article>

          <aside class="serial-col-right" aria-label="控制与配置">
            <div class="serial-side-block">
              <div class="serial-btn-row serial-drive-row">
                <button type="button" class="serial-btn serial-btn--primary" id="serial-cmd-enable" data-serial-cmd="enable">
                  使能
                </button>
                <button type="button" class="fw-version-dl" id="serial-cmd-disable" data-serial-cmd="disable">失能</button>
                <button type="button" class="fw-version-dl" data-serial-cmd="reboot">重启设备</button>
                <div
                  class="serial-drive-state"
                  id="serial-drive-state"
                  role="status"
                  aria-live="polite"
                  data-state="disconnected"
                >
                  <span class="serial-drive-state-dot" aria-hidden="true"></span>
                  <span class="serial-drive-state-text">未连接</span>
                </div>
              </div>
              <div class="ctrl-stack">
                <div class="ctrl-mode-row">
                  <label for="ctrl-mode-trigger">模式</label>
                  <div class="serial-dd serial-dd--inline" id="ctrl-mode-dd">
                    <input type="hidden" id="ctrl-mode" value="current" />
                    <button
                      type="button"
                      class="serial-dd-trigger serial-dd-trigger--block"
                      id="ctrl-mode-trigger"
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-label="选择控制模式"
                    >
                      <span class="serial-dd-trigger-label">电流模式</span>
                      <svg class="serial-dd-chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path
                          d="M5 7.5L10 12.5L15 7.5"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </button>
                    <ul class="serial-dd-menu" id="ctrl-mode-menu" role="listbox" hidden>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="current">
                          电流模式
                        </button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="speed">
                          速度模式
                        </button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="low_speed">
                          低速模式
                        </button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="angle">
                          角度模式
                        </button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="step_angle">
                          角度步进模式
                        </button>
                      </li>
                    </ul>
                  </div>
                </div>
                <div class="ctrl-value-row">
                  <label class="ctrl-field-label" for="gui-ctrl-value" id="ctrl-value-label">数值(A)</label>
                  <input
                    type="text"
                    id="gui-ctrl-value"
                    placeholder="如 0.1"
                    inputmode="decimal"
                    autocomplete="off"
                    spellcheck="false"
                  />
                  <button type="button" class="fw-version-dl" id="serial-ctrl-send">发送</button>
                </div>
              </div>
            </div>

            <div class="serial-side-block" id="serial-config-panel">
              <div class="serial-btn-row">
                <button type="button" class="serial-btn serial-btn--primary" id="serial-read-config">读取参数</button>
                <button type="button" class="fw-version-dl" id="serial-config-apply">设置</button>
                <button type="button" class="fw-version-dl" data-serial-cmd="store">储存</button>
                <button type="button" class="fw-version-dl" data-serial-cmd="restore">恢复默认</button>
              </div>

              <div class="config-group">
                <div class="config-group-title">速度环 PID</div>
                <div class="config-batch-row config-batch-row--fields-only">
                  <div class="config-pid-cells">
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-pid-speed-kp">kp</label>
                      <input
                        type="text"
                        id="cfg-pid-speed-kp"
                        data-config-key="pid.speed.kp"
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </div>
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-pid-speed-ki">ki</label>
                      <input
                        type="text"
                        id="cfg-pid-speed-ki"
                        data-config-key="pid.speed.ki"
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </div>
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-pid-speed-kd">kd</label>
                      <input
                        type="text"
                        id="cfg-pid-speed-kd"
                        data-config-key="pid.speed.kd"
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </div>
                  </div>
                </div>
              </div>

              <div class="config-group">
                <div class="config-group-title">角度环 PID</div>
                <div class="config-batch-row config-batch-row--fields-only">
                  <div class="config-pid-cells">
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-pid-angle-kp">kp</label>
                      <input
                        type="text"
                        id="cfg-pid-angle-kp"
                        data-config-key="pid.angle.kp"
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </div>
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-pid-angle-ki">ki</label>
                      <input
                        type="text"
                        id="cfg-pid-angle-ki"
                        data-config-key="pid.angle.ki"
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </div>
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-pid-angle-kd">kd</label>
                      <input
                        type="text"
                        id="cfg-pid-angle-kd"
                        data-config-key="pid.angle.kd"
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </div>
                  </div>
                </div>
              </div>

              <div class="config-group">
                <div class="config-group-title">限幅与通信</div>
                <div class="config-batch-row config-batch-row--fields-only">
                  <div class="config-pid-cells">
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-limit-current">limit.current(A)</label>
                      <input
                        type="text"
                        id="cfg-limit-current"
                        data-config-key="limit.current"
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </div>
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-limit-speed">limit.speed(rpm)</label>
                      <input
                        type="text"
                        id="cfg-limit-speed"
                        data-config-key="limit.speed"
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </div>
                  </div>
                </div>
                <div class="config-batch-row config-batch-row--fields-only">
                  <div class="config-pid-cells">
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-can-id">can.id</label>
                      <input type="text" id="cfg-can-id" data-config-key="can.id" autocomplete="off" spellcheck="false" />
                    </div>
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-uart-baud-rate">uart.baud_rate(bps)</label>
                      <input
                        type="text"
                        id="cfg-uart-baud-rate"
                        data-config-key="uart.baud_rate"
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="serial-side-block" aria-label="零点与校准">
              <div class="serial-btn-row">
                <button type="button" class="fw-version-dl" data-serial-cmd="set-zero-pos">设置零点</button>
                <button type="button" class="fw-version-dl" data-serial-cmd="calibrate">开始校准</button>
                <button type="button" class="fw-version-dl" data-serial-cmd="upgrade">升级固件</button>
              </div>
            </div>
          </aside>
        </section>
      </main>

      <SiteFooter revealDelay="260ms" />
    </div>

    <div
      id="serial-confirm-dialog"
      class="serial-confirm-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="serial-confirm-title"
      aria-describedby="serial-confirm-desc"
      aria-hidden="true"
    >
      <div class="serial-confirm-dialog__box">
        <h2 id="serial-confirm-title" class="serial-confirm-dialog__title"></h2>
        <p id="serial-confirm-desc" class="serial-confirm-dialog__desc"></p>
        <div class="serial-confirm-dialog__actions">
          <button type="button" class="fw-version-dl" id="serial-confirm-cancel">取消</button>
          <button type="button" class="serial-btn serial-btn--primary" id="serial-confirm-ok">确认</button>
        </div>
      </div>
    </div>

    <RevealScript />

    <script>
      import { bootMotorSerialShell } from '../../scripts/motor-serial-shell.ts';
      bootMotorSerialShell();
    </script>
  </body>
</html>
