---
import '../../../styles/site-shared.css';
import '../../../styles/serial-assistant.css';
import '../../../styles/assistant-tooltip.css';
import '../../../styles/web-host-controls.css';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteFavicon from '../../../components/SiteFavicon.astro';
import RevealScript from '../../../components/RevealScript.astro';

const title = 'QDrive Serial';
const description = '基于 Web Serial 的在线串口调试助手，支持文本与 HEX 收发、循环发送、快捷指令和日志导出。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - QDrive Tech</title>
    <meta name="description" content={description} />
    <SiteFavicon />
  </head>
  <body>
    <div class="page" id="top">
      <main class="shell">
        <SiteHeader />

        <header class="serial-tool-topbar" data-reveal style="--d: 40ms">
          <div class="serial-tool-topbar__heading">
            <h1 class="serial-tool-topbar__title">QDrive Serial</h1>
            <span class="serial-tool-topbar__subtitle">通用串口助手</span>
          </div>
          <a class="serial-tool-topbar__switch" href="/tools/web-host" aria-label="返回网页上位机工具列表">
            <svg class="serial-tool-topbar__switch-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 5.5 7.5 10.5l5 5"></path></svg>
            返回工具列表
          </a>
        </header>

        <div id="serial-no-api" class="serial-assistant-banner" hidden data-reveal style="--d: 70ms">
          当前浏览器不支持 Web Serial API。请使用桌面版 Chrome 或 Microsoft Edge，并通过 HTTPS 或 localhost 访问本页。
        </div>

        <section class="serial-assistant" data-reveal style="--d: 110ms" aria-label="通用串口助手">
          <aside class="serial-assistant-sidebar">
            <section class="serial-assistant-card" aria-labelledby="connection-title">
              <header class="serial-assistant-card__header">
                <div>
                  <h2 id="connection-title" class="serial-assistant-bilingual-title">
                    <span>连接设置</span><small>Connection</small>
                  </h2>
                </div>
                <span class="serial-assistant-state" id="serial-state" data-state="disconnected">
                  <span aria-hidden="true"></span><b>未连接</b>
                </span>
              </header>

              <div class="serial-assistant-fields">
                <label class="serial-assistant-field serial-assistant-field--wide">
                  <span>波特率</span>
                  <div class="serial-dd serial-dd--combobox serial-assistant-dd serial-assistant-combobox" id="serial-baud-dd">
                    <input id="serial-baud" type="text" value="115200" inputmode="numeric" autocomplete="off" spellcheck="false" aria-label="输入波特率" />
                    <button type="button" class="serial-dd-trigger serial-dd-trigger--embedded serial-assistant-inline-icon-button serial-assistant-combobox__toggle" aria-haspopup="listbox" aria-expanded="false" aria-label="选择预设波特率" data-tooltip-disabled>
                      <span class="serial-dd-trigger-label serial-assistant-visually-hidden">预设波特率</span>
                      <svg class="serial-dd-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5 10 12.5 15 7.5"></path></svg>
                    </button>
                    <ul class="serial-dd-menu" role="listbox" hidden>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="9600">9600</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="19200">19200</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="38400">38400</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="57600">57600</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="115200">115200</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="230400">230400</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="460800">460800</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="921600">921600</button></li>
                    </ul>
                  </div>
                </label>
                <label class="serial-assistant-field">
                  <span>数据位</span>
                  <div class="serial-dd serial-assistant-dd" id="serial-data-bits-dd">
                    <input id="serial-data-bits" type="hidden" value="8" />
                    <button type="button" class="serial-dd-trigger serial-dd-trigger--block" aria-haspopup="listbox" aria-expanded="false" aria-label="选择数据位" data-tooltip-disabled>
                      <span class="serial-dd-trigger-label">8</span>
                      <svg class="serial-dd-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5 10 12.5 15 7.5"></path></svg>
                    </button>
                    <ul class="serial-dd-menu" role="listbox" hidden>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="8">8</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="7">7</button></li>
                    </ul>
                  </div>
                </label>
                <label class="serial-assistant-field">
                  <span>停止位</span>
                  <div class="serial-dd serial-assistant-dd" id="serial-stop-bits-dd">
                    <input id="serial-stop-bits" type="hidden" value="1" />
                    <button type="button" class="serial-dd-trigger serial-dd-trigger--block" aria-haspopup="listbox" aria-expanded="false" aria-label="选择停止位" data-tooltip-disabled>
                      <span class="serial-dd-trigger-label">1</span>
                      <svg class="serial-dd-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5 10 12.5 15 7.5"></path></svg>
                    </button>
                    <ul class="serial-dd-menu" role="listbox" hidden>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="1">1</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="2">2</button></li>
                    </ul>
                  </div>
                </label>
                <label class="serial-assistant-field">
                  <span>校验位</span>
                  <div class="serial-dd serial-assistant-dd" id="serial-parity-dd">
                    <input id="serial-parity" type="hidden" value="none" />
                    <button type="button" class="serial-dd-trigger serial-dd-trigger--block" aria-haspopup="listbox" aria-expanded="false" aria-label="选择校验位" data-tooltip-disabled>
                      <span class="serial-dd-trigger-label">无校验</span>
                      <svg class="serial-dd-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5 10 12.5 15 7.5"></path></svg>
                    </button>
                    <ul class="serial-dd-menu" role="listbox" hidden>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="none">无校验</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="even">偶校验</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="odd">奇校验</button></li>
                    </ul>
                  </div>
                </label>
                <label class="serial-assistant-field">
                  <span>流控制</span>
                  <div class="serial-dd serial-assistant-dd" id="serial-flow-control-dd">
                    <input id="serial-flow-control" type="hidden" value="none" />
                    <button type="button" class="serial-dd-trigger serial-dd-trigger--block" aria-haspopup="listbox" aria-expanded="false" aria-label="选择流控制" data-tooltip-disabled>
                      <span class="serial-dd-trigger-label">无</span>
                      <svg class="serial-dd-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5 10 12.5 15 7.5"></path></svg>
                    </button>
                    <ul class="serial-dd-menu" role="listbox" hidden>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="none">无</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="hardware">硬件</button></li>
                    </ul>
                  </div>
                </label>
              </div>

              <div class="serial-assistant-signal-grid" aria-label="线路信号">
                <label><input id="serial-dtr" type="checkbox" disabled /><span>DTR</span></label>
                <label><input id="serial-rts" type="checkbox" disabled /><span>RTS</span></label>
                <div data-signal="cts"><i></i><span>CTS</span></div>
                <div data-signal="dsr"><i></i><span>DSR</span></div>
                <div data-signal="dcd"><i></i><span>DCD</span></div>
                <div data-signal="ri"><i></i><span>RI</span></div>
              </div>

              <div class="serial-assistant-connect-row">
                <button class="serial-assistant-primary" id="serial-connect" type="button">选择并连接</button>
                <button class="serial-assistant-secondary" id="serial-disconnect" type="button" disabled>断开</button>
              </div>
              <p class="serial-assistant-status" id="serial-status" role="status" aria-live="polite">等待连接设备。</p>
            </section>

            <section class="serial-assistant-card" aria-labelledby="quick-title">
              <header class="serial-assistant-card__header">
                <div>
                  <h2 id="quick-title" class="serial-assistant-bilingual-title">
                    <span>快捷发送</span><small>Presets</small>
                  </h2>
                </div>
                <button type="button" class="serial-assistant-secondary serial-assistant-option-toggle serial-assistant-option-toggle--icon serial-assistant-utility-icon-button" id="serial-quick-add" aria-label="添加快捷指令" data-tooltip="添加快捷指令" data-always-active="true">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4.5v11M4.5 10h11"></path></svg>
                </button>
              </header>
              <div class="serial-assistant-quick-list" id="serial-quick-list">
                {['AT', 'status', 'help'].map((value, index) => (
                  <div class="serial-assistant-quick-row">
                    <button type="button" class="serial-assistant-secondary serial-assistant-mode-toggle serial-assistant-quick-mode" data-mode="text" aria-label={`快捷指令 ${index + 1}：Abc，点击切换为 Hex`} data-tooltip="Abc，点击切换为 Hex">
                      <span>A</span>
                    </button>
                    <div class="serial-assistant-quick-input-wrap">
                      <input type="text" value={value} placeholder="输入文本" aria-label={`快捷指令 ${index + 1}`} spellcheck="false" />
                      <button type="button" class="serial-assistant-quick-delete" aria-label={`删除快捷指令 ${index + 1}`} data-tooltip="删除快捷指令">
                        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 6h10M8 4h4M6.5 6l.7 10h5.6l.7-10"></path></svg>
                      </button>
                    </div>
                    <button type="button" class="serial-assistant-secondary serial-assistant-option-toggle serial-assistant-quick-send" aria-label={`发送快捷指令 ${index + 1}`} data-tooltip="发送快捷指令" data-always-active="true">发送</button>
                  </div>
                ))}
                <p class="serial-assistant-quick-empty" id="serial-quick-empty" hidden>暂无快捷指令</p>
              </div>
            </section>
          </aside>

          <div class="serial-assistant-workspace">
            <section class="serial-assistant-monitor" aria-labelledby="monitor-title">
              <header class="serial-assistant-monitor__toolbar">
                <div class="serial-assistant-monitor__title">
                  <h2 id="monitor-title" class="serial-assistant-bilingual-title">
                    <span>数据监视器</span><small>Monitor</small>
                  </h2>
                </div>
                <div class="serial-assistant-options">
                  <button type="button" class="serial-assistant-secondary serial-assistant-mode-toggle" id="serial-display-mode-toggle" aria-label="接收显示格式：Abc，点击切换为 Hex" data-tooltip="接收显示格式：Abc，点击切换为 Hex">
                    <span>Abc</span>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 6.5h11m0 0-2.5-2.5M15 6.5 12.5 9M16 13.5H5m0 0L7.5 11M5 13.5 7.5 16"></path></svg>
                  </button>
                  <button type="button" class="serial-assistant-secondary serial-assistant-option-toggle serial-assistant-option-toggle--icon" id="serial-timestamp" aria-pressed="true" aria-label="显示时间戳" data-tooltip="显示时间戳">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="6"></circle><path d="M10 7v3.5l2 1"></path></svg>
                  </button>
                  <button type="button" class="serial-assistant-secondary serial-assistant-option-toggle" id="serial-local-echo" aria-pressed="true" aria-label="显示发送数据" data-tooltip="显示发送数据">TX</button>
                  <button type="button" class="serial-assistant-secondary serial-assistant-option-toggle" id="serial-show-receive" aria-pressed="true" aria-label="显示接收数据" data-tooltip="显示接收数据">RX</button>
                </div>
                <div class="serial-assistant-toolbar-actions">
                  <button type="button" class="serial-assistant-secondary serial-assistant-option-toggle serial-assistant-option-toggle--icon serial-assistant-utility-icon-button" id="serial-export" aria-label="导出 CSV 日志" data-tooltip="导出 CSV 日志" data-always-active="true" disabled>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v9M6.5 8.5 10 12l3.5-3.5M4 15.5h12"></path></svg>
                  </button>
                  <button type="button" class="serial-assistant-secondary serial-assistant-option-toggle serial-assistant-option-toggle--icon serial-assistant-utility-icon-button" id="serial-clear" aria-label="清空日志" data-tooltip="清空日志" data-always-active="true">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 6h10M8 4h4M6.5 6l.7 10h5.6l.7-10"></path></svg>
                  </button>
                </div>
              </header>

              <div class="serial-assistant-log" id="serial-log" role="log" aria-live="polite" aria-label="串口收发日志">
                <div class="serial-assistant-empty" id="serial-empty">
                  <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M7 9h18v14H7zM11 13h10M11 17h6M4 13v6M28 13v6"></path></svg>
                  <strong>尚无串口数据</strong>
                  <span>连接设备后，接收和发送的数据会显示在这里</span>
                </div>
              </div>

              <div class="serial-assistant-composer-resizer" id="serial-composer-resizer" role="separator" aria-label="调整发送输入框高度" aria-orientation="horizontal" aria-valuemin="32" aria-valuemax="160" aria-valuenow="32" tabindex="0">
                <span aria-hidden="true"></span>
              </div>

              <form class="serial-assistant-composer" id="serial-send-form" novalidate>
                <div class="serial-assistant-send-input-wrap">
                  <div class="serial-assistant-send-tools">
                    <button type="button" class="serial-assistant-secondary serial-assistant-mode-toggle" id="serial-send-mode-toggle" aria-label="发送数据格式：Abc，点击切换为 Hex" data-tooltip="发送数据格式：Abc，点击切换为 Hex">
                      <span>Abc</span>
                      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 6.5h11m0 0-2.5-2.5M15 6.5 12.5 9M16 13.5H5m0 0L7.5 11M5 13.5 7.5 16"></path></svg>
                    </button>
                    <input id="serial-file-input" type="file" hidden />
                    <button type="button" class="serial-assistant-secondary serial-assistant-option-toggle serial-assistant-option-toggle--icon serial-assistant-utility-icon-button serial-assistant-file-send" id="serial-file-send" aria-label="发送文件" data-tooltip="发送文件" data-always-active="true" disabled>
                      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 14V4M6.5 7.5 10 4l3.5 3.5M4 15.5h12"></path></svg>
                    </button>
                  </div>
                  <div class="serial-assistant-send-input-field">
                    <textarea id="serial-send-input" rows="1" placeholder="输入要发送的文本；Ctrl / ⌘ + Enter 发送" spellcheck="false"></textarea>
                    <button class="serial-assistant-inline-icon-button serial-assistant-input-clear" id="serial-send-input-clear" type="button" aria-label="清空发送内容" data-tooltip="清空发送内容" disabled>
                      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 6 8 8M14 6l-8 8"></path></svg>
                    </button>
                  </div>
                  <div class="serial-assistant-send-actions">
                    <label class="serial-assistant-send-suffix">
                      <div class="serial-dd serial-assistant-dd serial-assistant-dd--line-ending" id="serial-line-ending-dd">
                      <input id="serial-line-ending" type="hidden" value="lf" />
                      <button type="button" class="serial-dd-trigger serial-dd-trigger--block" aria-haspopup="listbox" aria-expanded="false" aria-label="选择发送行尾">
                        <span class="serial-dd-trigger-label">LF</span>
                        <svg class="serial-dd-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5 10 12.5 15 7.5"></path></svg>
                      </button>
                      <ul class="serial-dd-menu serial-dd-menu--up" role="listbox" hidden>
                        <li><button type="button" class="serial-dd-item" role="option" data-value="none">无追加</button></li>
                        <li><button type="button" class="serial-dd-item" role="option" data-value="cr">CR</button></li>
                        <li><button type="button" class="serial-dd-item" role="option" data-value="lf">LF</button></li>
                        <li><button type="button" class="serial-dd-item" role="option" data-value="crlf">CRLF</button></li>
                      </ul>
                      </div>
                      <div class="serial-dd serial-assistant-dd serial-assistant-dd--line-ending" id="serial-checksum-dd" hidden>
                      <input id="serial-checksum" type="hidden" value="none" />
                      <button type="button" class="serial-dd-trigger serial-dd-trigger--block" aria-haspopup="listbox" aria-expanded="false" aria-label="选择 HEX 校验方式">
                        <span class="serial-dd-trigger-label" aria-live="polite">无校验</span>
                        <svg class="serial-dd-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5 10 12.5 15 7.5"></path></svg>
                      </button>
                      <ul class="serial-dd-menu serial-dd-menu--up" role="listbox" hidden>
                        <li><button type="button" class="serial-dd-item" role="option" data-value="none">无校验</button></li>
                        <li><button type="button" class="serial-dd-item" role="option" data-value="sum">校验和</button></li>
                        <li><button type="button" class="serial-dd-item" role="option" data-value="parity">奇偶校验</button></li>
                        <li><button type="button" class="serial-dd-item" role="option" data-value="xor">异或校验</button></li>
                        <li><button type="button" class="serial-dd-item" role="option" data-value="crc8-atm">CRC-8/ATM</button></li>
                      </ul>
                      </div>
                    </label>
                    <div class="serial-dd serial-assistant-send-control" id="serial-send-control">
                    <div class="serial-assistant-send-split">
                      <button class="serial-assistant-primary serial-assistant-send-main" id="serial-send" type="submit" data-tooltip="" disabled>
                        <span id="serial-send-label">发 送</span>
                      </button>
                      <button class="serial-assistant-primary serial-assistant-send-toggle" id="serial-send-toggle" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="serial-send-menu" aria-label="设置发送方式">
                        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5 10 12.5 15 7.5"></path></svg>
                      </button>
                    </div>
                    <div class="serial-dd-menu serial-dd-menu--up serial-assistant-send-menu" id="serial-send-menu" role="dialog" aria-label="发送设置" hidden>
                      <input id="serial-cycle-enabled" type="checkbox" hidden />
                      <button type="button" class="serial-assistant-secondary serial-assistant-send-method" id="serial-send-method" aria-pressed="false">
                        <svg class="serial-assistant-send-method__cycle" viewBox="0 0 20 20" aria-hidden="true"><path d="M15.5 7A6 6 0 0 0 5 5.5L3.5 7M4.5 13A6 6 0 0 0 15 14.5l1.5-1.5M3.5 3.5v3.6h3.6M16.5 16.5v-3.6h-3.6"></path></svg>
                        <span>循环发送</span>
                      </button>
                      <div class="serial-assistant-cycle-settings">
                        <label class="serial-assistant-field" for="serial-cycle-interval">
                          <span>发送间隔（ms）</span>
                          <input id="serial-cycle-interval" type="number" min="10" max="86400000" step="any" value="1000" inputmode="numeric" data-tooltip="" />
                        </label>
                        <label class="serial-assistant-field" for="serial-cycle-count">
                          <span>发送次数</span>
                          <input id="serial-cycle-count" type="number" step="any" value="100" inputmode="numeric" data-tooltip="-1 表示无限发送" />
                        </label>
                      </div>
                    </div>
                  </div>
                </div>
                </div>
              </form>
            </section>
          </div>
        </section>
      </main>

      <SiteFooter revealDelay="180ms" />
    </div>

    <RevealScript />
    <script>
      import { bootSerialAssistant } from '../../../scripts/serial-assistant.ts';
      bootSerialAssistant();
    </script>
  </body>
</html>
