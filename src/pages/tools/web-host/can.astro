---
import '../../../styles/site-shared.css';
import '../../../styles/web-host-controls.css';
import '../../../styles/serial-assistant.css';
import '../../../styles/assistant-tooltip.css';
import '../../../styles/can-tool.css';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteFavicon from '../../../components/SiteFavicon.astro';
import RevealScript from '../../../components/RevealScript.astro';

const title = 'QDrive CAN';
const description = '基于 WebUSB 和 gs_usb 协议的在线 USB 转 CAN 调试工具，支持经典 CAN 帧收发、循环发送、过滤和日志导出。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - QDrive Tech</title>
    <meta name="description" content={description} />
    <SiteFavicon />
  </head>
  <body>
    <div class="page" id="top">
      <main class="shell">
        <SiteHeader />

        <header class="serial-tool-topbar" data-reveal style="--d: 40ms">
          <div class="serial-tool-topbar__heading">
            <h1 class="serial-tool-topbar__title">QDrive CAN</h1>
            <span class="serial-tool-topbar__subtitle">USB 转 CAN</span>
          </div>
          <a class="serial-tool-topbar__switch" href="/tools/web-host" aria-label="返回网页上位机工具列表">
            <svg class="serial-tool-topbar__switch-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 5.5 7.5 10.5l5 5"></path></svg>
            返回工具列表
          </a>
        </header>

        <div id="can-no-api" class="can-banner" hidden data-reveal style="--d: 70ms">
          当前浏览器不支持 WebUSB API。请使用桌面版 Chrome 或 Microsoft Edge，并通过 HTTPS 或 localhost 访问本页。
        </div>

        <section class="can-tool" data-reveal style="--d: 110ms" aria-label="USB 转 CAN 上位机">
          <aside class="can-sidebar">
            <section class="can-card" aria-labelledby="can-connection-title">
              <header class="can-card__header">
                <h2 id="can-connection-title" class="can-title"><span>连接设置</span><small>Connection</small></h2>
                <span class="can-state" id="can-state" data-state="disconnected"><i aria-hidden="true"></i><b>未连接</b></span>
              </header>

              <div class="can-fields">
                <label class="can-field can-field--wide">
                  <span>CAN 波特率</span>
                  <div class="serial-dd serial-assistant-dd can-dd" id="can-bitrate-dd">
                    <input id="can-bitrate" type="hidden" value="1000000" />
                    <button type="button" class="serial-dd-trigger serial-dd-trigger--block" aria-haspopup="listbox" aria-expanded="false" aria-label="选择 CAN 波特率" data-tooltip-disabled>
                      <span class="serial-dd-trigger-label">1 Mbps</span>
                      <svg class="serial-dd-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5 10 12.5 15 7.5"></path></svg>
                    </button>
                    <ul class="serial-dd-menu" role="listbox" hidden>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="1000000">1 Mbps</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="800000">800 kbps</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="500000">500 kbps</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="250000">250 kbps</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="125000">125 kbps</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="100000">100 kbps</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="50000">50 kbps</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="20000">20 kbps</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="10000">10 kbps</button></li>
                    </ul>
                  </div>
                </label>
                <label class="can-field">
                  <span>通道</span>
                  <div class="serial-dd serial-assistant-dd can-dd" id="can-channel-dd">
                    <input id="can-channel" type="hidden" value="0" />
                    <button type="button" class="serial-dd-trigger serial-dd-trigger--block" aria-haspopup="listbox" aria-expanded="false" aria-label="选择 CAN 通道" data-tooltip-disabled disabled>
                      <span class="serial-dd-trigger-label">CAN 0</span>
                      <svg class="serial-dd-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5 10 12.5 15 7.5"></path></svg>
                    </button>
                    <ul class="serial-dd-menu" role="listbox" hidden>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="0">CAN 0</button></li>
                    </ul>
                  </div>
                </label>
                <label class="can-field">
                  <span>工作模式</span>
                  <div class="serial-dd serial-assistant-dd can-dd" id="can-mode-dd">
                    <input id="can-mode" type="hidden" value="normal" />
                    <button type="button" class="serial-dd-trigger serial-dd-trigger--block" aria-haspopup="listbox" aria-expanded="false" aria-label="选择工作模式" data-tooltip-disabled>
                      <span class="serial-dd-trigger-label">正常</span>
                      <svg class="serial-dd-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5 10 12.5 15 7.5"></path></svg>
                    </button>
                    <ul class="serial-dd-menu" role="listbox" hidden>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="normal">正常</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="listen">仅监听</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="loopback">回环</button></li>
                    </ul>
                  </div>
                </label>
              </div>

              <label class="can-check-row">
                <input id="can-termination" type="checkbox" disabled />
                <span><b>120 Ω 终端电阻</b><small id="can-termination-note">连接后检测设备支持情况</small></span>
              </label>

              <div class="can-connect-row">
                <button class="can-primary" id="can-connect" type="button">选择并连接</button>
                <button class="can-secondary" id="can-disconnect" type="button" disabled>断开</button>
              </div>
              <p class="can-status" id="can-status" role="status" aria-live="polite">连接设备后将自动启动 CAN 通道。</p>

            </section>

            <section class="can-card" aria-labelledby="can-stats-title">
              <header class="can-card__header">
                <h2 id="can-stats-title" class="can-title"><span>总线统计</span><small>Statistics</small></h2>
              </header>
              <div class="can-stats">
                <div><strong id="can-rx-count">0</strong><span>RX 帧</span></div>
                <div><strong id="can-tx-count">0</strong><span>TX 帧</span></div>
                <div><strong id="can-rx-bytes">0</strong><span>RX 字节</span></div>
                <div><strong id="can-error-count">0</strong><span>错误帧</span></div>
              </div>
              <p class="can-card__hint">CAN 数据仅在当前浏览器中处理，不会上传到服务器。Windows 设备接口需使用 WinUSB 驱动。</p>
            </section>
          </aside>

          <section class="can-monitor" aria-labelledby="can-monitor-title">
            <header class="can-monitor__toolbar">
              <h2 id="can-monitor-title" class="can-title"><span>CAN 帧监视器</span><small>Frame Monitor</small></h2>
              <div class="can-filter-group">
                <label class="can-search can-search--id">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="4.5"></circle><path d="m12 12 4 4"></path></svg>
                  <input id="can-filter-id" type="search" placeholder="搜索 ID" aria-label="搜索 ID" spellcheck="false" autocomplete="off" autocapitalize="characters" />
                  <button class="serial-assistant-inline-icon-button serial-assistant-input-clear" id="can-filter-id-clear" type="button" aria-label="清空 ID 搜索" data-tooltip="清空 ID 搜索" disabled>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 6 8 8M14 6l-8 8"></path></svg>
                  </button>
                </label>
                <label class="can-search can-search--data">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="4.5"></circle><path d="m12 12 4 4"></path></svg>
                  <input id="can-filter-data" type="search" placeholder="搜索数据（HEX）" aria-label="搜索 CAN 数据" spellcheck="false" autocomplete="off" autocapitalize="characters" />
                  <button class="serial-assistant-inline-icon-button serial-assistant-input-clear" id="can-filter-data-clear" type="button" aria-label="清空 CAN 数据搜索" data-tooltip="清空 CAN 数据搜索" disabled>
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 6 8 8M14 6l-8 8"></path></svg>
                  </button>
                </label>
                <div class="serial-dd serial-assistant-dd can-dd can-direction-dd" id="can-direction-dd">
                  <input id="can-direction-filter" type="hidden" value="all" />
                  <button type="button" class="serial-dd-trigger serial-dd-trigger--block" aria-haspopup="listbox" aria-expanded="false" aria-label="筛选收发方向">
                    <span class="serial-dd-trigger-label">全部</span>
                    <svg class="serial-dd-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5 10 12.5 15 7.5"></path></svg>
                  </button>
                  <ul class="serial-dd-menu" role="listbox" hidden>
                    <li><button type="button" class="serial-dd-item" role="option" data-value="all">全部</button></li>
                    <li><button type="button" class="serial-dd-item" role="option" data-value="rx">仅 RX</button></li>
                    <li><button type="button" class="serial-dd-item" role="option" data-value="tx">仅 TX</button></li>
                  </ul>
                </div>
                <div class="serial-dd serial-assistant-dd can-dd can-frame-type-dd" id="can-frame-type-dd">
                  <input id="can-frame-type-filter" type="hidden" value="standard,extended,rtr,error" />
                  <button type="button" class="serial-dd-trigger serial-dd-trigger--block" aria-haspopup="dialog" aria-expanded="false" aria-controls="can-frame-type-menu" aria-label="筛选帧类型">
                    <span class="serial-dd-trigger-label">筛选帧类型</span>
                    <svg class="serial-dd-chevron" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5 10 12.5 15 7.5"></path></svg>
                  </button>
                  <div class="serial-dd-menu can-frame-type-menu" id="can-frame-type-menu" role="dialog" aria-label="帧类型筛选" hidden>
                    <label class="serial-dd-item can-frame-type-item"><input type="checkbox" value="standard" checked /><span>标准帧</span></label>
                    <label class="serial-dd-item can-frame-type-item"><input type="checkbox" value="extended" checked /><span>扩展帧</span></label>
                    <label class="serial-dd-item can-frame-type-item"><input type="checkbox" value="rtr" checked /><span>远程帧</span></label>
                    <label class="serial-dd-item can-frame-type-item"><input type="checkbox" value="error" checked /><span>错误帧</span></label>
                  </div>
                </div>
              </div>
              <div class="serial-assistant-toolbar-actions can-toolbar-actions">
                <button type="button" class="serial-assistant-secondary serial-assistant-option-toggle can-error-display-toggle" id="can-error-display" aria-pressed="true" aria-label="错误帧显示解析信息" data-tooltip="切换错误帧显示方式">解析</button>
                <button type="button" class="serial-assistant-secondary serial-assistant-option-toggle serial-assistant-option-toggle--icon serial-assistant-utility-icon-button" id="can-export" aria-label="导出 CSV 日志" title="导出 CSV 日志" data-always-active="true" disabled>
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v9M6.5 8.5 10 12l3.5-3.5M4 15.5h12"></path></svg>
                </button>
                <button type="button" class="serial-assistant-secondary serial-assistant-option-toggle serial-assistant-option-toggle--icon serial-assistant-utility-icon-button" id="can-clear" aria-label="清空日志" title="清空日志" data-always-active="true">
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 6h10M8 4h4M6.5 6l.7 10h5.6l.7-10"></path></svg>
                </button>
              </div>
            </header>

            <div class="can-table-wrap" id="can-table-wrap">
              <div class="can-table can-table--header" aria-hidden="true">
                <span>时间</span><span>方向</span><span>CAN ID</span><span>帧类型</span><span>DLC</span><span>数据（HEX）</span>
              </div>
              <div class="can-log" id="can-log" role="log" aria-live="off"></div>
              <div class="can-empty" id="can-empty">
                <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M9 16h30v18H9zM15 11v5m18-5v5M14 25h6m8 0h6M5 22h4m30 0h4M5 29h4m30 0h4"></path></svg>
                <strong>等待 CAN 帧</strong>
                <span>连接 gs_usb 设备后，接收与发送记录会显示在这里</span>
              </div>
            </div>

            <form class="can-composer" id="can-send-form">
              <div class="can-compose-fields">
                <label class="can-field can-id-field"><span>CAN ID（HEX）</span><input id="can-send-id" type="text" value="123" maxlength="8" placeholder="000–7FF" spellcheck="false" autocomplete="off" autocapitalize="characters" /></label>
                <label class="can-field can-data-field"><span>数据（HEX）</span><input id="can-send-data" type="text" value="11 22 33 44" placeholder="例如 AA 01 0D 0A" spellcheck="false" autocomplete="off" autocapitalize="characters" /></label>
                <label class="can-field can-dlc-field">
                  <span>DLC</span>
                  <input id="can-dlc" type="number" min="0" max="8" step="1" value="4" placeholder="0-8" inputmode="numeric" aria-label="DLC，输入 0 到 8" />
                </label>
              </div>
              <div class="can-compose-actions">
                <div class="can-frame-options">
                  <label><input id="can-extended" type="checkbox" />扩展帧</label>
                  <label><input id="can-rtr" type="checkbox" />远程帧</label>
                  <p class="can-send-status" id="can-send-status" role="status" aria-live="polite"></p>
                </div>
                <div class="serial-dd serial-assistant-send-control can-send-control" id="can-send-control">
                  <div class="serial-assistant-send-split">
                    <button class="serial-assistant-primary serial-assistant-send-main" id="can-send" type="submit" disabled>
                      <span id="can-send-label">发送帧</span>
                    </button>
                    <button class="serial-assistant-primary serial-assistant-send-toggle" id="can-send-toggle" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="can-send-menu" aria-label="设置发送方式" disabled>
                      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 7.5 10 12.5 15 7.5"></path></svg>
                    </button>
                  </div>
                  <div class="serial-dd-menu serial-dd-menu--up serial-assistant-send-menu" id="can-send-menu" role="dialog" aria-label="发送设置" hidden>
                    <input id="can-cycle-enabled" type="checkbox" hidden />
                    <button type="button" class="serial-assistant-secondary serial-assistant-send-method" id="can-send-method" aria-pressed="false">
                      <svg class="serial-assistant-send-method__cycle" viewBox="0 0 20 20" aria-hidden="true"><path d="M15.5 7A6 6 0 0 0 5 5.5L3.5 7M4.5 13A6 6 0 0 0 15 14.5l1.5-1.5M3.5 3.5v3.6h3.6M16.5 16.5v-3.6h-3.6"></path></svg>
                      <span>循环发送</span>
                    </button>
                    <div class="serial-assistant-cycle-settings">
                      <label class="serial-assistant-field" for="can-cycle-interval">
                        <span>发送间隔（ms）</span>
                        <input id="can-cycle-interval" type="number" min="10" max="86400000" step="any" value="1000" inputmode="numeric" />
                      </label>
                      <label class="serial-assistant-field" for="can-cycle-count">
                        <span>发送次数</span>
                        <input id="can-cycle-count" type="number" step="any" value="100" inputmode="numeric" title="-1 表示无限发送" />
                      </label>
                    </div>
                  </div>
                </div>
              </div>
            </form>
          </section>
        </section>
      </main>

      <SiteFooter revealDelay="180ms" />
    </div>

    <RevealScript />
    <script>
      import { bootCanTool } from '../../../scripts/can-tool.ts';
      bootCanTool();
    </script>
  </body>
</html>
