---
import '../../../styles/site-shared.css';
import '../../../styles/serial-tool.css';
import '../../../styles/motor-waveform.css';
import '../../../styles/dfu-update.css';
import '../../../styles/web-host-controls.css';
import '@xterm/xterm/css/xterm.css';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteFavicon from '../../../components/SiteFavicon.astro';
import RevealScript from '../../../components/RevealScript.astro';

const title = 'QDrive Motor';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - QDrive Tech</title>
    <meta
      name="description"
      content="QDrive Motor：通过浏览器 Web Serial 连接设备，进行串口终端与参数调参。"
    />
    <SiteFavicon />
    <!-- xterm 由 JS 注入 DOM，Astro scoped 选不中 .xterm / .xterm-viewport，须用 global -->
    <style is:global>
      .serial-terminal-card--shell .serial-terminal-wrap {
        display: flex;
        flex-direction: column;
        background: #ffffff;
      }

      @media (prefers-color-scheme: dark) {
        .serial-terminal-card--shell .serial-terminal-wrap {
          background: #111111;
        }
      }

      .serial-terminal-card--shell #terminal {
        flex: 1 1 0;
        min-height: 0;
        width: 100%;
        position: relative;
      }

      .serial-terminal-card--shell #terminal .xterm {
        position: absolute;
        inset: 0;
      }

      .serial-terminal-card--shell #terminal .xterm-viewport {
        background-color: #ffffff !important;
      }

      @media (prefers-color-scheme: dark) {
        .serial-terminal-card--shell #terminal .xterm-viewport {
          background-color: #111111 !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="page" id="top">
      <main class="shell">
        <SiteHeader />

        <header class="serial-tool-topbar" data-reveal style="--d: 40ms">
          <div class="serial-tool-topbar__heading">
            <h1 class="serial-tool-topbar__title">QDrive Motor</h1>
            <span class="serial-tool-topbar__subtitle">无刷电机上位机</span>
          </div>
          <a
            class="serial-tool-topbar__switch"
            href="/tools/web-host"
            aria-label="返回网页上位机工具列表"
          >
            <svg class="serial-tool-topbar__switch-icon" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M12.5 5.5L7.5 10.5l5 5"></path>
            </svg>
            返回工具列表
          </a>
        </header>

        <section class="serial-page-intro" data-reveal style="--d: 80ms">
          <div id="serial-no-api" class="serial-banner" hidden>
            当前浏览器不支持 Web Serial API。请使用桌面版 <strong>Chrome</strong> 或 <strong>Microsoft Edge</strong>（Chromium）
            打开本页；网页需通过 <strong>https://</strong> 或 <strong>localhost</strong> 访问。首次连接时浏览器会弹出系统级串口选择对话框（与具体 COM
            号对应关系由操作系统决定）。
          </div>
        </section>

        <section class="serial-layout" data-reveal style="--d: 180ms">
          <div class="serial-col-left" aria-label="连接与查询">
            <div class="serial-side-block">
              <div class="serial-toolbar">
                <label class="serial-toolbar-baud">
                  波特率
                  <div class="serial-dd serial-dd--inline" id="serial-baud-dd">
                    <input type="hidden" id="serial-baud" value="115200" />
                    <button
                      type="button"
                      class="serial-dd-trigger"
                      id="serial-baud-trigger"
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-label="选择串口波特率"
                    >
                      <span class="serial-dd-trigger-label">115200</span>
                      <svg class="serial-dd-chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path
                          d="M5 7.5L10 12.5L15 7.5"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </button>
                    <ul class="serial-dd-menu" id="serial-baud-menu" role="listbox" hidden>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="115200">115200</button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="921600">921600</button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="460800">460800</button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="230400">230400</button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="57600">57600</button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="38400">38400</button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="9600">9600</button>
                      </li>
                    </ul>
                  </div>
                </label>
                <button class="pill-action" type="button" id="serial-connect">连接设备</button>
                <button class="pill-action" type="button" id="serial-disconnect" disabled>断开</button>
                <button type="button" class="pill-action" data-serial-cmd="reboot">重启设备</button>
                <span class="serial-status" id="serial-status" role="status">未连接。</span>
              </div>
            </div>
            <div class="serial-side-block serial-side-block--device-summary">
              <div class="serial-btn-row serial-btn-row--fill">
                <button type="button" class="serial-btn" id="serial-read-device">
                  读取设备信息
                </button>
                <button type="button" class="pill-action" data-serial-cmd="status">读取状态</button>
                <button type="button" class="pill-action" data-serial-cmd="clear">清屏</button>
              </div>
              <div id="device-info-panel" class="device-info-panel" hidden>
                <div class="device-info-sheet">
                  <div class="device-info-sheet-h">版本与软件</div>
                  <dl id="device-info-version" class="device-info-dl"></dl>
                </div>
                <div class="device-info-sheet">
                  <div class="device-info-sheet-h">电机信息</div>
                  <dl id="device-info-motor" class="device-info-dl"></dl>
                </div>
              </div>
            </div>
          </div>

          <div class="serial-workspace serial-workspace--motor">
            <div class="serial-workspace-tabs" role="tablist" aria-label="中间工作区">
              <button class="serial-workspace-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="terminal-panel" id="terminal-tab" data-serial-workspace="terminal">终端</button>
              <button class="serial-workspace-tab" type="button" role="tab" aria-selected="false" aria-controls="motor-waveform-panel" id="motor-waveform-tab" data-serial-workspace="waveform">波形</button>
            </div>
            <article class="panel serial-terminal-card serial-terminal-card--shell" aria-label="串口终端与波形">
            <div class="serial-terminal-wrap" id="terminal-panel" role="tabpanel" aria-labelledby="terminal-tab">
              <div id="terminal" aria-label="串口终端输出"></div>
            </div>
            <section class="motor-waveform" id="motor-waveform-panel" role="tabpanel" aria-labelledby="motor-waveform-tab" hidden>
              <div class="motor-waveform-toolbar">
                <button class="serial-btn" type="button" id="motor-waveform-toggle" aria-pressed="false">开始绘制</button>
                <button class="pill-action" type="button" id="motor-waveform-export" disabled>导出 CSV</button>
                <label class="motor-waveform-frequency" for="motor-waveform-frequency">
                  频率
                  <div class="serial-dd serial-dd--inline" id="motor-waveform-frequency-dd">
                    <input id="motor-waveform-frequency" type="hidden" value="30" />
                    <button type="button" class="serial-dd-trigger" aria-haspopup="listbox" aria-expanded="false" aria-label="选择采样频率">
                      <span class="serial-dd-trigger-label">30 Hz</span>
                      <svg class="serial-dd-chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </button>
                    <ul class="serial-dd-menu" role="listbox" hidden>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="30">30 Hz</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="60">60 Hz</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="90">90 Hz</button></li>
                      <li><button type="button" class="serial-dd-item" role="option" data-value="120">120 Hz</button></li>
                    </ul>
                  </div>
                </label>
                <span class="serial-drive-state motor-waveform-state" id="motor-waveform-state" role="status" data-state="off">
                  <span class="serial-drive-state-dot" aria-hidden="true"></span>
                  <span class="serial-drive-state-text">未开始</span>
                </span>
              </div>
              <p class="motor-waveform-hint">Shift + 滚轮缩放纵轴，Ctrl + 滚轮缩放横轴，滚轮或拖拽平移图像。<br />单击设置0s，双击自适应缩放。</p>
              <div class="motor-waveform-charts">
                <section class="motor-waveform-chart" aria-label="电流波形">
                  <header class="motor-waveform-chart__header"><span>电流 <small>A</small></span><strong data-motor-value="current">--</strong></header>
                  <canvas data-motor-waveform="current"></canvas>
                </section>
                <section class="motor-waveform-chart" aria-label="速度波形">
                  <header class="motor-waveform-chart__header"><span>速度 <small>rpm</small></span><strong data-motor-value="speed">--</strong></header>
                  <canvas data-motor-waveform="speed"></canvas>
                </section>
                <section class="motor-waveform-chart" aria-label="角度波形">
                  <header class="motor-waveform-chart__header"><span>角度 <small>rad</small></span><strong data-motor-value="angle">--</strong></header>
                  <canvas data-motor-waveform="angle"></canvas>
                </section>
              </div>
            </section>
            </article>
          </div>

          <aside class="serial-col-right" aria-label="控制与配置">
            <div class="serial-side-block">
              <div class="serial-btn-row serial-drive-row">
                <button type="button" class="serial-btn" id="serial-cmd-enable" data-serial-cmd="enable">
                  使能
                </button>
                <button type="button" class="pill-action" id="serial-cmd-disable" data-serial-cmd="disable">失能</button>
                <div
                  class="serial-drive-state"
                  id="serial-drive-state"
                  role="status"
                  aria-live="polite"
                  data-state="disconnected"
                >
                  <span class="serial-drive-state-dot" aria-hidden="true"></span>
                  <span class="serial-drive-state-text">未连接</span>
                </div>
              </div>
              <div class="ctrl-stack">
                <div class="ctrl-mode-row">
                  <label for="ctrl-mode-trigger">模式</label>
                  <div class="serial-dd serial-dd--inline" id="ctrl-mode-dd">
                    <input type="hidden" id="ctrl-mode" value="current" />
                    <button
                      type="button"
                      class="serial-dd-trigger serial-dd-trigger--block"
                      id="ctrl-mode-trigger"
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-label="选择控制模式"
                    >
                      <span class="serial-dd-trigger-label">电流模式</span>
                      <svg class="serial-dd-chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path
                          d="M5 7.5L10 12.5L15 7.5"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </button>
                    <ul class="serial-dd-menu" id="ctrl-mode-menu" role="listbox" hidden>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="current">
                          电流模式
                        </button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="speed">
                          速度模式
                        </button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="low_speed">
                          低速模式
                        </button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="angle">
                          角度模式
                        </button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="step_angle">
                          角度步进模式
                        </button>
                      </li>
                    </ul>
                  </div>
                  <button type="button" class="pill-action" id="serial-ctrl-send">发送</button>
                </div>
                <div class="ctrl-value-row">
                  <label class="ctrl-field-label" for="gui-ctrl-value" id="ctrl-value-label">数值(A)</label>
                  <input
                    type="text"
                    id="gui-ctrl-value"
                    placeholder="如 0.1"
                    inputmode="decimal"
                    autocomplete="off"
                    spellcheck="false"
                  />
                </div>
              </div>
            </div>

            <div class="serial-side-block" id="serial-config-panel">
              <div class="serial-btn-row serial-btn-row--fill">
                <button type="button" class="serial-btn" id="serial-read-config">读取参数</button>
                <button type="button" class="pill-action" id="serial-config-apply">设置</button>
                <button type="button" class="pill-action" data-serial-cmd="store">储存</button>
                <button type="button" class="pill-action" data-serial-cmd="restore">恢复默认</button>
              </div>

              <div class="config-group">
                <div class="config-group-title">速度环 PID</div>
                <div class="config-batch-row config-batch-row--fields-only">
                  <div class="config-pid-cells">
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-pid-speed-kp">kp</label>
                      <input
                        type="text"
                        id="cfg-pid-speed-kp"
                        data-config-key="pid.speed.kp"
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </div>
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-pid-speed-ki">ki</label>
                      <input
                        type="text"
                        id="cfg-pid-speed-ki"
                        data-config-key="pid.speed.ki"
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </div>
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-pid-speed-kd">kd</label>
                      <input
                        type="text"
                        id="cfg-pid-speed-kd"
                        data-config-key="pid.speed.kd"
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </div>
                  </div>
                </div>
              </div>

              <div class="config-group">
                <div class="config-group-title">角度环 PID</div>
                <div class="config-batch-row config-batch-row--fields-only">
                  <div class="config-pid-cells">
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-pid-angle-kp">kp</label>
                      <input
                        type="text"
                        id="cfg-pid-angle-kp"
                        data-config-key="pid.angle.kp"
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </div>
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-pid-angle-ki">ki</label>
                      <input
                        type="text"
                        id="cfg-pid-angle-ki"
                        data-config-key="pid.angle.ki"
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </div>
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-pid-angle-kd">kd</label>
                      <input
                        type="text"
                        id="cfg-pid-angle-kd"
                        data-config-key="pid.angle.kd"
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </div>
                  </div>
                </div>
              </div>

              <div class="config-group">
                <div class="config-group-title">限幅与通信</div>
                <div class="config-batch-row config-batch-row--fields-only">
                  <div class="config-pid-cells">
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-limit-current">limit.current(A)</label>
                      <input
                        type="text"
                        id="cfg-limit-current"
                        data-config-key="limit.current"
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </div>
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-limit-speed">limit.speed(rpm)</label>
                      <input
                        type="text"
                        id="cfg-limit-speed"
                        data-config-key="limit.speed"
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </div>
                  </div>
                </div>
                <div class="config-batch-row config-batch-row--fields-only">
                  <div class="config-pid-cells config-pid-cells--communication">
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-can-id">can.id</label>
                      <input type="text" id="cfg-can-id" data-config-key="can.id" autocomplete="off" spellcheck="false" />
                    </div>
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-timeout">timeout(s)</label>
                      <input type="text" id="cfg-timeout" data-config-key="timeout" autocomplete="off" spellcheck="false" />
                    </div>
                    <div class="config-pid-cell">
                      <label class="config-pid-cell-label" for="cfg-uart-baud-rate">uart.baud_rate(bps)</label>
                      <input
                        type="text"
                        id="cfg-uart-baud-rate"
                        data-config-key="uart.baud_rate"
                        autocomplete="off"
                        spellcheck="false"
                      />
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="serial-side-block" aria-label="零点与校准">
              <div class="serial-btn-row serial-btn-row--equal">
                <button type="button" class="pill-action" data-serial-cmd="set-zero-pos">设置零点</button>
                <button type="button" class="pill-action" data-serial-cmd="calibrate">开始校准</button>
                <button type="button" class="pill-action" data-serial-cmd="upgrade">升级固件</button>
              </div>
            </div>
          </aside>
        </section>
      </main>

      <SiteFooter revealDelay="260ms" />
    </div>

    <div
      id="serial-confirm-dialog"
      class="serial-confirm-dialog scrollable-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="serial-confirm-title"
      aria-describedby="serial-confirm-desc"
      aria-hidden="true"
    >
      <div class="serial-confirm-dialog__box">
        <h2 id="serial-confirm-title" class="serial-confirm-dialog__title"></h2>
        <p id="serial-confirm-desc" class="serial-confirm-dialog__desc"></p>
        <div class="serial-confirm-dialog__actions">
          <button type="button" class="pill-action" id="serial-confirm-cancel">取消</button>
          <button type="button" class="serial-btn" id="serial-confirm-ok">确认</button>
        </div>
      </div>
    </div>

    <div
      id="dfu-update-dialog"
      class="resource-dialog scrollable-dialog dfu-update-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="dfu-update-title"
      aria-describedby="dfu-status"
      aria-hidden="true"
    >
      <div class="resource-dialog-box dfu-update-dialog__box">
        <div class="resource-dialog-header dfu-update-dialog__heading">
          <div>
            <div id="dfu-update-title" class="resource-dialog-title dfu-update-dialog__title">选择固件和 DFU 设备</div>
            <p class="dfu-update-dialog__hint">请确保设备进入固件升级模式（红绿灯交替闪烁）<br />如未进入，请先返回上级，连接设备进入升级模式</p>
          </div>
          <button type="button" class="resource-dialog-close dfu-update-dialog__close" id="dfu-close" aria-label="关闭升级窗口">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M7 7l10 10M17 7L7 17" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" />
            </svg>
          </button>
        </div>
        <ol class="resource-list dfu-update-steps">
          <li class="resource-item">
            <div class="resource-info">
              <span class="resource-title dfu-update-steps__label">1. 固件文件</span>
              <span id="dfu-file-name" class="resource-meta dfu-update-steps__value">尚未选择 .dfu 文件</span>
            </div>
            <button type="button" class="pill-action" id="dfu-file-select">选择文件</button>
            <input id="dfu-file-input" type="file" accept=".dfu" hidden />
          </li>
          <li class="resource-item">
            <div class="resource-info">
              <span class="resource-title dfu-update-steps__label">2. DFU 设备</span>
              <span id="dfu-device-name" class="resource-meta dfu-update-steps__value">请先让电机进入 DFU 模式</span>
            </div>
            <button type="button" class="pill-action" id="dfu-device-select">选择设备</button>
          </li>
        </ol>
        <div class="dfu-update-progress-wrap">
          <div class="dfu-update-progress-label"><span>升级进度</span><span id="dfu-progress-text">0%</span></div>
          <progress id="dfu-progress" class="dfu-update-progress" max="100" value="0">0%</progress>
        </div>
        <p id="dfu-status" class="dfu-update-dialog__status" aria-live="polite">
          先选择 .dfu 文件，再选择已进入 DFU 模式的设备。
        </p>
        <div class="dfu-update-dialog__actions">
          <button type="button" class="pill-action" id="dfu-cancel">取消</button>
          <button type="button" class="serial-btn" id="dfu-start" disabled>开始升级</button>
        </div>
      </div>
    </div>

    <RevealScript />

    <script>
      import { bootMotorSerialShell } from '../../../scripts/motor-serial-shell.ts';
      bootMotorSerialShell();

      const workspaceTabs = document.querySelectorAll<HTMLButtonElement>('[data-serial-workspace]');
      const terminalPanel = document.getElementById('terminal-panel');
      const waveformPanel = document.getElementById('motor-waveform-panel');
      workspaceTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const waveform = tab.dataset.serialWorkspace === 'waveform';
          terminalPanel?.toggleAttribute('hidden', waveform);
          waveformPanel?.toggleAttribute('hidden', !waveform);
          workspaceTabs.forEach((item) => {
            const selected = item === tab;
            item.classList.toggle('is-active', selected);
            item.setAttribute('aria-selected', String(selected));
          });
        });
      });
    </script>
  </body>
</html>
