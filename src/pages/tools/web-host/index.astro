---
import '../../../styles/site-shared.css';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteFavicon from '../../../components/SiteFavicon.astro';
import RevealScript from '../../../components/RevealScript.astro';

const title = '网页上位机';
const description = '在浏览器中使用串口助手，或打开 QDrive 产品专用调参界面。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - QDrive Tech</title>
    <meta name="description" content={description} />
    <SiteFavicon />
    <style>
      .web-host-intro {
        margin-top: 0.45rem;
        margin-right: auto;
        margin-left: 0;
        text-align: left;
      }

      .web-host-intro .hero-subtitle {
        margin-left: 0;
        margin-right: 0;
        margin-bottom: 0;
      }

      .web-host-intro + .sections--web-host {
        margin-top: 1.35rem;
      }

      /* 工具目录：稳定的两列扫描节奏，避免 auto-fit 在中间宽度形成“三加一”。 */
      .sections--web-host {
        --web-host-list-line: color-mix(in srgb, var(--text-main) 10%, transparent);
        width: 100%;
        min-width: 0;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 clamp(2.5rem, 6vw, 6rem);
        max-width: 76rem;
        margin-right: auto;
        margin-left: 0;
      }

      .sections--web-host a.panel {
        --web-host-hover-inset: .65rem;
        position: relative;
        min-height: 10rem;
        padding: clamp(1.4rem, 2.5vw, 2rem) .5rem clamp(1.75rem, 3vw, 2.5rem);
        overflow: hidden;
        border: 0;
        border-top: 1px solid var(--web-host-list-line);
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        transition: opacity 180ms ease-out;
      }

      .sections--web-host a.panel:hover {
        border-color: var(--web-host-list-line);
        background: transparent;
        transform: none;
      }

      .sections--web-host a.panel:active {
        background: color-mix(in srgb, var(--text-main) 4.5%, transparent);
      }

      .sections--web-host a.panel:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
      }

      .sections--web-host a.panel .panel-header {
        display: grid;
        grid-template-columns: 2.25rem minmax(0, 1fr) auto;
        gap: .75rem;
        align-items: start;
        margin-bottom: 1.35rem;
      }

      .sections--web-host a.panel .panel-header > :is(.web-host-card-index, div),
      .sections--web-host a.panel .web-host-card-tags {
        transition: transform 220ms cubic-bezier(.2, .8, .2, 1);
      }

      .sections--web-host a.panel:hover .panel-header > :is(.web-host-card-index, div),
      .sections--web-host a.panel:hover .web-host-card-tags {
        transform: translateX(var(--web-host-hover-inset));
      }

      /* 产品名 eyebrow：不用全站 panel-eyebrow 的大写 */
      .sections--web-host a.panel .panel-eyebrow {
        text-transform: none;
        letter-spacing: .035em;
      }

      .sections--web-host a.panel .panel-title {
        margin-top: .18rem;
        font-size: clamp(1.08rem, 1.5vw, 1.3rem);
        font-weight: 470;
        line-height: 1.2;
        letter-spacing: -.015em;
      }

      .web-host-card-index {
        padding-top: .08rem;
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: var(--type-scale-label);
        font-variant-numeric: tabular-nums;
        letter-spacing: .08em;
      }

      .web-host-card-arrow {
        color: var(--text-muted);
        font-size: 1rem;
        line-height: 1;
        transition: color 140ms ease-out, transform 160ms cubic-bezier(.2, .8, .2, 1);
      }

      .sections--web-host a.panel:hover .web-host-card-arrow {
        color: var(--text-main);
        transform: translateX(calc(-1 * var(--web-host-hover-inset)));
      }

      .web-host-card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: .3rem .55rem;
        margin: 0 0 0 3rem;
        padding: 0;
        list-style: none;
      }

      .web-host-card-tags li {
        display: inline-flex;
        align-items: center;
        font-size: var(--type-scale-label);
        line-height: 1.5;
        color: var(--text-muted);
        padding: 0;
        border-radius: 0;
        background: transparent;
      }

      .web-host-card-tags li + li::before {
        margin-right: .55rem;
        color: color-mix(in srgb, var(--text-main) 28%, transparent);
        content: '·';
      }

      @media (max-width: 680px) {
        .sections--web-host { grid-template-columns: minmax(0, 1fr); }
        .sections--web-host a.panel { min-height: 0; }
      }

      @media (prefers-reduced-motion: reduce) {
        .sections--web-host a.panel,
        .sections--web-host a.panel .panel-header > :is(.web-host-card-index, div),
        .sections--web-host a.panel .web-host-card-tags,
        .web-host-card-arrow { transition: none; }
      }
    </style>
  </head>
  <body>
    <div class="page" id="top">
      <main class="shell">
        <SiteHeader />

        <header class="web-host-intro" data-reveal style="--d: 60ms">
          <h1 class="section-title">网页上位机</h1>
          <p class="hero-subtitle">选择通用工具或对应产品上位机</p>
        </header>

        <section class="sections sections--web-host" data-reveal style="--d: 100ms">
          <a
            href="/tools/web-host/motor"
            class="panel"
            aria-label="打开 QDrive Motor 无刷电机上位机"
          >
            <header class="panel-header">
              <span class="web-host-card-index" aria-hidden="true">01</span>
              <div>
                <div class="panel-eyebrow">无刷电机</div>
                <div class="panel-title">QDrive Motor</div>
              </div>
              <span class="web-host-card-arrow" aria-hidden="true">↗</span>
            </header>
            <ul class="web-host-card-tags" aria-label="支持能力">
              <li>串口终端</li>
              <li>参数读写</li>
              <li>调试校准</li>
              <li>浏览器直连</li>
            </ul>
          </a>
          <a
            href="/tools/web-host/gimbal"
            class="panel"
            aria-label="打开 QDrive Gimbal 云台上位机"
          >
            <header class="panel-header">
              <span class="web-host-card-index" aria-hidden="true">02</span>
              <div>
                <div class="panel-eyebrow">云台</div>
                <div class="panel-title">QDrive Gimbal</div>
              </div>
              <span class="web-host-card-arrow" aria-hidden="true">↗</span>
            </header>
            <ul class="web-host-card-tags" aria-label="支持能力">
              <li>串口终端</li>
              <li>参数读写</li>
              <li>调试校准</li>
              <li>浏览器直连</li>
            </ul>
          </a>
          <a
            href="/tools/web-host/serial"
            class="panel"
            aria-label="打开 QDrive Serial 串口助手"
          >
            <header class="panel-header">
              <span class="web-host-card-index" aria-hidden="true">03</span>
              <div>
                <div class="panel-eyebrow">串口助手</div>
                <div class="panel-title">QDrive Serial</div>
              </div>
              <span class="web-host-card-arrow" aria-hidden="true">↗</span>
            </header>
            <ul class="web-host-card-tags" aria-label="支持能力">
              <li>文本 / HEX</li>
              <li>循环发送</li>
              <li>快捷指令</li>
              <li>日志导出</li>
            </ul>
          </a>
          <a
            href="/tools/web-host/can"
            class="panel"
            aria-label="打开 QDrive CAN USB 转 CAN 上位机"
          >
            <header class="panel-header">
              <span class="web-host-card-index" aria-hidden="true">04</span>
              <div>
                <div class="panel-eyebrow">USB 转 CAN</div>
                <div class="panel-title">QDrive CAN</div>
              </div>
              <span class="web-host-card-arrow" aria-hidden="true">↗</span>
            </header>
            <ul class="web-host-card-tags" aria-label="支持能力">
              <li>gs_usb</li>
              <li>标准 / 扩展帧</li>
              <li>循环发送</li>
              <li>日志导出</li>
            </ul>
          </a>
        </section>
      </main>

      <SiteFooter revealDelay="200ms" />
    </div>

    <RevealScript />
  </body>
</html>
