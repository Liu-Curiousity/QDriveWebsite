---
import '../../../styles/site-shared.css';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteFavicon from '../../../components/SiteFavicon.astro';
import RevealScript from '../../../components/RevealScript.astro';

const title = '网页上位机';
const description = '选择设备类型后，在浏览器中打开对应调参界面。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - QDrive Tech</title>
    <meta name="description" content={description} />
    <SiteFavicon />
    <style>
      .web-host-intro {
        margin-top: 0.45rem;
        text-align: center;
      }

      .web-host-intro .hero-subtitle {
        margin-left: auto;
        margin-right: auto;
        margin-bottom: 0;
      }

      .web-host-intro + .sections--web-host {
        margin-top: 1.35rem;
      }

      /* 1～2 张卡片：窄屏单列居中，宽屏双列 */
      .sections--web-host {
        grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
        max-width: 46rem;
        margin-inline: auto;
      }

      .sections--web-host a.panel .panel-header {
        margin-bottom: 0.45rem;
      }

      /* 产品名 eyebrow：不用全站 panel-eyebrow 的大写 */
      .sections--web-host a.panel .panel-eyebrow {
        text-transform: none;
        letter-spacing: 0.04em;
      }

      .web-host-card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .web-host-card-tags li {
        font-size: 0.72rem;
        line-height: 1.3;
        color: var(--text-muted);
        padding: 0.2rem 0.45rem;
        border-radius: 0.45rem;
        background: var(--accent-soft);
      }
    </style>
  </head>
  <body>
    <div class="page" id="top">
      <main class="shell">
        <SiteHeader />

        <header class="web-host-intro" data-reveal style="--d: 60ms">
          <h1 class="section-title">网页上位机</h1>
          <p class="hero-subtitle">请选择对应产品品类</p>
        </header>

        <section class="sections sections--web-host" data-reveal style="--d: 100ms">
          <a
            href="/tools/web-host/motor"
            class="panel"
            aria-label="打开 QDrive Motor 无刷电机上位机"
          >
            <header class="panel-header">
              <div>
                <div class="panel-eyebrow">无刷电机</div>
                <div class="panel-title">QDrive Motor</div>
              </div>
            </header>
            <ul class="web-host-card-tags" aria-label="支持能力">
              <li>串口终端</li>
              <li>参数读写</li>
              <li>调试校准</li>
              <li>浏览器直连</li>
            </ul>
          </a>
          <a
            href="/tools/web-host/gimbal"
            class="panel"
            aria-label="打开 QDrive Gimbal 云台上位机"
          >
            <header class="panel-header">
              <div>
                <div class="panel-eyebrow">云台</div>
                <div class="panel-title">QDrive Gimbal</div>
              </div>
            </header>
            <ul class="web-host-card-tags" aria-label="支持能力">
              <li>串口终端</li>
              <li>参数读写</li>
              <li>调试校准</li>
              <li>浏览器直连</li>
            </ul>
          </a>
        </section>
      </main>

      <SiteFooter revealDelay="200ms" />
    </div>

    <RevealScript />
  </body>
</html>
