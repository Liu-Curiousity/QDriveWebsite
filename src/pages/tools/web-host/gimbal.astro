---
import '../../../styles/site-shared.css';
import '../../../styles/serial-tool.css';
import '../../../styles/web-host-controls.css';
import '@xterm/xterm/css/xterm.css';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteFavicon from '../../../components/SiteFavicon.astro';
import RevealScript from '../../../components/RevealScript.astro';

const title = 'QDrive Gimbal';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - QDrive Tech</title>
    <meta
      name="description"
      content="QDrive Gimbal：通过浏览器 Web Serial 连接云台设备，进行串口终端与参数调参。"
    />
    <SiteFavicon />
    <style>
      .serial-gimbal-actions {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 0.35rem;
      }

      .serial-gimbal-actions__body {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: flex-start;
        gap: 0.65rem 0.85rem;
        min-width: 0;
      }

      .serial-gimbal-actions__left {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        flex: 0 1 auto;
        min-width: 0;
      }

      .serial-gimbal-actions__left .serial-btn-row {
        margin: 0;
      }

      .serial-drive-states--gimbal {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        gap: 0.08rem;
        flex: 0 0 auto;
        min-width: 0;
        width: auto;
        margin-left: 1.2rem;
      }

      .serial-drive-states--gimbal .serial-drive-state {
        margin-left: 0;
        width: auto;
        max-width: 100%;
        justify-content: flex-start;
        min-height: 1.35rem;
      }

      /* 云台：同一行「数值(…)」标签 + Yaw / Pitch 两框 */
      .ctrl-value-row--gimbal-dual {
        align-items: center;
      }

      .ctrl-value-row--gimbal-dual input {
        flex: 1 1 4.25rem;
        min-width: 3.25rem;
        max-width: 9.5rem;
      }

      .gimbal-config-axis-panel[hidden] {
        display: none !important;
      }
    </style>
    <!-- xterm 由 JS 注入 DOM，Astro scoped 选不中 .xterm / .xterm-viewport，须用 global -->
    <style is:global>
      .serial-terminal-card--shell .serial-terminal-wrap {
        display: flex;
        flex-direction: column;
        background: #ffffff;
      }

      @media (prefers-color-scheme: dark) {
        .serial-terminal-card--shell .serial-terminal-wrap {
          background: #111111;
        }
      }

      .serial-terminal-card--shell #terminal {
        flex: 1 1 0;
        min-height: 0;
        width: 100%;
        position: relative;
      }

      .serial-terminal-card--shell #terminal .xterm {
        position: absolute;
        inset: 0;
      }

      .serial-terminal-card--shell #terminal .xterm-viewport {
        background-color: #ffffff !important;
      }

      @media (prefers-color-scheme: dark) {
        .serial-terminal-card--shell #terminal .xterm-viewport {
          background-color: #111111 !important;
        }
      }
    </style>
  </head>
  <body>
    <div class="page" id="top">
      <main class="shell">
        <SiteHeader />

        <header class="serial-tool-topbar" data-reveal style="--d: 40ms">
          <div class="serial-tool-topbar__heading">
            <h1 class="serial-tool-topbar__title">QDrive Gimbal</h1>
            <span class="serial-tool-topbar__subtitle">云台上位机</span>
          </div>
          <a
            class="serial-tool-topbar__switch"
            href="/tools/web-host"
            aria-label="返回网页上位机工具列表"
          >
            <svg class="serial-tool-topbar__switch-icon" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M12.5 5.5L7.5 10.5l5 5"></path>
            </svg>
            返回工具列表
          </a>
        </header>

        <section class="serial-page-intro" data-reveal style="--d: 80ms">
          <div id="serial-no-api" class="serial-banner" hidden>
            当前浏览器不支持 Web Serial API。请使用桌面版 <strong>Chrome</strong> 或 <strong>Microsoft Edge</strong>（Chromium）
            打开本页；网页需通过 <strong>https://</strong> 或 <strong>localhost</strong> 访问。首次连接时浏览器会弹出系统级串口选择对话框（与具体 COM
            号对应关系由操作系统决定）。
          </div>
        </section>

        <section class="serial-layout" data-reveal style="--d: 180ms">
          <div class="serial-col-left" aria-label="连接与查询">
            <div class="serial-side-block">
              <div class="serial-toolbar">
                <label class="serial-toolbar-baud">
                  波特率
                  <div class="serial-dd serial-dd--inline" id="serial-baud-dd">
                    <input type="hidden" id="serial-baud" value="115200" />
                    <button
                      type="button"
                      class="serial-dd-trigger"
                      id="serial-baud-trigger"
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-label="选择串口波特率"
                    >
                      <span class="serial-dd-trigger-label">115200</span>
                      <svg class="serial-dd-chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path
                          d="M5 7.5L10 12.5L15 7.5"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </button>
                    <ul class="serial-dd-menu" id="serial-baud-menu" role="listbox" hidden>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="115200">115200</button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="921600">921600</button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="460800">460800</button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="230400">230400</button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="57600">57600</button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="38400">38400</button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="9600">9600</button>
                      </li>
                    </ul>
                  </div>
                </label>
                <button class="pill-action" type="button" id="serial-connect">连接设备</button>
                <button class="pill-action" type="button" id="serial-disconnect" disabled>断开</button>
                <button type="button" class="pill-action" data-serial-cmd="reboot">重启设备</button>
                <span class="serial-status" id="serial-status" role="status">未连接。</span>
              </div>
            </div>
            <div class="serial-side-block">
              <div class="serial-btn-row">
                <button type="button" class="serial-btn" id="serial-read-device">
                  读取设备信息
                </button>
                <button type="button" class="pill-action" data-serial-cmd="status">读取状态</button>
                <button type="button" class="pill-action" data-serial-cmd="clear">清屏</button>
              </div>
              <div id="device-info-panel" class="device-info-panel" hidden>
                <div class="device-info-sheet">
                  <div class="device-info-sheet-h">版本与软件</div>
                  <dl id="device-info-version" class="device-info-dl"></dl>
                </div>
                <div class="device-info-sheet">
                  <div class="device-info-sheet-h">云台信息</div>
                  <dl id="device-info-gimbal" class="device-info-dl"></dl>
                </div>
              </div>
            </div>
          </div>

          <article class="panel serial-terminal-card serial-terminal-card--shell" aria-label="Shell 会话">
            <div class="serial-terminal-wrap">
              <div id="terminal" aria-label="串口终端输出"></div>
            </div>
          </article>

          <aside class="serial-col-right" aria-label="控制与配置">
            <div class="serial-side-block">
              <div class="serial-gimbal-actions">
                <div class="serial-btn-row serial-gimbal-actions__row1">
                  <button type="button" class="serial-btn" id="serial-cmd-enable" data-serial-cmd="enable">
                    使能
                  </button>
                  <button type="button" class="pill-action" id="serial-cmd-disable" data-serial-cmd="disable">失能</button>
                  <button type="button" class="pill-action" data-serial-cmd="reset-imu">复位IMU</button>
                  <button type="button" class="pill-action" data-serial-cmd="set-zero-pos">设置零点</button>
                </div>
                <div class="serial-gimbal-actions__body">
                  <div class="serial-gimbal-actions__left">
                    <div class="serial-btn-row">
                      <button type="button" class="serial-btn" id="serial-cmd-enable-stability">开启自稳</button>
                      <button type="button" class="pill-action" id="serial-cmd-disable-stability">关闭自稳</button>
                    </div>
                    <div class="serial-btn-row">
                      <button type="button" class="serial-btn" id="serial-cmd-enable-laser">打开激光</button>
                      <button type="button" class="pill-action" id="serial-cmd-disable-laser">关闭激光</button>
                    </div>
                  </div>
                  <div class="serial-drive-states serial-drive-states--gimbal" role="group" aria-label="云台状态">
                    <div
                      class="serial-drive-state"
                      id="serial-drive-state-enable"
                      role="status"
                      aria-live="polite"
                      data-state="disconnected"
                    >
                      <span class="serial-drive-state-dot" aria-hidden="true"></span>
                      <span class="serial-drive-state-text">未连接</span>
                    </div>
                    <div
                      class="serial-drive-state"
                      id="serial-drive-state-stability"
                      role="status"
                      aria-live="polite"
                      data-state="disconnected"
                    >
                      <span class="serial-drive-state-dot" aria-hidden="true"></span>
                      <span class="serial-drive-state-text">未连接</span>
                    </div>
                    <div
                      class="serial-drive-state"
                      id="serial-drive-state-laser"
                      role="status"
                      aria-live="polite"
                      data-state="disconnected"
                    >
                      <span class="serial-drive-state-dot" aria-hidden="true"></span>
                      <span class="serial-drive-state-text">未连接</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="ctrl-stack">
                <div class="ctrl-mode-row">
                  <label for="ctrl-mode-trigger">模式</label>
                  <div class="serial-dd serial-dd--inline" id="ctrl-mode-dd">
                    <input type="hidden" id="ctrl-mode" value="speed" />
                    <button
                      type="button"
                      class="serial-dd-trigger serial-dd-trigger--block"
                      id="ctrl-mode-trigger"
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-label="选择控制模式"
                    >
                      <span class="serial-dd-trigger-label">速度模式</span>
                      <svg class="serial-dd-chevron" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                        <path
                          d="M5 7.5L10 12.5L15 7.5"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </button>
                    <ul class="serial-dd-menu" id="ctrl-mode-menu" role="listbox" hidden>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="current">
                          电流模式
                        </button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="speed">
                          速度模式
                        </button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="low_speed">
                          低速模式
                        </button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="angle">
                          角度模式
                        </button>
                      </li>
                      <li>
                        <button type="button" class="serial-dd-item" role="option" data-value="step_angle">
                          角度步进模式
                        </button>
                      </li>
                    </ul>
                  </div>
                  <button type="button" class="pill-action" id="serial-ctrl-send">发送</button>
                </div>
                <div class="ctrl-value-row ctrl-value-row--gimbal-dual">
                  <label class="ctrl-field-label" for="gui-ctrl-value-yaw" id="ctrl-value-label">数值(rpm)</label>
                  <input
                    type="text"
                    id="gui-ctrl-value-yaw"
                    placeholder="Yaw轴"
                    inputmode="decimal"
                    autocomplete="off"
                    spellcheck="false"
                  />
                  <input
                    type="text"
                    id="gui-ctrl-value-pitch"
                    placeholder="Pitch轴"
                    inputmode="decimal"
                    autocomplete="off"
                    spellcheck="false"
                  />
                </div>
              </div>
            </div>

            <div class="serial-side-block" id="serial-config-panel">
              <div class="serial-btn-row">
                <button type="button" class="serial-btn" id="serial-read-config">读取参数</button>
                <button type="button" class="pill-action" id="serial-config-apply">设置</button>
                <button type="button" class="pill-action" data-serial-cmd="store">储存</button>
                <button type="button" class="pill-action" data-serial-cmd="restore">恢复默认</button>
              </div>

              <div class="web-host-segmented-tabs gimbal-axis-switch" role="tablist" aria-label="选择要调节的轴">
                <button
                  type="button"
                  class="web-host-segmented-tab gimbal-axis-switch__btn is-active"
                  id="gimbal-axis-tab-yaw"
                  data-axis="yaw"
                  role="tab"
                  aria-selected="true"
                  aria-controls="gimbal-config-yaw"
                >
                  Yaw
                </button>
                <button
                  type="button"
                  class="web-host-segmented-tab gimbal-axis-switch__btn"
                  id="gimbal-axis-tab-pitch"
                  data-axis="pitch"
                  role="tab"
                  aria-selected="false"
                  aria-controls="gimbal-config-pitch"
                >
                  Pitch
                </button>
              </div>

              <div id="gimbal-config-yaw" class="gimbal-config-axis-panel" role="tabpanel" aria-labelledby="gimbal-axis-tab-yaw">
                <div class="config-group">
                  <div class="config-group-title">速度环 PID</div>
                  <div class="config-batch-row config-batch-row--fields-only">
                    <div class="config-pid-cells">
                      <div class="config-pid-cell">
                        <label class="config-pid-cell-label" for="cfg-pid-speed-kp-yaw">kp</label>
                        <input
                          type="text"
                          id="cfg-pid-speed-kp-yaw"
                          data-config-key="pid.speed.kp.yaw"
                          autocomplete="off"
                          spellcheck="false"
                        />
                      </div>
                      <div class="config-pid-cell">
                        <label class="config-pid-cell-label" for="cfg-pid-speed-ki-yaw">ki</label>
                        <input
                          type="text"
                          id="cfg-pid-speed-ki-yaw"
                          data-config-key="pid.speed.ki.yaw"
                          autocomplete="off"
                          spellcheck="false"
                        />
                      </div>
                      <div class="config-pid-cell">
                        <label class="config-pid-cell-label" for="cfg-pid-speed-kd-yaw">kd</label>
                        <input
                          type="text"
                          id="cfg-pid-speed-kd-yaw"
                          data-config-key="pid.speed.kd.yaw"
                          autocomplete="off"
                          spellcheck="false"
                        />
                      </div>
                    </div>
                  </div>
                </div>

                <div class="config-group">
                  <div class="config-group-title">角度环 PID</div>
                  <div class="config-batch-row config-batch-row--fields-only">
                    <div class="config-pid-cells">
                      <div class="config-pid-cell">
                        <label class="config-pid-cell-label" for="cfg-pid-angle-kp-yaw">kp</label>
                        <input
                          type="text"
                          id="cfg-pid-angle-kp-yaw"
                          data-config-key="pid.angle.kp.yaw"
                          autocomplete="off"
                          spellcheck="false"
                        />
                      </div>
                      <div class="config-pid-cell">
                        <label class="config-pid-cell-label" for="cfg-pid-angle-ki-yaw">ki</label>
                        <input
                          type="text"
                          id="cfg-pid-angle-ki-yaw"
                          data-config-key="pid.angle.ki.yaw"
                          autocomplete="off"
                          spellcheck="false"
                        />
                      </div>
                      <div class="config-pid-cell">
                        <label class="config-pid-cell-label" for="cfg-pid-angle-kd-yaw">kd</label>
                        <input
                          type="text"
                          id="cfg-pid-angle-kd-yaw"
                          data-config-key="pid.angle.kd.yaw"
                          autocomplete="off"
                          spellcheck="false"
                        />
                      </div>
                    </div>
                  </div>
                </div>

                <div class="config-group">
                  <div class="config-group-title">限幅与通信</div>
                  <div class="config-batch-row config-batch-row--fields-only">
                    <div class="config-pid-cells">
                      <div class="config-pid-cell">
                        <label class="config-pid-cell-label" for="cfg-limit-current-yaw">limit.current(A)</label>
                        <input
                          type="text"
                          id="cfg-limit-current-yaw"
                          data-config-key="limit.current.yaw"
                          autocomplete="off"
                          spellcheck="false"
                        />
                      </div>
                      <div class="config-pid-cell">
                        <label class="config-pid-cell-label" for="cfg-uart-baud-rate">uart.baud_rate(bps)</label>
                        <input
                          type="text"
                          id="cfg-uart-baud-rate"
                          data-config-key="uart.baud_rate"
                          autocomplete="off"
                          spellcheck="false"
                        />
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div id="gimbal-config-pitch" class="gimbal-config-axis-panel" role="tabpanel" aria-labelledby="gimbal-axis-tab-pitch" hidden>
                <div class="config-group">
                  <div class="config-group-title">速度环 PID</div>
                  <div class="config-batch-row config-batch-row--fields-only">
                    <div class="config-pid-cells">
                      <div class="config-pid-cell">
                        <label class="config-pid-cell-label" for="cfg-pid-speed-kp-pitch">kp</label>
                        <input
                          type="text"
                          id="cfg-pid-speed-kp-pitch"
                          data-config-key="pid.speed.kp.pitch"
                          autocomplete="off"
                          spellcheck="false"
                        />
                      </div>
                      <div class="config-pid-cell">
                        <label class="config-pid-cell-label" for="cfg-pid-speed-ki-pitch">ki</label>
                        <input
                          type="text"
                          id="cfg-pid-speed-ki-pitch"
                          data-config-key="pid.speed.ki.pitch"
                          autocomplete="off"
                          spellcheck="false"
                        />
                      </div>
                      <div class="config-pid-cell">
                        <label class="config-pid-cell-label" for="cfg-pid-speed-kd-pitch">kd</label>
                        <input
                          type="text"
                          id="cfg-pid-speed-kd-pitch"
                          data-config-key="pid.speed.kd.pitch"
                          autocomplete="off"
                          spellcheck="false"
                        />
                      </div>
                    </div>
                  </div>
                </div>

                <div class="config-group">
                  <div class="config-group-title">角度环 PID</div>
                  <div class="config-batch-row config-batch-row--fields-only">
                    <div class="config-pid-cells">
                      <div class="config-pid-cell">
                        <label class="config-pid-cell-label" for="cfg-pid-angle-kp-pitch">kp</label>
                        <input
                          type="text"
                          id="cfg-pid-angle-kp-pitch"
                          data-config-key="pid.angle.kp.pitch"
                          autocomplete="off"
                          spellcheck="false"
                        />
                      </div>
                      <div class="config-pid-cell">
                        <label class="config-pid-cell-label" for="cfg-pid-angle-ki-pitch">ki</label>
                        <input
                          type="text"
                          id="cfg-pid-angle-ki-pitch"
                          data-config-key="pid.angle.ki.pitch"
                          autocomplete="off"
                          spellcheck="false"
                        />
                      </div>
                      <div class="config-pid-cell">
                        <label class="config-pid-cell-label" for="cfg-pid-angle-kd-pitch">kd</label>
                        <input
                          type="text"
                          id="cfg-pid-angle-kd-pitch"
                          data-config-key="pid.angle.kd.pitch"
                          autocomplete="off"
                          spellcheck="false"
                        />
                      </div>
                    </div>
                  </div>
                </div>

                <div class="config-group">
                  <div class="config-group-title">限幅与通信</div>
                  <div class="config-batch-row config-batch-row--fields-only">
                    <div class="config-pid-cells">
                      <div class="config-pid-cell">
                        <label class="config-pid-cell-label" for="cfg-limit-current-pitch">limit.current(A)</label>
                        <input
                          type="text"
                          id="cfg-limit-current-pitch"
                          data-config-key="limit.current.pitch"
                          autocomplete="off"
                          spellcheck="false"
                        />
                      </div>
                      <div class="config-pid-cell">
                        <label class="config-pid-cell-label" for="cfg-uart-baud-rate-pitch">uart.baud_rate(bps)</label>
                        <input
                          type="text"
                          id="cfg-uart-baud-rate-pitch"
                          data-config-key="uart.baud_rate"
                          autocomplete="off"
                          spellcheck="false"
                        />
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </aside>
        </section>
      </main>

      <SiteFooter revealDelay="260ms" />
    </div>

    <div
      id="serial-confirm-dialog"
      class="serial-confirm-dialog scrollable-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="serial-confirm-title"
      aria-describedby="serial-confirm-desc"
      aria-hidden="true"
    >
      <div class="serial-confirm-dialog__box">
        <h2 id="serial-confirm-title" class="serial-confirm-dialog__title"></h2>
        <p id="serial-confirm-desc" class="serial-confirm-dialog__desc"></p>
        <div class="serial-confirm-dialog__actions">
          <button type="button" class="pill-action" id="serial-confirm-cancel">取消</button>
          <button type="button" class="serial-btn" id="serial-confirm-ok">确认</button>
        </div>
      </div>
    </div>

    <RevealScript />

    <script>
      import { bootGimbalSerialShell } from '../../../scripts/gimbal-serial-shell.ts';
      bootGimbalSerialShell();
    </script>
  </body>
</html>
