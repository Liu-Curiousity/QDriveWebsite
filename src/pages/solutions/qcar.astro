---
import '../../styles/site-shared.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import RevealScript from '../../components/RevealScript.astro';

const title = 'QCar 二轮平衡车方案';
const description =
  'QCar 基于 QD4310 轮毂伺服平台，适用于教学实验、算法验证与轻载搬运等应用场景。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - QDrive Tech</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="page" id="top">
      <main class="shell">
        <SiteHeader />

        <section id="solutions" class="sections">
          <article class="panel" data-reveal style="--d: 220ms">
            <header class="panel-header">
              <div>
                <div class="panel-eyebrow">SOLUTION</div>
                <div class="panel-title">{title}</div>
              </div>
            </header>
            <p class="hero-subtitle">{description}</p>
            <section>
              <h2>方案特点（占位）</h2>
              <ul class="list">
                <li>
                  <span class="list-dot" />
                  基于轮毂伺服内核的姿态/运动控制
                </li>
                <li>
                  <span class="list-dot" />
                  支持教学实验与算法验证场景
                </li>
                <li>
                  <span class="list-dot" />
                  适配轻载搬运与轻量应用原型开发
                </li>
              </ul>
            </section>
          </article>

          <article class="panel" data-reveal style="--d: 320ms">
            <header class="panel-header">
              <div>
                <div class="panel-eyebrow">DOWNLOAD</div>
                <div class="panel-title">资料下载（占位）</div>
              </div>
            </header>
            <ul class="list">
              <li>
                <span class="list-dot" />
                《QCar 二轮平衡车产品说明》PDF（后续放真实链接）
              </li>
            </ul>
          </article>
        </section>
      </main>

      <SiteFooter />
    </div>

    <RevealScript />
  </body>
</html>
