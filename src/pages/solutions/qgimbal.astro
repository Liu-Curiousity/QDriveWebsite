---
import '../../styles/site-shared.css';
import '../../styles/solution-hero.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteFavicon from '../../components/SiteFavicon.astro';
import RevealScript from '../../components/RevealScript.astro';
import DownloadCenter from '../../components/DownloadCenter.astro';
import ResourceDialog from '../../components/ResourceDialog.astro';

const title = 'QGimbal 二维云台';
const description =
  '基于 QD4310 的双轴增稳云台，集成陀螺仪与摄像头接口，支持视觉跟踪与精准指向';

/** 演示视频：在 B 站视频页复制 BV 号（如 BV1xx411c7mD），填到下面 */
const bilibiliBvid = 'BV1MM22B4Ebq';
const bilibiliEmbedSrc = `https://player.bilibili.com/player.html?bvid=${bilibiliBvid}&page=1&high_quality=1&danmaku=0&autoplay=0`;

---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - QDrive Tech</title>
    <meta name="description" content={description} />
    <SiteFavicon />
    <style is:global>
      .qgimbal-third-party .third-party-grid {
        display: block;
        border-top: 1px solid var(--border-subtle);
        background: transparent;
      }

      .qgimbal-third-party { scroll-margin-top: 6rem; }

      .qgimbal-third-party .third-party-card {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, .78fr) minmax(18rem, 1fr);
        grid-template-areas:
          "body media"
          "actions media";
        gap: 1.25rem clamp(2rem, 7vw, 7rem);
        align-items: stretch;
        height: clamp(18rem, 28vw, 24rem);
        min-height: 0;
        padding: clamp(2.25rem, 5vw, 4rem) 0;
        overflow: visible;
        border: 0;
        border-bottom: 1px solid var(--border-subtle);
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        isolation: auto;
        transform: none;
        transition: none;
      }

      .qgimbal-third-party .third-party-card:nth-child(even) {
        grid-template-columns: minmax(18rem, 1fr) minmax(0, .78fr);
        grid-template-areas:
          "media body"
          "media actions";
      }

      .qgimbal-third-party .third-party-card:hover,
      .qgimbal-third-party .third-party-card:focus-within {
        background: transparent;
        box-shadow: none;
        transform: none;
      }

      .qgimbal-third-party .third-party-card-body {
        position: relative;
        z-index: auto;
        grid-area: body;
        display: flex;
        width: auto;
        min-height: 0;
        padding: 0;
        flex-direction: column;
        justify-content: flex-start;
        align-self: start;
        transform: none;
        transition: none;
      }

      .qgimbal-third-party .third-party-card:hover .third-party-card-body,
      .qgimbal-third-party .third-party-card:focus-within .third-party-card-body {
        transform: none;
      }

      .qgimbal-third-party .third-party-card-kicker {
        margin: 0 0 .9rem;
        color: var(--text-muted);
      }

      .qgimbal-third-party .third-party-card h3 {
        margin: 0;
        font-size: var(--type-scale-heading);
        font-weight: 400;
        line-height: var(--leading-heading);
        letter-spacing: var(--tracking-display);
      }

      .qgimbal-third-party .third-party-card p {
        max-width: 34rem;
        margin: 1rem 0 0;
        color: var(--text-muted);
        font-size: var(--type-scale-body);
        font-weight: 400;
        line-height: var(--leading-body);
        letter-spacing: var(--tracking-body);
      }

      .qgimbal-third-party .third-party-card-media {
        position: relative;
        inset: auto;
        z-index: auto;
        grid-area: media;
        display: flex;
        width: 100%;
        height: 100%;
        min-height: 14rem;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        clip-path: none;
        background: transparent;
      }

      .qgimbal-third-party .third-party-card-media::before { display: none; }

      .qgimbal-third-party .third-party-card-media img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
        filter: none;
        transform: none;
        transition: opacity 180ms ease;
      }

      .qgimbal-third-party .third-party-card:hover .third-party-card-media img,
      .qgimbal-third-party .third-party-card:focus-within .third-party-card-media img {
        filter: none;
        transform: none;
        opacity: .88;
      }

      .qgimbal-third-party .third-party-card-actions {
        position: static;
        inset: auto;
        z-index: auto;
        grid-area: actions;
        display: flex;
        flex-wrap: wrap;
        gap: .75rem 1.4rem;
        align-self: end;
        padding: 0;
        background: transparent;
        opacity: 1;
        transform: none;
        pointer-events: auto;
        transition: none;
      }

      .qgimbal-third-party .third-party-action {
        display: inline-flex;
        min-height: 0;
        padding: .35rem 0;
        align-items: center;
        justify-content: flex-start;
        border-bottom: 1px solid var(--border-strong);
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        color: var(--text-main);
        font-family: var(--font-body);
        font-size: var(--type-scale-label);
        font-weight: 450;
        line-height: var(--leading-small);
        letter-spacing: .025em;
        text-decoration: none;
        transition: gap 180ms ease, opacity 180ms ease;
      }

      .qgimbal-third-party .third-party-action::after {
        content: '↗';
        margin-left: .45rem;
        font-weight: 400;
      }

      .qgimbal-third-party .third-party-action:visited { color: var(--text-main); }

      .qgimbal-third-party .third-party-action:hover {
        box-shadow: none;
        opacity: .62;
        transform: none;
      }

      .qgimbal-third-party .third-party-action:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
      }

      .qgimbal-third-party .third-party-disclaimer {
        max-width: 88ch;
        margin: 1.5rem 0 0;
        opacity: .72;
      }

      @media (max-width: 760px) {
        .qgimbal-third-party .third-party-card,
        .qgimbal-third-party .third-party-card:nth-child(even) {
          grid-template-columns: minmax(0, 1fr);
          grid-template-areas:
            "body"
            "media"
            "actions";
          gap: 1.5rem;
          height: auto;
          min-height: 0;
          padding: 2.25rem 0;
        }

        .qgimbal-third-party .third-party-card-media {
          height: min(78vw, 22rem);
          min-height: 0;
        }

        .qgimbal-third-party .third-party-card-actions { align-self: start; }
      }

      @media (prefers-reduced-motion: reduce) {
        .qgimbal-third-party .third-party-card-media img,
        .qgimbal-third-party .third-party-action { transition: none; }
      }
    </style>
  </head>
  <body>
    <div class="page" id="top">
      <main class="shell">
        <SiteHeader />
        <section class="detail-hero hero-bg solution-detail-hero" data-reveal style="--d: 120ms">
          <div class="detail-hero-grid">
            <div>
              <div class="kicker">
                解决方案 · 二维云台
              </div>
              <h1>QGimbal</h1>
              <p class="detail-hero-desc">
                {description}
              </p>
              <div class="detail-hero-actions">
                <a href="https://item.taobao.com/item.htm?id=992314600095" class="btn-primary" target="_blank" rel="noreferrer">立即购买</a>
                <a href="#downloads" class="pill-action">资料下载</a>
              </div>
            </div>
            <div>
              <img
                class="detail-hero-img"
                src="/images/home/qgimbal-main-retouched.png"
                alt="QGimbal 二维无刷云台实物图"
                fetchpriority="high"
                decoding="async"
              />
            </div>
          </div>
        </section>
        <section class="selling-points" data-reveal style="--d: 220ms">
          <div class="section-title">方案优势</div>
          <div class="selling-point-grid selling-point-grid--3col">
            <div class="selling-point-card">
              <div class="selling-point-label">双轴姿态增稳</div>
              <div class="selling-point-desc">
                集成 6 轴 IMU 陀螺仪闭环控制，实现俯仰与航向双轴增稳，有效消除外部振动与抖动
              </div>
            </div>
            <div class="selling-point-card">
              <div class="selling-point-label">智能视觉跟踪</div>
              <div class="selling-point-desc">
                可搭载高帧率摄像头，配合视觉算法实现目标识别与自动跟踪功能
              </div>
            </div>
            <div class="selling-point-card">
              <div class="selling-point-label">激光精准指向</div>
              <div class="selling-point-desc">
                可集成激光发射模块，适用于测距、标记与精准指向等应用
              </div>
            </div>
            <div class="selling-point-card">
              <div class="selling-point-label">高精度控制</div>
              <div class="selling-point-desc">
                基于 QD4310 的 15 位编码器与 FOC 矢量控制，0.01° 控制精度，3 米开外可精准绘制波形
              </div>
            </div>
            <div class="selling-point-card">
              <div class="selling-point-label">毫秒级响应</div>
              <div class="selling-point-desc">
                电流环、速度环快速收敛，毫秒级动态响应，满足高速跟踪与实时增稳场景
              </div>
            </div>
            <div class="selling-point-card">
              <div class="selling-point-label">串口控制 · 灵活接入</div>
              <div class="selling-point-desc">
                通过 UART 即可控制云台，Linux 开发板、PC 电脑、单片机均可轻松接入
              </div>
            </div>
          </div>
        </section>
        <section id="product-gallery" class="gallery-section" data-reveal style="--d: 320ms">
          <div class="section-title">产品细节</div>
          <div class="gallery-row gallery-row--3">
            <div class="gallery-cell">
              <img
                src="/images/solutions/qgimbal/qgimbal-detail-front-retouched.png"
                alt="QGimbal 正侧产品细节"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="gallery-cell">
              <img
                src="/images/solutions/qgimbal/qgimbal_topology.png"
                alt="QGimbal 拓扑图"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="gallery-cell">
              <img
                src="/images/solutions/qgimbal/qgimbal-detail-rear-retouched.png"
                alt="QGimbal 背侧电路与接口细节"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </section>
        <section class="gallery-section" data-reveal style="--d: 380ms">
          <div class="section-title">演示视频</div>

          <div class="video-embed-wrap">
            <iframe
              src={bilibiliEmbedSrc}
              title="QGimbal 演示视频"
              allowfullscreen
              allow="fullscreen; clipboard-write"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            />
          </div>
        </section>
        <section class="gallery-section" data-reveal style="--d: 440ms">
          <div class="section-title">工程图纸</div>

          <div class="gallery-hero engineering-drawing">
            <img
              src="/images/solutions/qgimbal/qgimbal_engineering_drawing.png"
              alt="QGimbal 工程图纸"
              loading="lazy"
              decoding="async"
            />
          </div>
        </section>
        <section class="spec-section" data-reveal style="--d: 500ms">
          <div class="section-title">关键参数</div>

          <div class="spec-table-wrap">
            <table class="spec-table">
              <tbody
                data-page-specs
                data-page-data-url="/downloads/solutions/qgimbal/page-data.json"
              ></tbody>
            </table>
          </div>
        </section>
        <DownloadCenter
          dataUrl="/downloads/solutions/qgimbal/page-data.json"
          titleId="qgimbal-downloads-title"
        />

        <section
          class="host-cta spacer"
          data-reveal
          style="--d: 640ms"
          aria-labelledby="qgimbal-host-cta-title"
        >
          <div class="host-cta-inner">
            <div class="host-cta-text">
              <div class="section-title" id="qgimbal-host-cta-title">网页上位机</div>
              <p class="host-cta-desc">
                通过浏览器连接 USB 串口，使用 Shell 终端与图形面板完成参数读取、写入与控制相关操作。（推荐 Chrome / Edge）
              </p>
            </div>
            <a class="btn-primary" href="/tools/web-host">进入串口调参工具</a>
          </div>
        </section>

        <!-- Reserved for future partner content. Remove `hidden` to publish the
             complete section again; its UI, data binding and responsive styles
             remain intact below. -->
        <section
          id="third-party"
          class="third-party-section spacer qgimbal-third-party"
          data-reveal
          style="--d: 700ms"
          hidden
        >
          <div class="section-title">第三方方案</div>

          <div
            class="third-party-grid"
            data-page-third-party-solutions
            data-page-data-url="/downloads/solutions/qgimbal/page-data.json"
          ></div>

          <p class="third-party-disclaimer">
            免责声明：第三方方案由外部开发者或社区提供，仅供参考与二次开发评估。相关内容、代码、视频、文档及外部链接不代表 QDrive Tech 的官方承诺；使用过程中产生的兼容性问题、功能异常、数据损失、设备损坏或其他风险，由使用者自行判断并承担责任。
          </p>
        </section>

      </main>

      <SiteFooter revealDelay="620ms" />

      <!-- 产品手册 -->
      <ResourceDialog
        id="qgimbal-manual-dialog"
        titleId="qgimbal-manual-dialog-title"
        triggerId="qgimbal-manual-open-btn"
        title="产品手册"
        description="选择所需文档"
      >
        <ul
          class="resource-list download-resource-dialog__list"
          data-page-link-list="manuals"
          data-page-data-url="/downloads/solutions/qgimbal/page-data.json"
          aria-label="产品手册"
        ></ul>
      </ResourceDialog>

      <!-- 程序源码 -->
      <ResourceDialog
        id="qgimbal-source-dialog"
        titleId="qgimbal-source-dialog-title"
        triggerId="qgimbal-source-open-btn"
        title="程序源码"
        description="选择代码仓库"
      >
        <ul
          class="resource-list download-resource-dialog__list"
          data-page-link-list="sources"
          data-page-data-url="/downloads/solutions/qgimbal/page-data.json"
          aria-label="程序源码"
        ></ul>
      </ResourceDialog>

      <!-- 历史固件 -->
      <ResourceDialog
        id="qgimbal-resource-dialog"
        titleId="qgimbal-resource-dialog-title"
        triggerId="qgimbal-fw-open-btn"
        title="历史固件"
        description="选择历史固件版本"
        variant="firmware"
      >
        <ul
          class="resource-list download-resource-dialog__list"
          data-firmware-manifest
          data-manifest-url="/downloads/solutions/qgimbal/firmware/manifest.json"
          aria-label="历史固件"
        ></ul>
      </ResourceDialog>
    </div>

    <RevealScript />

    <script>
      import { bootFirmwareManifestLists } from '../../scripts/firmware-manifest.ts';
      import { bootPageDataSections } from '../../scripts/page-data.ts';
      import { bootResourceDialogs } from '../../scripts/resource-dialog.ts';

      bootPageDataSections();
      bootFirmwareManifestLists();
      bootResourceDialogs();
    </script>
  </body>
</html>
