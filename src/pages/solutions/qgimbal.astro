---
import '../../styles/site-shared.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import RevealScript from '../../components/RevealScript.astro';

const title = 'QGimbal 二维云台';
const description = 'QGimbal 基于 QD4310 平台打造，用于姿态控制与稳定应用的二维云台解决方案。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - QDrive Tech</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="page" id="top">
      <main class="shell">
        <SiteHeader />

        <section id="solutions" class="sections">
          <article class="panel" data-reveal style="--d: 220ms">
            <header class="panel-header">
              <div>
                <div class="panel-eyebrow">SOLUTION</div>
                <div class="panel-title">{title}</div>
              </div>
            </header>
            <p class="hero-subtitle">{description}</p>
            <section>
              <h2>方案特点（占位）</h2>
              <ul class="list">
                <li>
                  <span class="list-dot" />
                  双轴姿态稳定与精准指向
                </li>
                <li>
                  <span class="list-dot" />
                  便于与视觉采集/监控系统集成
                </li>
                <li>
                  <span class="list-dot" />
                  兼容基于 QD4310 的控制与调参流程
                </li>
              </ul>
            </section>
          </article>

          <article class="panel" data-reveal style="--d: 320ms">
            <header class="panel-header">
              <div>
                <div class="panel-eyebrow">DOWNLOAD</div>
                <div class="panel-title">资料下载（占位）</div>
              </div>
            </header>
            <ul class="list">
              <li>
                <span class="list-dot" />
                《QGimbal 二维云台产品说明》PDF（后续放真实链接）
              </li>
            </ul>
          </article>
        </section>
      </main>

      <SiteFooter />
    </div>

    <RevealScript />
  </body>
</html>
