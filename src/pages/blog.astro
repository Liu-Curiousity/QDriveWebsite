---
import '../styles/site-shared.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import RevealScript from '../components/RevealScript.astro';

const title = '技术博客';
const description =
  '记录 QDrive Tech 在伺服电机与运动控制领域的技术思考、产品实践与应用案例。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - QDrive Tech</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="page" id="top">
      <main class="shell">
        <SiteHeader />

        <section id="solutions" class="sections">
          <article class="panel" data-reveal style="--d: 220ms">
            <header class="panel-header">
              <div>
                <div class="panel-eyebrow">BLOG</div>
                <div class="panel-title">技术文章与实践案例</div>
              </div>
            </header>
            <p class="hero-subtitle">{description}</p>
            <section>
              <h2>文章列表（占位）</h2>
              <p>后续将在此列出按时间排序的技术文章，内容来源为 Markdown 文件。</p>
            </section>
          </article>

          <article class="panel" data-reveal style="--d: 320ms">
            <header class="panel-header">
              <div>
                <div class="panel-eyebrow">INDEX</div>
                <div class="panel-title">文章分类（占位）</div>
              </div>
            </header>
            <ul class="list">
              <li>
                <span class="list-dot" />
                伺服控制与调参
              </li>
              <li>
                <span class="list-dot" />
                运动控制与路径规划
              </li>
              <li>
                <span class="list-dot" />
                应用案例与工程经验
              </li>
            </ul>
          </article>
        </section>
      </main>

      <SiteFooter />
    </div>

    <RevealScript />
  </body>
</html>
