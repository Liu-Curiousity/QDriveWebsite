---
import '../../styles/site-shared.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import RevealScript from '../../components/RevealScript.astro';

const title = 'QD4310 伺服电机平台';
const description =
  '驱控一体中空无刷伺服电机，集成电机、驱动与角度传感器，兼顾高精度、高响应和优越的低速性能';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - QDrive Tech</title>
    <meta name="description" content={description} />
    <style>
      .fw-dialog {
        position: fixed;
        inset: 0;
        z-index: 200;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0);
        backdrop-filter: blur(0px);
        pointer-events: none;
        visibility: hidden;
        transition: background 280ms ease-out, backdrop-filter 280ms ease-out, visibility 280ms ease-out;
      }

      .fw-dialog.open {
        background: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(4px);
        pointer-events: auto;
        visibility: visible;
      }

      .fw-dialog-box {
        background: var(--bg-elevated);
        border: none;
        border-radius: 1.2rem;
        padding: 1.4rem 1.5rem;
        width: 90%;
        max-width: 420px;
        max-height: 80vh;
        overflow-y: auto;
        box-shadow: var(--shadow-dialog);
        opacity: 0;
        transform: translateY(16px) scale(0.97);
        transition: opacity 280ms ease-out, transform 280ms ease-out;
      }

      .fw-dialog.open .fw-dialog-box {
        opacity: 1;
        transform: translateY(0) scale(1);
      }

      .fw-dialog-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
      }

      .fw-dialog-title {
        font-size: 1rem;
        font-weight: 700;
      }

      .fw-dialog-close {
        width: 2rem;
        height: 2rem;
        border-radius: 999px;
        border: none;
        background: var(--accent-soft);
        color: var(--text-muted);
        line-height: 0;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background 150ms ease-out, color 150ms ease-out;
      }

      .fw-dialog-close svg {
        display: block;
        width: 1.05rem;
        height: 1.05rem;
      }

      .fw-dialog-close:hover {
        color: var(--accent);
        background: rgba(0, 0, 0, 0.06);
      }

      @media (prefers-color-scheme: dark) {
        .fw-dialog-close:hover {
          background: rgba(255, 255, 255, 0.1);
        }
      }

      .fw-version-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .fw-version-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
        padding: 0.7rem 0.8rem;
        border-radius: 0.7rem;
        border: none;
        background: var(--accent-soft);
      }

      .fw-version-note {
        font-size: 0.7rem;
        color: var(--text-muted);
        margin-top: 0.1rem;
      }

      .fw-version-info {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
      }

      .fw-version-name {
        font-size: 0.82rem;
        font-weight: 600;
      }

      .fw-version-date {
        font-size: 0.7rem;
        color: var(--text-muted);
      }

    </style>
  </head>
  <body>
    <div class="page" id="top">
      <main class="shell">
        <SiteHeader />

        <!-- ───────── Hero ───────── -->
        <section class="product-hero hero-bg" data-reveal style="--d: 120ms">
          <div class="product-hero-grid">
            <div>
              <div class="kicker">
                <span class="kicker-dot" />
                伺服电机 · 运动控制平台
              </div>
              <h1>QD4310</h1>
              <p class="product-hero-desc">
                {description}
              </p>
              <p class="product-hero-desc" style="margin-top: 0.6rem;">
                适用于小型云台、教学实验、电赛平台、轻量机器人等紧凑空间场景
              </p>
              <p class="product-hero-desc" style="margin-top: 0.6rem;">
                电流（力矩）、速度、角度，多种控制模式
              </p>
              <p class="product-hero-desc" style="margin-top: 0.6rem;">
                中空轴设计，可安装导电滑环
              </p>
              <div class="product-hero-actions">
                <a href="https://item.taobao.com/item.htm?id=965434015793" class="btn-primary" target="_blank" rel="noreferrer">立即购买</a>
                <a href="#downloads" class="fw-version-dl">资料下载 ↓</a>
              </div>
            </div>
            <div>
              <img
                class="product-hero-img"
                src="/images/products/qd4310/qd4310.png"
                alt="QD4310 伺服电机主渲染图"
                fetchpriority="high"
                decoding="async"
              />
            </div>
          </div>
        </section>

        <!-- ───────── 卖点卡片 ───────── -->
        <section class="selling-points" data-reveal style="--d: 220ms">
          <div class="section-title">核心卖点</div>
          <div class="section-subtitle">WHY QD4310</div>
          <div class="sp-grid">
            <div class="sp-card">
              <div class="sp-icon">⚙</div>
              <div class="sp-label">电驱一体化集成</div>
              <div class="sp-desc">
                电机、驱动器与角度传感器三合一，无需外部驱动板，安装布线更简洁
              </div>
            </div>
            <div class="sp-card">
              <div class="sp-icon">🔌</div>
              <div class="sp-label">多种通讯接口</div>
              <div class="sp-desc">
                支持 USB / CAN / UART / PWM，XT30 供电，兼容主流控制器与上位机调参
              </div>
            </div>
            <div class="sp-card">
              <div class="sp-icon">◎</div>
              <div class="sp-label">高精度编码器</div>
              <div class="sp-desc">
                内置 15 位磁编码器，配合 FOC 矢量控制，支持电流、速度与角度三环控制
              </div>
            </div>
            <div class="sp-card">
              <div class="sp-icon">↕</div>
              <div class="sp-label">中空轴设计</div>
              <div class="sp-desc">
                中空结构便于走线与光路穿越，适用于云台、旋转关节等需要内部布线的场景
              </div>
            </div>
            <div class="sp-card">
              <div class="sp-icon">⚡</div>
              <div class="sp-label">宽电压支持</div>
              <div class="sp-desc">
                7~26V 宽电压输入，兼容 2S~6S 锂电池直供，无需额外降压/升压
              </div>
            </div>
          </div>
        </section>

        <!-- ───────── 产品素材画廊 ───────── -->
        <section class="gallery-section" data-reveal style="--d: 320ms">
          <div class="section-title">产品细节</div>
          <div class="section-subtitle">PRODUCT GALLERY</div>
          <div class="gallery-row gallery-row--3">
            <div class="gallery-cell">
              <img
                src="/images/products/qd4310/qd4310_photograph.png"
                alt="QD4310 实拍图"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="gallery-cell">
              <img
                src="/images/products/qd4310/qd4310_explosion.png"
                alt="QD4310 爆炸图"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="gallery-cell">
              <img
                src="/images/products/qd4310/qd4310_slip_ring.png"
                alt="QD4310 滑环图"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </section>

        <!-- ───────── 工程图纸 ───────── -->
        <section class="gallery-section" data-reveal style="--d: 460ms">
          <div class="section-title">工程图纸</div>
          <div class="section-subtitle">ENGINEERING DRAWINGS</div>

          <div class="gallery-hero engineering-drawing">
            <img
              src="/images/products/qd4310/qd4310_engineering_drawing.png"
              alt="QD4310 工程图纸"
              loading="lazy"
              decoding="async"
            />
          </div>
        </section>

        <!-- ───────── 关键参数 ───────── -->
        <section class="spec-section" data-reveal style="--d: 500ms">
          <div class="section-title">关键参数</div>
          <div class="section-subtitle">SPECIFICATIONS</div>

          <div class="spec-table-wrap">
            <table class="spec-table">
              <tbody>
                <tr>
                  <th>额定电压</th>
                  <td>7~26V（2S~6S 锂电池 / DC 电源）</td>
                </tr>
                <tr>
                  <th>额定电流</th>
                  <td>1A</td>
                </tr>
                <tr>
                  <th>峰值电流</th>
                  <td>2A</td>
                </tr>
                <tr>
                  <th>额定扭矩</th>
                  <td>0.2Nm</td>
                </tr>
                <tr>
                  <th>堵转扭矩</th>
                  <td>0.3Nm</td>
                </tr>
                <tr>
                  <th>额定转速</th>
                  <td>500rpm</td>
                </tr>
                <tr>
                  <th>峰值转速</th>
                  <td>800rpm</td>
                </tr>
                <tr>
                  <th>极对数</th>
                  <td>14</td>
                </tr>
                <tr>
                  <th>编码器</th>
                  <td>15 位磁编码器（内置）</td>
                </tr>
                <tr>
                  <th>控制精度</th>
                  <td>0.01度</td>
                </tr>
                <tr>
                  <th>控制模式</th>
                  <td>电流 / 速度 / 角度模式、低速大力矩模式、角度步进模式</td>
                </tr>
                <tr>
                  <th>通讯方式</th>
                  <td>USB / CAN / UART / PWM</td>
                </tr>
                <tr>
                  <th>CAN波特率</th>
                  <td>1Mbps</td>
                </tr>
                <tr>
                  <th>UART波特率</th>
                  <td>115200bps</td>
                </tr>
                <tr>
                  <th>重量</th>
                  <td>127g</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- ───────── 资料下载 ───────── -->
        <section id="downloads" class="download-section spacer" data-reveal style="--d: 560ms">
          <div class="section-title">资料下载</div>
          <div class="section-subtitle">DOWNLOADS</div>

          <div class="dl-grid">
            <a class="dl-card" href="/downloads/products/qd4310/QD4310使用手册.pdf" target="_blank" rel="noopener noreferrer" aria-label="查看产品手册（新标签页打开）">
              <div class="dl-card-icon">📄</div>
              <div class="dl-card-title">产品手册</div>
              <div class="dl-card-desc">QD4310 产品手册 PDF，含功能概述与使用方法</div>
            </a>
            <a class="dl-card" href="/downloads/products/qd4310/QD4310例程代码.zip" download aria-label="下载例程">
              <div class="dl-card-icon">💻</div>
              <div class="dl-card-title">例程代码</div>
              <div class="dl-card-desc">函数库、各平台控制例程与 Demo 工程</div>
            </a>
            <button class="dl-card" type="button" id="fw-open-btn" aria-label="选择历史固件版本">
              <div class="dl-card-icon">🔧</div>
              <div class="dl-card-title">历史固件</div>
              <div class="dl-card-desc">点击选择版本下载</div>
            </button>
            <a class="dl-card" href="/downloads/products/qd4310/QD4310配套工具.zip" download aria-label="下载配套工具">
              <div class="dl-card-icon">⬆</div>
              <div class="dl-card-title">配套工具</div>
              <div class="dl-card-desc">上位机与固件升级工具</div>
            </a>
            <a class="dl-card" href="/downloads/products/qd4310/QD4310_3D模型.zip" download aria-label="下载3D模型">
              <div class="dl-card-icon">📐</div>
              <div class="dl-card-title">3D 模型</div>
              <div class="dl-card-desc">STEP / STP 格式，便于结构设计集成</div>
            </a>
          </div>
        </section>

      </main>

      <SiteFooter revealDelay="620ms" />

      <!-- 历史固件版本选择弹窗 -->
      <div class="fw-dialog" id="fw-dialog" role="dialog" aria-modal="true" aria-labelledby="fw-dialog-title">
        <div class="fw-dialog-box">
          <div class="fw-dialog-header">
            <div class="fw-dialog-title" id="fw-dialog-title">选择固件版本</div>
            <button class="fw-dialog-close" id="fw-close-btn" type="button" aria-label="关闭">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path
                  d="M7 7l10 10M17 7L7 17"
                  stroke="currentColor"
                  stroke-width="2.25"
                  stroke-linecap="round"
                />
              </svg>
            </button>
          </div>
          <ul class="fw-version-list">
            <li class="fw-version-item">
              <div class="fw-version-info">
                <div class="fw-version-name">v6.1.1（最新）</div>
                <div class="fw-version-date">2026-03-12</div>
                <div class="fw-version-note">添加 UART 通信功能</div>
              </div>
              <a class="fw-version-dl" href="/downloads/products/qd4310/firmware/QD4310_V6.1.1.dfu" download aria-label="下载固件 v6.1.1">下载</a>
            </li>
            <li class="fw-version-item">
              <div class="fw-version-info">
                <div class="fw-version-name">v6.0.1</div>
                <div class="fw-version-date">2026-01-25</div>
                <div class="fw-version-note">修复低速模式下单圈会返回的问题</div>
                <div class="fw-version-note">修复使用CAN总线控制角度步进时没有反馈报文的问题</div>
                <div class="fw-version-note">调整角度步进映射范围到-2pi~2pi</div>
              </div>
              <a class="fw-version-dl" href="/downloads/products/qd4310/firmware/QD4310_V6.0.1.dfu" download aria-label="下载固件 v6.0.1">下载</a>
            </li>
            <li class="fw-version-item">
              <div class="fw-version-info">
                <div class="fw-version-name">v6.0.0</div>
                <div class="fw-version-date">2026-01-16</div>
                <div class="fw-version-note">V6.X 电机首个版本</div>
              </div>
              <a class="fw-version-dl" href="/downloads/products/qd4310/firmware/QD4310_V6.0.0.dfu" download aria-label="下载固件 v6.0.0">下载</a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <RevealScript />

    <script type="module" is:inline>
      const fwDialog = document.getElementById('fw-dialog');
      const fwOpenBtn = document.getElementById('fw-open-btn');
      const fwCloseBtn = document.getElementById('fw-close-btn');

      if (fwDialog && fwOpenBtn && fwCloseBtn) {
        const FOCUSABLE = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
        let lastFocused = null;

        const openDialog = () => {
          lastFocused = document.activeElement;
          fwDialog.classList.add('open');
          document.body.style.overflow = 'hidden';
          const first = fwDialog.querySelector(FOCUSABLE);
          if (first) first.focus();
        };

        const closeDialog = () => {
          fwDialog.classList.remove('open');
          document.body.style.overflow = '';
          if (lastFocused) lastFocused.focus();
        };

        fwOpenBtn.addEventListener('click', openDialog);
        fwCloseBtn.addEventListener('click', closeDialog);

        fwDialog.addEventListener('click', (e) => {
          if (e.target === fwDialog) closeDialog();
        });

        fwDialog.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeDialog();
            return;
          }
          if (e.key !== 'Tab') return;
          const focusable = Array.from(fwDialog.querySelectorAll(FOCUSABLE));
          if (focusable.length === 0) return;
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        });
      }
    </script>
  </body>
</html>
