---
import '../../styles/site-shared.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteFavicon from '../../components/SiteFavicon.astro';
import RevealScript from '../../components/RevealScript.astro';

const title = 'QD4310 伺服电机平台';
const description =
  '驱控一体中空无刷伺服电机，集成电机、驱动与角度传感器，兼顾高精度、高响应和优越的低速性能';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - QDrive Tech</title>
    <meta name="description" content={description} />
    <SiteFavicon />
  </head>
  <body>
    <div class="page" id="top">
      <main class="shell">
        <SiteHeader />
        <section class="detail-hero hero-bg" data-reveal style="--d: 120ms">
          <div class="detail-hero-grid">
            <div>
              <div class="kicker">
                <span class="kicker-dot" />
                伺服电机 · 运动控制平台
              </div>
              <h1>QD4310</h1>
              <p class="detail-hero-desc">
                {description}
              </p>
              <p class="detail-hero-desc" style="margin-top: 0.6rem;">
                适用于小型云台、教学实验、电赛平台、轻量机器人等紧凑空间场景
              </p>
              <p class="detail-hero-desc" style="margin-top: 0.6rem;">
                电流（力矩）、速度、角度，多种控制模式
              </p>
              <p class="detail-hero-desc" style="margin-top: 0.6rem;">
                中空轴设计，可安装导电滑环
              </p>
              <div class="detail-hero-actions">
                <a href="https://item.taobao.com/item.htm?id=965434015793" class="btn-primary" target="_blank" rel="noreferrer">立即购买</a>
                <a href="#downloads" class="pill-action">资料下载 ↓</a>
              </div>
            </div>
            <div>
              <img
                class="detail-hero-img"
                src="/images/home/qd4310-dual-retouched.png"
                alt="两台 QD4310 驱控一体中空无刷伺服电机"
                fetchpriority="high"
                decoding="async"
              />
            </div>
          </div>
        </section>
        <section class="selling-points" data-reveal style="--d: 220ms">
          <div class="section-title">核心卖点</div>
          <div class="section-subtitle">WHY QD4310</div>
          <div class="selling-point-grid">
            <div class="selling-point-card">
              <div class="selling-point-icon">⚙</div>
              <div class="selling-point-label">电驱一体化集成</div>
              <div class="selling-point-desc">
                电机、驱动器与角度传感器三合一，无需外部驱动板，安装布线更简洁
              </div>
            </div>
            <div class="selling-point-card">
              <div class="selling-point-icon">🔌</div>
              <div class="selling-point-label">多种通讯接口</div>
              <div class="selling-point-desc">
                支持 USB / CAN / UART / PWM，XT30 供电，兼容主流控制器与上位机调参
              </div>
            </div>
            <div class="selling-point-card">
              <div class="selling-point-icon">◎</div>
              <div class="selling-point-label">高精度编码器</div>
              <div class="selling-point-desc">
                内置 15 位磁编码器，配合 FOC 矢量控制，支持电流、速度与角度三环控制
              </div>
            </div>
            <div class="selling-point-card">
              <div class="selling-point-icon">↕</div>
              <div class="selling-point-label">中空轴设计</div>
              <div class="selling-point-desc">
                中空结构便于走线与光路穿越，适用于云台、旋转关节等需要内部布线的场景
              </div>
            </div>
            <div class="selling-point-card">
              <div class="selling-point-icon">⚡</div>
              <div class="selling-point-label">宽电压支持</div>
              <div class="selling-point-desc">
                7~26V 宽电压输入，兼容 2S~6S 锂电池直供，无需额外降压/升压
              </div>
            </div>
          </div>
        </section>
        <section class="gallery-section" data-reveal style="--d: 320ms">
          <div class="section-title">产品细节</div>
          <div class="section-subtitle">PRODUCT GALLERY</div>
          <div class="gallery-row gallery-row--3">
            <div class="gallery-cell">
              <img
                src="/images/products/qd4310/qd4310_photograph.png"
                alt="QD4310 实拍图"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="gallery-cell">
              <img
                src="/images/products/qd4310/qd4310_explosion.png"
                alt="QD4310 爆炸图"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="gallery-cell">
              <img
                src="/images/products/qd4310/qd4310_slip_ring.png"
                alt="QD4310 滑环图"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </section>
        <section class="gallery-section" data-reveal style="--d: 460ms">
          <div class="section-title">工程图纸</div>
          <div class="section-subtitle">ENGINEERING DRAWINGS</div>

          <div class="gallery-hero engineering-drawing">
            <img
              src="/images/products/qd4310/qd4310_engineering_drawing.png"
              alt="QD4310 工程图纸"
              loading="lazy"
              decoding="async"
            />
          </div>
        </section>
        <section class="spec-section" data-reveal style="--d: 500ms">
          <div class="section-title">关键参数</div>
          <div class="section-subtitle">SPECIFICATIONS</div>

          <div class="spec-table-wrap">
            <table class="spec-table">
              <tbody
                data-page-specs
                data-page-data-url="/downloads/products/qd4310/page-data.json"
              ></tbody>
            </table>
          </div>
        </section>
        <section id="downloads" class="download-section spacer" data-reveal style="--d: 560ms">
          <div class="section-title">资料下载</div>
          <div class="section-subtitle">DOWNLOADS</div>

          <div
            class="download-grid"
            data-page-downloads
            data-page-data-url="/downloads/products/qd4310/page-data.json"
          ></div>

        </section>

        <section
          class="host-cta spacer"
          data-reveal
          style="--d: 640ms"
          aria-labelledby="qd4310-host-cta-title"
        >
          <div class="host-cta-inner">
            <div class="host-cta-text">
              <div class="section-title" id="qd4310-host-cta-title">网页上位机</div>
              <p class="host-cta-desc">
                通过浏览器连接 USB 串口，使用 Shell 终端与图形面板完成参数读取、写入、校准相关操作。（推荐 Chrome / Edge）
              </p>
            </div>
            <a class="btn-primary" href="/tools/web-host">进入串口调参工具</a>
          </div>
        </section>

      </main>

      <SiteFooter revealDelay="620ms" />

      <!-- 历史固件版本选择弹窗 -->
      <div
        class="resource-dialog scrollable-dialog"
        id="resource-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="resource-dialog-title"
        aria-hidden="true"
        data-resource-dialog
        data-open-trigger-id="fw-open-btn"
      >
        <div class="resource-dialog-box">
          <div class="resource-dialog-header">
            <div class="resource-dialog-title" id="resource-dialog-title">选择固件版本</div>
            <button class="resource-dialog-close" type="button" aria-label="关闭">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path
                  d="M7 7l10 10M17 7L7 17"
                  stroke="currentColor"
                  stroke-width="2.25"
                  stroke-linecap="round"
                />
              </svg>
            </button>
          </div>
          <ul
            class="resource-list"
            data-firmware-manifest
            data-manifest-url="/downloads/products/qd4310/firmware/manifest.json"
          ></ul>
        </div>
      </div>
    </div>

    <RevealScript />

    <script>
      import { bootFirmwareManifestLists } from '../../scripts/firmware-manifest.ts';
      import { bootPageDataSections } from '../../scripts/page-data.ts';
      import { bootResourceDialogs } from '../../scripts/resource-dialog.ts';

      bootPageDataSections();
      bootFirmwareManifestLists();
      bootResourceDialogs();
    </script>
  </body>
</html>
