---
import '../styles/site-shared.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteFavicon from '../components/SiteFavicon.astro';
import RevealScript from '../components/RevealScript.astro';
import principlesBackground from '../assets/qdrive-principles-background.svg?url';

const title = '关于 QDrive Tech';
const description =
  'QDrive Tech 围绕伺服电机、驱动控制与工程工具链，构建可验证、可集成、可持续演进的精密运动平台。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f6f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0f13" media="(prefers-color-scheme: dark)" />
    <title>{title} - QDrive Tech</title>
    <meta name="description" content={description} />
    <SiteFavicon />
    <style>
      .about-page {
        --about-line: color-mix(in srgb, var(--text-main) 12%, transparent);
        --about-line-soft: color-mix(in srgb, var(--text-main) 6%, transparent);
        --about-faint: color-mix(in srgb, var(--text-main) 3%, transparent);
        --about-gutter: var(--site-content-rail);
        min-width: 0;
        overflow: hidden;
      }

      .shell.about-page-header {
        position: sticky;
        top: 0;
        z-index: 130;
        padding-bottom: 0;
      }

      :global(.about-page-header > header.site-header) {
        position: relative;
        top: auto;
      }

      .about-intro {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 2rem;
        align-items: end;
        padding: clamp(1.75rem, 3vw, 2.75rem) 0;
      }

      .about-intro p {
        max-width: 38rem;
        margin: 0;
        color: var(--text-muted);
        font-size: var(--type-scale-body);
        line-height: var(--leading-body);
        letter-spacing: var(--tracking-body);
        text-wrap: pretty;
      }

      .about-text-link {
        display: inline-flex;
        align-items: center;
        gap: .9rem;
        padding: .35rem 0;
        border-bottom: 1px solid currentColor;
        color: var(--text-main);
        font-size: var(--type-scale-body);
        font-weight: 500;
        letter-spacing: .02em;
        text-decoration: none;
        white-space: nowrap;
        transition: gap 240ms cubic-bezier(.2, .8, .2, 1), opacity 180ms ease;
      }

      .about-text-link:hover { gap: 1.25rem; opacity: .62; }
      .about-text-link:active { transform: translateY(1px); }

      .about-text-link:focus-visible,
      .about-system-card:focus-visible,
      .about-resource-link:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 5px;
      }

      .about-stage {
        position: relative;
        width: 100vw;
        min-height: clamp(39rem, 64vw, 52rem);
        margin-left: calc(50% - 50vw);
        overflow: hidden;
        border-block: 1px solid var(--about-line-soft);
        background:
          radial-gradient(circle at 72% 46%, color-mix(in srgb, var(--text-main) 8%, transparent), transparent 29%),
          linear-gradient(112deg, transparent 0 61%, var(--about-line-soft) 61% calc(61% + 1px), transparent calc(61% + 1px)),
          var(--bg-elevated);
        box-shadow: 0 0 0 100vmax var(--bg-elevated);
        clip-path: inset(0 -100vmax);
        isolation: isolate;
      }

      .about-stage::after {
        position: absolute;
        inset: 0;
        z-index: 5;
        pointer-events: none;
        opacity: .18;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.95' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.15'/%3E%3C/svg%3E");
        mix-blend-mode: soft-light;
        content: '';
      }

      .about-stage__map {
        position: absolute;
        inset: 2rem -8% 7rem 33%;
        z-index: -1;
        width: 75%;
        height: calc(100% - 9rem);
        object-fit: cover;
        opacity: .08;
        mix-blend-mode: multiply;
        pointer-events: none;
      }

      .about-stage__top {
        position: absolute;
        top: 2rem;
        right: var(--about-gutter);
        left: var(--about-gutter);
        z-index: 4;
        display: flex;
        justify-content: space-between;
        gap: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--about-line-soft);
        color: var(--text-muted);
        font-size: var(--type-scale-label);
        line-height: 1.55;
        letter-spacing: var(--tracking-label);
        text-transform: uppercase;
      }

      .about-stage__copy {
        position: absolute;
        top: 26%;
        left: var(--about-gutter);
        z-index: 4;
        width: min(40%, 31rem);
      }

      .about-stage__eyebrow,
      .about-section-label {
        margin: 0 0 1.35rem;
        color: var(--text-muted);
        text-transform: uppercase;
      }

      .about-stage h1 {
        max-width: none;
        margin: 0;
        font-size: var(--type-scale-display);
        font-weight: 400;
        line-height: .98;
        letter-spacing: -.045em;
        text-wrap: balance;
      }

      .about-stage h1 span {
        display: block;
        white-space: nowrap;
      }

      .about-stage__lead {
        max-width: 31rem;
        margin: 1.5rem 0 0;
        color: var(--text-muted);
        font-size: var(--type-scale-body);
        line-height: var(--leading-body);
        letter-spacing: var(--tracking-body);
        text-wrap: pretty;
      }

      .about-stage__product {
        position: absolute;
        top: 12%;
        right: var(--about-gutter);
        bottom: 6.7rem;
        z-index: 2;
        width: min(54%, 47rem);
        margin: 0;
        display: grid;
        place-items: center;
      }

      .about-stage__orbit,
      .about-stage__orbit::before,
      .about-stage__orbit::after {
        position: absolute;
        width: min(35vw, 33rem);
        aspect-ratio: 1;
        border: 1px solid var(--about-line-soft);
        border-radius: 50%;
        content: '';
      }

      .about-stage__orbit::before { inset: 9%; width: auto; }
      .about-stage__orbit::after { inset: 22%; width: auto; }

      .about-stage__product img {
        position: relative;
        z-index: 2;
        width: min(43vw, 39rem);
        max-width: 95%;
        height: auto;
        filter: saturate(.82) contrast(1.04) drop-shadow(0 2rem 2rem rgba(0, 0, 0, .22));
        transform: rotate(-4deg);
        transition: transform 420ms cubic-bezier(.2, .8, .2, 1), filter 250ms ease;
      }

      .about-stage__product:hover img {
        filter: saturate(.96) contrast(1.04) drop-shadow(0 2.35rem 2.25rem rgba(0, 0, 0, .26));
        transform: rotate(-4deg) translateY(-.35rem) scale(1.025);
      }

      .about-stage__product figcaption {
        position: absolute;
        right: 0;
        bottom: 1.5rem;
        z-index: 3;
        display: grid;
        justify-items: end;
        gap: .3rem;
        text-align: right;
      }

      .about-stage__product figcaption strong {
        font-family: var(--font-display);
        font-size: var(--type-scale-level);
        font-weight: 430;
        line-height: .95;
        letter-spacing: -.035em;
      }

      .about-stage__product .about-product-label {
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: var(--type-scale-label);
        letter-spacing: .12em;
        text-transform: uppercase;
      }

      .about-stage__product .about-product-description {
        color: var(--text-muted);
        font-family: var(--font-body);
        font-size: var(--type-scale-label);
        letter-spacing: .04em;
      }

      .about-stage__product figcaption span,
      .about-stage__nav span,
      .about-system-card figcaption span {
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: var(--type-scale-label);
        letter-spacing: .08em;
        text-transform: uppercase;
      }

      .about-stage__nav {
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: 4;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        min-height: 6.5rem;
        padding-inline: var(--about-gutter);
        border-top: 1px solid var(--about-line-soft);
        background: color-mix(in srgb, var(--bg-elevated) 76%, transparent);
        backdrop-filter: blur(10px);
      }

      .about-stage__nav a {
        display: grid;
        align-content: center;
        gap: .45rem;
        padding: 1rem clamp(1rem, 2.5vw, 2.25rem);
        color: var(--text-main);
        text-decoration: none;
        transition: background-color 180ms ease;
      }

      .about-stage__nav a:hover { background: var(--about-faint); }

      .about-stage__nav strong {
        font-size: var(--type-scale-body);
        font-weight: 500;
      }

      .about-story,
      .about-systems,
      .about-method,
      .about-resources {
        padding-top: clamp(5rem, 10vw, 9rem);
      }

      .about-story__heading,
      .about-systems__heading,
      .about-resources__heading {
        display: grid;
        grid-template-columns: minmax(0, .85fr) minmax(22rem, 1.15fr);
        gap: clamp(2rem, 6vw, 7rem);
        align-items: start;
      }

      .about-story h2,
      .about-systems h2,
      .about-resources h2 {
        max-width: 15ch;
        margin: 0;
        font-size: var(--type-scale-display);
        font-weight: 400;
        line-height: 1.05;
        letter-spacing: -.035em;
        text-wrap: balance;
      }

      .about-story__copy,
      .about-systems__copy {
        display: grid;
        gap: 1.15rem;
      }

      .about-story__copy p,
      .about-systems__copy p {
        max-width: var(--measure-body);
        margin: 0;
        color: var(--text-muted);
        font-size: var(--type-scale-body);
        line-height: var(--leading-body);
        letter-spacing: var(--tracking-body);
        text-wrap: pretty;
      }

      .about-story__copy .about-story__lead {
        color: var(--text-main);
        font-size: var(--type-scale-heading);
        line-height: 1.55;
        letter-spacing: .01em;
      }

      .about-principles {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin-top: clamp(3.5rem, 7vw, 6rem);
        border-top: 1px solid var(--about-line-soft);
      }

      .about-principle {
        min-width: 0;
        padding: clamp(1.5rem, 3vw, 2.75rem);
      }

      .about-principle:first-child { padding-left: 0; }
      .about-principle + .about-principle { padding-left: clamp(2rem, 4vw, 4rem); }

      .about-principle span {
        display: block;
        margin-bottom: clamp(2rem, 4vw, 3.5rem);
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: var(--type-scale-label);
      }

      .about-principle h3 {
        margin: 0;
        font-size: var(--type-scale-body);
        font-weight: 500;
      }

      .about-principle p {
        max-width: 26rem;
        margin: .75rem 0 0;
        color: var(--text-muted);
        font-size: var(--type-scale-body);
        line-height: 1.75;
        letter-spacing: var(--tracking-body);
      }

      .about-systems__gallery {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(19rem, .65fr);
        grid-template-rows: repeat(2, minmax(18rem, 1fr));
        gap: clamp(.75rem, 1.5vw, 1.5rem);
        margin-top: clamp(3rem, 6vw, 5rem);
      }

      .about-system-card {
        position: relative;
        min-width: 0;
        overflow: hidden;
        background: color-mix(in srgb, var(--bg-elevated) 72%, transparent);
        color: var(--text-main);
        text-decoration: none;
        isolation: isolate;
      }

      .about-system-card::before {
        position: absolute;
        inset: 0;
        z-index: -1;
        background:
          linear-gradient(135deg, transparent 0 68%, var(--about-line-soft) 68% calc(68% + 1px), transparent calc(68% + 1px)),
          radial-gradient(circle at 65% 44%, var(--about-faint), transparent 40%);
        content: '';
      }

      .about-system-card--feature { grid-row: 1 / 3; }

      .about-system-card figure {
        height: 100%;
        margin: 0;
        display: grid;
        grid-template-rows: minmax(0, 1fr) auto;
      }

      .about-system-card__image {
        min-height: 0;
        padding: clamp(2rem, 5vw, 5rem);
        display: grid;
        place-items: center;
      }

      .about-system-card__image picture { display: contents; }

      .about-system-card img {
        display: block;
        width: 100%;
        height: 100%;
        max-height: 30rem;
        object-fit: contain;
        filter: saturate(.82) contrast(1.03) drop-shadow(0 1.5rem 1.5rem rgba(0, 0, 0, .18));
        transition: transform 420ms cubic-bezier(.2, .8, .2, 1), filter 250ms ease;
      }

      .about-system-card--feature img { max-height: 38rem; }

      .about-system-card:hover img {
        filter: saturate(.96) contrast(1.03) drop-shadow(0 2rem 2rem rgba(0, 0, 0, .22));
        transform: scale(1.025) translateY(-.35rem);
      }

      .about-system-card figcaption {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1rem;
        align-items: end;
        padding: 1.25rem clamp(1.25rem, 2.5vw, 2rem);
      }

      .about-system-card figcaption span {
        display: block;
        margin-bottom: .35rem;
      }

      .about-system-card figcaption strong {
        font-size: var(--type-scale-body);
        font-weight: 500;
      }

      .about-system-card figcaption > b {
        font-size: var(--type-scale-body);
        font-weight: 400;
      }

      .about-method__header {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--about-line-soft);
      }

      .about-method__header .about-section-label { margin: 0; }

      .about-method__header p {
        max-width: 34rem;
        margin: 0;
        color: var(--text-muted);
        font-size: var(--type-scale-body);
        line-height: 1.7;
      }

      .about-method__steps {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
      }

      .about-method__step {
        padding: 2rem clamp(1rem, 2vw, 2rem) 0;
      }

      .about-method__step:first-child { padding-left: 0; }
      .about-method__step + .about-method__step { padding-left: clamp(1.5rem, 3vw, 3rem); }

      .about-method__step span {
        display: block;
        margin-bottom: clamp(2rem, 5vw, 4.5rem);
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: var(--type-scale-label);
      }

      .about-method__step h3 {
        margin: 0;
        font-size: var(--type-scale-body);
        font-weight: 500;
      }

      .about-method__step p {
        margin: .7rem 0 0;
        color: var(--text-muted);
        font-size: var(--type-scale-label);
        line-height: 1.7;
      }

      .about-resources { padding-bottom: clamp(4rem, 8vw, 7rem); }

      .about-resources__heading {
        padding: clamp(2rem, 4vw, 3.5rem) 0;
        border-top: 1px solid var(--about-line-soft);
      }

      .about-resources__heading p {
        max-width: 33rem;
        margin: 0;
        color: var(--text-muted);
        font-size: var(--type-scale-body);
        line-height: var(--leading-body);
        letter-spacing: var(--tracking-body);
      }

      .about-resource-list {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .about-resource-link {
        display: grid;
        grid-template-columns: minmax(0, .55fr) minmax(18rem, 1fr) auto;
        gap: 2rem;
        align-items: center;
        padding: 1.4rem 0;
        border-bottom: 1px solid var(--about-line-soft);
        color: var(--text-main);
        text-decoration: none;
        transition: padding-inline 220ms cubic-bezier(.2, .8, .2, 1), opacity 180ms ease;
      }

      .about-resource-link:hover { padding-inline: .65rem; }

      .about-resource-link strong {
        font-size: var(--type-scale-body);
        font-weight: 500;
      }

      .about-resource-link p {
        margin: 0;
        color: var(--text-muted);
        font-size: var(--type-scale-body);
        line-height: 1.65;
      }

      .about-resource-link > span {
        font-size: var(--type-scale-body);
      }

      @media (prefers-color-scheme: dark) {
        .about-stage__map {
          opacity: .06;
          filter: invert(1);
          mix-blend-mode: screen;
        }

        .about-stage__product img,
        .about-system-card img {
          filter: saturate(.76) contrast(1.04) drop-shadow(0 2rem 2rem rgba(0, 0, 0, .5));
        }
      }

      @media (max-width: 900px) {
        .about-stage__copy { top: 20%; width: 48%; }
        .about-stage__product { width: 58%; }

        .about-story__heading,
        .about-systems__heading,
        .about-resources__heading {
          grid-template-columns: 1fr;
          gap: 2rem;
        }

        .about-principles { grid-template-columns: 1fr; }

        .about-principle,
        .about-principle:first-child { padding: 1.5rem 0; }

        .about-principle + .about-principle {
          border-top: 1px solid var(--about-line-soft);
          padding-left: 0;
        }

        .about-principle span { margin-bottom: 1rem; }

        .about-systems__gallery {
          grid-template-columns: 1fr;
          grid-template-rows: none;
        }

        .about-system-card--feature { grid-row: auto; }
        .about-system-card__image { min-height: 25rem; }
        .about-system-card--feature img { max-height: 32rem; }

        .about-method__steps { grid-template-columns: repeat(2, 1fr); }
        .about-method__step:nth-child(3) { padding-left: 0; }
        .about-method__step:nth-child(n + 3) { border-top: 1px solid var(--about-line-soft); }
      }

      @media (max-width: 680px) {
        .about-intro { grid-template-columns: 1fr; gap: 1rem; }
        .about-text-link { width: fit-content; }
        .about-stage { min-height: 47rem; }

        .about-stage__top {
          top: 1.25rem;
          right: var(--site-shell-gutter);
          left: var(--site-shell-gutter);
        }

        .about-stage__top span:last-child { display: none; }

        .about-stage__copy {
          top: 6rem;
          right: var(--site-shell-gutter);
          left: var(--site-shell-gutter);
          width: auto;
        }

        .about-stage h1 {
          max-width: 10ch;
          font-size: var(--type-scale-display);
        }

        .about-stage__lead {
          max-width: 30rem;
          margin-top: 1rem;
          font-size: var(--type-scale-body);
        }

        .about-stage__product {
          top: 18.5rem;
          right: -12%;
          bottom: 9.8rem;
          width: 92%;
        }

        .about-stage__product img { width: min(92vw, 31rem); }
        .about-stage__orbit { width: min(78vw, 27rem); }

        .about-stage__product figcaption {
          right: 1.25rem;
          bottom: .75rem;
        }

        .about-stage__nav {
          grid-template-columns: 1fr;
          min-height: 9rem;
          padding-inline: var(--site-shell-gutter);
        }

        .about-stage__nav a {
          grid-template-columns: auto 1fr;
          gap: 1rem;
          padding: .65rem 0;
        }

        .about-stage__nav a + a {
          border-top: 1px solid var(--about-line-soft);
          border-left: 0;
        }

        .about-stage__nav span { min-width: 6.5rem; }

        .about-method__header {
          display: grid;
          align-items: start;
        }

        .about-method__steps { grid-template-columns: 1fr; }

        .about-method__step,
        .about-method__step:first-child {
          padding: 1.5rem 0;
          border-top: 1px solid var(--about-line-soft);
        }

        .about-method__step + .about-method__step { padding-left: 0; }

        .about-method__step span { margin-bottom: 1rem; }

        .about-system-card__image {
          min-height: 18rem;
          padding: 2rem;
        }

        .about-resource-link {
          grid-template-columns: 1fr auto;
          gap: .6rem 1rem;
        }

        .about-resource-link p { grid-column: 1 / -1; }
      }

      @media (prefers-reduced-motion: reduce) {
        .about-text-link,
        .about-stage__product img,
        .about-system-card img,
        .about-resource-link { transition: none; }

        .about-stage__product:hover img { transform: rotate(-4deg); }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <div class="page" id="top">
      <div class="shell shell--header about-page-header"><SiteHeader /></div>

      <main class="about-page" id="main-content">
        <div class="shell">
          <section class="about-intro" data-reveal style="--d: 80ms" aria-label="品牌简介">
            <p>我们把电机、驱动、传感器和工具链放在同一条工程基线上，让运动控制更容易被理解、验证与集成。</p>
            <a class="about-text-link" href="#about-story">了解我们的工作 <span aria-hidden="true">↓</span></a>
          </section>

          <section class="about-stage" data-reveal style="--d: 140ms" aria-labelledby="about-title">
            <img class="about-stage__map" src={principlesBackground} alt="" aria-hidden="true" />
            <div class="about-stage__top"><span>About / QDrive Tech</span><span>Precision motion · open engineering</span></div>
            <div class="about-stage__copy">
              <p class="about-stage__eyebrow">Motion as a system</p>
              <h1 id="about-title"><span>让精密运动，</span><span>成为可以复用的</span><span>工程能力。</span></h1>
              <p class="about-stage__lead">从驱控一体伺服电机出发，我们把真实系统中的响应、精度与集成经验，沉淀成产品、资料和工具。</p>
            </div>
            <figure class="about-stage__product">
              <span class="about-stage__orbit" aria-hidden="true"></span>
              <img src="/images/home/qd4310-main.png" alt="QD4310 驱控一体中空无刷伺服电机" width="1000" height="1000" decoding="async" />
              <figcaption>
                <span class="about-product-label">Core platform / 01</span>
                <strong>QD4310</strong>
