---
import '../styles/site-shared.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import RevealScript from '../components/RevealScript.astro';

const title = '关于 QDrive Tech';
const description =
  '介绍 QDrive Tech 在伺服电机与运动控制领域的定位、使命与产品方向。';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} - QDrive Tech</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="page" id="top">
      <main class="shell">
        <SiteHeader />

        <section class="sections">
          <article class="panel" data-reveal style="--d: 220ms">
            <header class="panel-header">
              <div>
                <div class="panel-eyebrow">ABOUT</div>
                <div class="panel-title">公司与产品概览</div>
              </div>
            </header>
            <p class="hero-subtitle">{description}</p>
            <section>
              <h2>公司与产品概览（占位）</h2>
              <p>后续将在此补充公司介绍、产品线规划以及联系方式等信息。</p>
            </section>
          </article>

          <article class="panel" data-reveal style="--d: 320ms">
            <header class="panel-header">
              <div>
                <div class="panel-eyebrow">DOWNLOAD</div>
                <div class="panel-title">资料下载中心（占位）</div>
              </div>
            </header>
            <ul class="list">
              <li>
                <span class="list-dot" />
                固件与文档下载（规划中）
              </li>
              <li>
                <span class="list-dot" />
                常见问题与使用建议（规划中）
              </li>
              <li>
                <span class="list-dot" />
                技术博客文章索引
              </li>
            </ul>
          </article>
        </section>
      </main>

      <SiteFooter />
    </div>

    <RevealScript />
  </body>
</html>
